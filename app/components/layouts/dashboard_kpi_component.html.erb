<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
  <% @kpis.each do |kpi| %>
    <%= render Stats::KpiCardComponent.new(
      title:    kpi[:title],
      value:    kpi[:value],
      icon:     kpi.fetch(:icon, :chart_bar),
      color:    kpi.fetch(:color, :primary),
      trend:    kpi[:trend],
      subtitle: kpi[:subtitle]
    ) %>
  <% end %>
</div>
