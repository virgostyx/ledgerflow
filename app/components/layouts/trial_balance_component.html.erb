<div>
  <h2 class="text-lg font-semibold text-indigo-700 mb-4">Balance des comptes — <%= @fiscal_year_label %></h2>

  <table class="w-full text-sm">
    <thead class="bg-gray-50 border-b border-gray-200">
      <tr>
        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase w-24">Code</th>
        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Libellé</th>
        <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase w-36">Débit</th>
        <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase w-36">Crédit</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% @rows.each do |row| %>
        <tr class="hover:bg-gray-50">
          <td class="px-4 py-2 font-mono text-gray-700"><%= row[:code] %></td>
          <td class="px-4 py-2 text-gray-700"><%= row[:label] %></td>
          <td class="px-4 py-2 text-right font-mono <%= row[:debit] > 0 ? 'text-gray-900' : 'text-gray-300' %>">
            <%= formatted_amount(row[:debit]) %>
          </td>
          <td class="px-4 py-2 text-right font-mono <%= row[:credit] > 0 ? 'text-gray-900' : 'text-gray-300' %>">
            <%= formatted_amount(row[:credit]) %>
          </td>
        </tr>
      <% end %>
    </tbody>
    <tfoot class="border-t-2 border-gray-300 bg-gray-50 font-semibold">
      <tr>
        <td class="px-4 py-3" colspan="2">Total</td>
        <td class="px-4 py-3 text-right font-mono"><%= formatted_amount(total_debit) %></td>
        <td class="px-4 py-3 text-right font-mono"><%= formatted_amount(total_credit) %></td>
      </tr>
    </tfoot>
  </table>
</div>
