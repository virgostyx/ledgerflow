<%= form_with model: @entry, scope: :accounting_journal_entry, url: form_url,
              data: { controller: "journal-entry-form",
                      action: "keydown->journal-entry-form#shortcut input->journal-entry-form#markDirty change->journal-entry-form#markDirty",
                      journal_entry_form_axes_value: axes_json,
                      journal_entry_form_rate_lookup_url_value: helpers.accounting_exchange_rate_lookup_path } do |f| %>

  <%= f.hidden_field :fiscal_year_id %>
  <%# The chart of accounts, once for every line (see account-search). %>
  <script type="application/json" id="journal-entry-accounts"><%= ERB::Util.json_escape(accounts_json).html_safe %></script>
  <% if @entry.errors.any? %>
    <div data-entry-errors role="alert" tabindex="-1" class="mb-4 rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-700 focus:outline-none focus:ring-2 focus:ring-red-500">
      <p class="font-semibold">This entry could not be saved:</p>
      <ul class="mt-1 list-disc pl-5">
        <% @entry.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
      </ul>
    </div>
  <% end %>
  <% if @agent_proposal %>
    <%= hidden_field_tag "accounting_journal_entry[agent_proposal_id]", @agent_proposal.id %>
    <div role="status" class="mb-4">
      <%= render Ui::AlertComponent.new(variant: :info, message: "Prepared by the assistant from your request. Check every line: what you save here is your entry, not the proposal.") %>
    </div>
  <% end %>

  <%# Header: one field style for the whole form (the same as the lines); the description is the field read most often later, so it has two columns. %>
  <div class="grid grid-cols-2 gap-4 mb-3 lg:grid-cols-4">
    <div>
      <%= f.label :journal_id, 'Journal', class: header_label_class %>
      <%= f.collection_select :journal_id, @journals, :id,
            ->(j) { "#{j.code} — #{j.label_fr}" },
            { include_blank: false },
            { class: field_class } %>
    </div>
    <div>
      <%= f.label :entry_date, 'Date', class: header_label_class %>
      <%= f.date_field :entry_date, class: field_class %>
    </div>
    <div class="col-span-2">
      <%= f.label :description, 'Description', class: header_label_class %>
      <%= f.text_field :description, class: field_class %>
    </div>
  </div>

  <details class="header-more group mb-6" <%= "open" if @entry.auto_reverse_on.present? %>>
    <summary class="inline-flex cursor-pointer select-none list-none items-center gap-1 rounded-md py-0.5 text-xs font-medium text-gray-600 hover:text-gray-900 focus:outline-none focus:ring-2 focus:ring-primary-500 [&::-webkit-details-marker]:hidden">
      <svg class="h-3.5 w-3.5 transition-transform group-open:rotate-90" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5"/></svg>
      More options
    </summary>
    <div class="mt-2 max-w-xs">
      <%= f.label :auto_reverse_on, 'Reverse on (optional)', class: header_label_class %>
      <%= f.date_field :auto_reverse_on, class: field_class, 'aria-describedby': 'reverse-hint' %>
      <p id="reverse-hint" class="mt-1 text-xs text-gray-600">A draft reversal of this entry is prepared on that date.</p>
    </div>
  </details>

  <%# Column headers %>
  <div class="entry-columns hidden lg:grid grid-cols-12 gap-2 text-xs font-medium text-gray-500 uppercase tracking-wider mb-2">
    <div class="col-span-3">Account</div>
    <div class="col-span-2">Label</div>
    <div class="col-span-2">Partner</div>
    <div class="col-span-2 text-right">Debit</div>
    <div class="col-span-2 text-right">Credit</div>
    <div class="col-span-1"></div>
  </div>

  <%# Lines container %>
  <div data-journal-entry-form-target="linesContainer">
    <%= f.fields_for :lines, (@entry.lines.any? ? @entry.lines : [ @entry.lines.build ]) do |lf| %>
      <%= render Layouts::JournalEntryLineComponent.new(form: lf, axes: axes, partners: partners, currency_options: currency_options) %>
    <% end %>
  </div>

  <%# New line template (hidden, cloned by Stimulus): the same component as the saved lines %>
  <template data-journal-entry-form-target="lineTemplate">
    <%= f.fields_for :lines, Accounting::JournalEntryLine.new, child_index: "NEW_INDEX" do |lf| %>
      <%= render Layouts::JournalEntryLineComponent.new(form: lf, axes: axes, partners: partners, currency_options: currency_options) %>
    <% end %>
  </template>

  <%# Undo notice for a removed line %>
  <div class="mb-2 text-sm text-gray-700" role="status" aria-live="polite" data-journal-entry-form-target="undoNotice" hidden>
    <span>Line removed.</span>
    <button type="button" class="rounded-md font-medium text-primary-700 underline hover:text-primary-800 focus:outline-none focus:ring-2 focus:ring-primary-500" data-action="journal-entry-form#undoRemove">Undo</button>
  </div>

  <%# Add line button %>
  <button type="button"
          class="text-sm text-primary-600 hover:text-primary-800 font-medium mb-1 rounded-md focus:outline-none focus:ring-2 focus:ring-primary-500"
          aria-keyshortcuts="Control+Enter"
          data-action="click->journal-entry-form#addLine">
    + Add a line
  </button>
  <p class="text-xs text-gray-600 mb-6">Ctrl+Enter adds a line and fills in the amount still missing.</p>

  <%# Totals bar: stays in view under the lines. Totals sit under the Debit and Credit columns (same 12-column grid as the lines), with the balance state and Save next to them. %>
  <div class="entry-totals-bar sticky bottom-0 z-10 -mx-1 border-t border-gray-300 bg-white px-1 pt-2 pb-2 lg:pt-3 lg:pb-3">
    <div class="grid grid-cols-2 gap-2 items-baseline text-sm lg:grid-cols-12">
      <div class="hidden text-xs font-medium text-gray-500 uppercase tracking-wider lg:col-span-7 lg:block">Totals</div>
      <div class="lg:col-span-2 lg:text-right">
        <span class="mr-1 text-xs text-gray-600 lg:sr-only">Total debit</span>
        <span class="font-mono tabular-nums font-semibold text-gray-900" data-journal-entry-form-target="totalDebit">0.00</span>
      </div>
      <div class="text-right lg:col-span-2">
        <span class="mr-1 text-xs text-gray-600 lg:sr-only">Total credit</span>
        <span class="font-mono tabular-nums font-semibold text-gray-900" data-journal-entry-form-target="totalCredit">0.00</span>
      </div>
      <div class="hidden lg:col-span-1 lg:block"></div>
    </div>

    <div class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-journal-entry-form-target="balanceAnnouncer"></div>

    <div class="mt-2 flex flex-wrap items-center justify-between gap-2 lg:mt-3 lg:gap-3">
      <div id="entry-balance-status" class="balance-indicator flex flex-1 items-center gap-2 text-xs text-gray-700 lg:text-sm" data-journal-entry-form-target="balanceIndicator">
        <span class="bg-gray-100 text-gray-600 text-xs font-medium px-2 py-1 rounded-full">Pending</span>
        <span>Enter debit and credit amounts.</span>
      </div>
      <div class="flex items-center gap-3">
        <%= link_to 'Cancel', accounting_journal_entries_path,
              class: 'inline-flex min-h-11 items-center rounded-md px-4 py-2 text-sm text-gray-600 hover:text-gray-800 focus:outline-none focus:ring-2 focus:ring-primary-500 lg:min-h-0',
              data: { journal_entry_form_target: 'cancelLink', discard_label: discard_label, action: 'click->journal-entry-form#cancel' } %>
        <%= f.submit submit_label, name: 'commit', value: submit_label,
              class: 'min-h-11 px-4 py-2 bg-primary-600 text-white text-sm font-medium rounded-md hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 disabled:opacity-50 disabled:cursor-not-allowed lg:min-h-0',
              disabled: true,
              'aria-describedby': 'entry-balance-status entry-save-consequence',
              data: { journal_entry_form_target: 'submitButton' } %>
      </div>
    </div>
    <p id="entry-save-consequence" class="mt-1 sr-only text-xs text-gray-600 lg:not-sr-only lg:text-right"><%= save_consequence %></p>
  </div>
<% end %>
