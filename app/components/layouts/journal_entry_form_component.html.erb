<%= form_with model: @entry, scope: :accounting_journal_entry, url: form_url,
              data: { controller: "journal-entry-form",
                      journal_entry_form_axes_value: axes_json } do |f| %>

  <%= f.hidden_field :fiscal_year_id %>

  <%# Header fields %>
  <div class="grid grid-cols-3 gap-4 mb-6">
    <div class="relative" data-controller="floating-label">
      <%= f.collection_select :journal_id, @journals, :id,
            ->(j) { "#{j.code} — #{j.label_fr}" },
            { include_blank: false },
            { class: 'block w-full rounded-lg border border-gray-300 px-3 py-3 text-sm text-gray-900 bg-transparent focus:outline-none focus:ring-2 focus:ring-primary-500',
              data: { floating_label_target: 'input', action: 'focus->floating-label#focus blur->floating-label#blur' } } %>
      <%= f.label :journal_id, 'Journal', class: 'lf-floating-label', data: { floating_label_target: 'label' } %>
    </div>
    <div class="relative" data-controller="floating-label">
      <%= f.date_field :entry_date,
            class: 'block w-full rounded-lg border border-gray-300 px-3 py-3 text-sm text-gray-900 bg-transparent focus:outline-none focus:ring-2 focus:ring-primary-500',
            data: { floating_label_target: 'input', action: 'focus->floating-label#focus blur->floating-label#blur' } %>
      <%= f.label :entry_date, 'Date', class: 'lf-floating-label', data: { floating_label_target: 'label' } %>
    </div>
    <div class="relative" data-controller="floating-label">
      <%= f.text_field :description,
            placeholder: ' ',
            class: 'block w-full rounded-lg border border-gray-300 px-3 py-3 text-sm text-gray-900 bg-transparent focus:outline-none focus:ring-2 focus:ring-primary-500',
            data: { floating_label_target: 'input', action: 'focus->floating-label#focus blur->floating-label#blur' } %>
      <%= f.label :description, 'Description', class: 'lf-floating-label', data: { floating_label_target: 'label' } %>
    </div>
  </div>

  <%# Column headers %>
  <div class="grid grid-cols-12 gap-2 text-xs font-medium text-gray-500 mb-2 px-1">
    <div class="col-span-3">Account</div>
    <div class="col-span-4">Label</div>
    <div class="col-span-2 text-right">Debit</div>
    <div class="col-span-2 text-right">Credit</div>
    <div class="col-span-1"></div>
  </div>

  <%# Lines container %>
  <div data-journal-entry-form-target="linesContainer">
    <%= f.fields_for :lines, @entry.lines.first || @entry.lines.build do |lf| %>
      <div class="entry-lines mb-3" data-journal-entry-form-target="line">
        <div class="grid grid-cols-12 gap-2 items-center">
          <div class="col-span-3 relative" data-controller="account-search"
               data-account-search-accounts-value="<%= accounts_json %>"
               data-action="account-search:selected->journal-entry-form#onAccountSelected">
            <label class="sr-only">Account</label>
            <input type="text" placeholder="Account"
                   value="<%= lf.object.account&.code %>"
                   class="block w-full rounded border-gray-300 text-sm"
                   data-account-search-target="input"
                   data-action="focus->account-search#filter input->account-search#filter blur->account-search#hideDelayed">
            <%= lf.hidden_field :account_id, data: { account_search_target: 'accountId' } %>
            <div data-account-search-target="suggestions"
                 class="hidden absolute z-20 w-full bg-white border border-gray-200 rounded-md shadow-lg mt-1 max-h-48 overflow-y-auto"></div>
          </div>
          <div class="col-span-4">
            <label class="sr-only">Label</label>
            <%= lf.text_field :label, placeholder: 'Label', class: 'block w-full rounded border-gray-300 text-sm' %>
          </div>
          <div class="col-span-2">
            <label class="sr-only">Debit</label>
            <%= lf.number_field :debit, step: '0.01', min: 0, placeholder: '0.00',
                  'aria-label': 'Debit',
                  class: 'block w-full rounded border-gray-300 text-sm text-right font-mono',
                  data: { journal_entry_form_target: 'debitInput',
                          action: 'input->journal-entry-form#computeBalance' } %>
          </div>
          <div class="col-span-2">
            <label class="sr-only">Credit</label>
            <%= lf.number_field :credit, step: '0.01', min: 0, placeholder: '0.00',
                  'aria-label': 'Credit',
                  class: 'block w-full rounded border-gray-300 text-sm text-right font-mono',
                  data: { journal_entry_form_target: 'creditInput',
                          action: 'input->journal-entry-form#computeBalance' } %>
          </div>
          <div class="col-span-1 text-center">
            <button type="button" class="text-gray-400 hover:text-red-600 text-lg"
                    data-action="click->journal-entry-form#removeLine">×</button>
          </div>
        </div>

        <%# Analytical axis selects — one per axis %>
        <% if axes.any? %>
          <div class="analytical-axes-row mt-1.5 grid gap-2 pl-1"
               style="grid-template-columns: repeat(<%= axes.size %>, minmax(0, 1fr)) 1fr">
            <% axes.each_with_index do |axis, axis_idx| %>
              <% annotation = lf.object.analytical_annotations.find { |a| a.analytical_axis_id == axis.id } %>
              <div class="axis-field" data-axis-code="<%= axis.code %>">
                <label class="block text-xs text-gray-400 mb-0.5 axis-label" data-axis-id="<%= axis.id %>">
                  <%= axis.code %>
                  <span class="required-marker hidden text-red-500 text-xs">*</span>
                </label>
                <%= lf.fields_for :analytical_annotations, annotation || Accounting::AnalyticalAnnotation.new(analytical_axis: axis),
                      index: axis_idx do |af| %>
                  <%= af.hidden_field :analytical_axis_id %>
                  <%= af.hidden_field :id %>
                  <%= af.select :analytical_account_id,
                        axis.analytical_accounts.active.ordered.map { |aa| [ aa.label_fr, aa.id ] },
                        { include_blank: "—" },
                        class: "block w-full rounded border-gray-300 text-xs py-1",
                        data: { axis_id: axis.id,
                                action: "change->journal-entry-form#onAxisAccountChanged" } %>
                  <%= af.hidden_field :_destroy, value: 0, data: { destroy_field: true } %>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <%# New line template (hidden, cloned by Stimulus) %>
  <template data-journal-entry-form-target="lineTemplate">
    <div class="entry-lines mb-3" data-journal-entry-form-target="line">
      <div class="grid grid-cols-12 gap-2 items-center">
        <div class="col-span-3 relative" data-controller="account-search"
             data-account-search-accounts-value="<%= accounts_json %>"
             data-action="account-search:selected->journal-entry-form#onAccountSelected">
          <label class="sr-only">Account</label>
          <input type="text" placeholder="Account"
                 class="block w-full rounded border-gray-300 text-sm"
                 data-account-search-target="input"
                 data-action="focus->account-search#filter input->account-search#filter blur->account-search#hideDelayed">
          <input type="hidden" name="accounting_journal_entry[lines_attributes][NEW_INDEX][account_id]"
                 data-account-search-target="accountId">
          <div data-account-search-target="suggestions"
               class="hidden absolute z-20 w-full bg-white border border-gray-200 rounded-md shadow-lg mt-1 max-h-48 overflow-y-auto"></div>
        </div>
        <div class="col-span-4">
          <label class="sr-only">Label</label>
          <input type="text" placeholder="Label"
                 name="accounting_journal_entry[lines_attributes][NEW_INDEX][label]"
                 class="block w-full rounded border-gray-300 text-sm">
        </div>
        <div class="col-span-2">
          <label class="sr-only">Debit</label>
          <input type="number" step="0.01" min="0" placeholder="0.00"
                 aria-label="Debit" value="0"
                 name="accounting_journal_entry[lines_attributes][NEW_INDEX][debit]"
                 class="block w-full rounded border-gray-300 text-sm text-right font-mono"
                 data-journal-entry-form-target="debitInput"
                 data-action="input->journal-entry-form#computeBalance">
        </div>
        <div class="col-span-2">
          <label class="sr-only">Credit</label>
          <input type="number" step="0.01" min="0" placeholder="0.00"
                 aria-label="Credit" value="0"
                 name="accounting_journal_entry[lines_attributes][NEW_INDEX][credit]"
                 class="block w-full rounded border-gray-300 text-sm text-right font-mono"
                 data-journal-entry-form-target="creditInput"
                 data-action="input->journal-entry-form#computeBalance">
        </div>
        <div class="col-span-1 text-center">
          <button type="button" class="text-gray-400 hover:text-red-600 text-lg"
                  data-action="click->journal-entry-form#removeLine">×</button>
        </div>
      </div>

      <%# Analytical axis selects in template %>
      <% if axes.any? %>
        <div class="analytical-axes-row mt-1.5 grid gap-2 pl-1"
             style="grid-template-columns: repeat(<%= axes.size %>, minmax(0, 1fr)) 1fr">
          <% axes.each_with_index do |axis, axis_idx| %>
            <div class="axis-field" data-axis-code="<%= axis.code %>">
              <label class="block text-xs text-gray-400 mb-0.5 axis-label" data-axis-id="<%= axis.id %>">
                <%= axis.code %>
                <span class="required-marker hidden text-red-500 text-xs">*</span>
              </label>
              <input type="hidden"
                     name="accounting_journal_entry[lines_attributes][NEW_INDEX][analytical_annotations_attributes][<%= axis_idx %>][analytical_axis_id]"
                     value="<%= axis.id %>">
              <select name="accounting_journal_entry[lines_attributes][NEW_INDEX][analytical_annotations_attributes][<%= axis_idx %>][analytical_account_id]"
                      class="block w-full rounded border-gray-300 text-xs py-1"
                      data-axis-id="<%= axis.id %>"
                      data-action="change->journal-entry-form#onAxisAccountChanged">
                <option value="">—</option>
                <% axis.analytical_accounts.active.ordered.each do |aa| %>
                  <option value="<%= aa.id %>"><%= aa.label_fr %></option>
                <% end %>
              </select>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </template>

  <%# Add line button %>
  <button type="button"
          class="text-sm text-primary-600 hover:text-primary-800 font-medium mb-6"
          data-action="click->journal-entry-form#addLine">
    + Add a line
  </button>

  <%# Balance indicator %>
  <div class="flex items-center justify-between mb-4">
    <div class="balance-indicator" data-journal-entry-form-target="balanceIndicator">
      <span class="bg-gray-100 text-gray-600 text-xs font-medium px-2 py-1 rounded-full">Pending</span>
    </div>
  </div>

  <%# Submit %>
  <div class="flex gap-3">
    <%= f.submit 'Save', name: 'commit', value: 'Save',
          class: 'px-4 py-2 bg-primary-600 text-white text-sm font-medium rounded-md hover:bg-primary-700 disabled:opacity-50 disabled:cursor-not-allowed',
          disabled: true,
          data: { journal_entry_form_target: 'submitButton' } %>
    <%= link_to 'Cancel', accounting_journal_entries_path,
          class: 'px-4 py-2 text-sm text-gray-600 hover:text-gray-800' %>
  </div>
<% end %>
