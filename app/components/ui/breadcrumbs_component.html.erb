<nav class="flex" aria-label="Breadcrumb">
  <ol class="inline-flex items-center space-x-1">
    <% @items.each_with_index do |item, index| %>
      <li class="inline-flex items-center">
        <% if index > 0 %>
          <svg class="w-4 h-4 text-gray-400 mx-1 shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
          </svg>
        <% end %>
        <% if item[:path].present? %>
          <%= link_to item[:label], item[:path], class: "text-sm font-medium text-gray-600 hover:text-primary-600 transition-colors" %>
        <% else %>
          <span class="text-sm font-medium text-gray-400"><%= item[:label] %></span>
        <% end %>
      </li>
    <% end %>
  </ol>
</nav>
