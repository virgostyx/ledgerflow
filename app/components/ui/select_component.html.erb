<div class="space-y-1">
  <label for="<%= @name %>" class="block text-sm font-medium text-gray-700"><%= @label %></label>
  <select name="<%= @name %>" id="<%= @name %>"
          class="block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-500">
    <% if @prompt %>
      <option value=""><%= @prompt %></option>
    <% end %>
    <% @options.each do |label, value| %>
      <option value="<%= value %>" <%= "selected" if value.to_s == @selected.to_s %>><%= label %></option>
    <% end %>
  </select>
  <% if @error %>
    <p class="text-red-600 text-xs mt-1"><%= @error %></p>
  <% end %>
</div>
