<div id="music-player-fab"
     data-controller="music-player"
     data-turbo-permanent
     class="fixed bottom-56 right-6 z-50">

  <%# ── Player panel (hidden by default) ── %>
  <div data-music-player-target="panel"
       class="hidden opacity-0 translate-y-2 transition-all duration-200 ease-out
              absolute bottom-full right-0 mb-3 w-72 rounded-2xl shadow-2xl overflow-hidden
              border border-violet-900/20"
       style="background: linear-gradient(145deg, #1e1b4b 0%, #2e1065 50%, #1a1035 100%);">

    <%# Header %>
    <div class="px-4 pt-4 pb-3">
      <div class="flex items-center justify-between mb-3">
        <div class="flex items-center gap-2">
          <div data-music-player-target="vinylIcon" class="relative w-8 h-8 flex-shrink-0">
            <svg viewBox="0 0 32 32" class="w-8 h-8" xmlns="http://www.w3.org/2000/svg">
              <circle cx="16" cy="16" r="16" fill="#111"/>
              <circle cx="16" cy="16" r="12" fill="none" stroke="#333" stroke-width="1"/>
              <circle cx="16" cy="16" r="8"  fill="none" stroke="#333" stroke-width="1"/>
              <circle cx="16" cy="16" r="4"  fill="none" stroke="#333" stroke-width="1"/>
              <circle cx="16" cy="16" r="2"  fill="#7c3aed"/>
            </svg>
          </div>
          <div>
            <p class="text-white text-xs font-semibold tracking-wide uppercase opacity-60">Now playing</p>
            <p data-music-player-target="stationName" class="text-white text-sm font-bold leading-tight mt-0.5">🌿 Groove Salad</p>
          </div>
        </div>
        <button data-action="click->music-player#close"
                class="text-white/40 hover:text-white/80 transition-colors p-1"
                aria-label="Close player">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
      <div class="flex items-center justify-between">
        <p data-music-player-target="stationLabel" class="text-violet-300 text-xs">Ambient · Downtempo</p>
        <div data-music-player-target="equalizer" class="hidden flex items-end gap-0.5 h-4">
          <span class="music-eq-bar w-1 bg-violet-400 rounded-sm" style="animation-delay: 0ms"></span>
          <span class="music-eq-bar w-1 bg-violet-400 rounded-sm" style="animation-delay: 150ms"></span>
          <span class="music-eq-bar w-1 bg-violet-400 rounded-sm" style="animation-delay: 300ms"></span>
          <span class="music-eq-bar w-1 bg-violet-400 rounded-sm" style="animation-delay: 100ms"></span>
          <span class="music-eq-bar w-1 bg-violet-400 rounded-sm" style="animation-delay: 250ms"></span>
        </div>
      </div>
    </div>

    <%# Controls %>
    <div class="px-4 pb-3 flex items-center justify-center gap-4">
      <button data-action="click->music-player#prevStation"
              class="text-white/50 hover:text-white transition-colors p-1.5 rounded-full hover:bg-white/10"
              aria-label="Previous station">
        <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M6 6h2v12H6zm3.5 6l8.5 6V6z"/>
        </svg>
      </button>

      <button data-action="click->music-player#togglePlay"
              class="w-12 h-12 rounded-full bg-violet-500 hover:bg-violet-400 text-white
                     flex items-center justify-center shadow-lg shadow-violet-900/50
                     transition-all hover:scale-105 active:scale-95"
              aria-label="Play / Pause">
        <svg data-music-player-target="playIcon" class="h-5 w-5 ml-0.5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M8 5v14l11-7z"/>
        </svg>
        <svg data-music-player-target="pauseIcon" class="h-5 w-5 hidden" fill="currentColor" viewBox="0 0 24 24">
          <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
        </svg>
      </button>

      <button data-action="click->music-player#nextStation"
              class="text-white/50 hover:text-white transition-colors p-1.5 rounded-full hover:bg-white/10"
              aria-label="Next station">
        <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M6 18l8.5-6L6 6v12zm2.5-6l6-4.3v8.5L8.5 12zM16 6h2v12h-2z"/>
        </svg>
      </button>
    </div>

    <%# Volume %>
    <div class="px-4 pb-3 flex items-center gap-2">
      <svg class="h-3.5 w-3.5 text-white/40 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
        <path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02z"/>
      </svg>
      <input type="range" min="0" max="100" value="70"
             data-music-player-target="volumeSlider"
             data-action="input->music-player#setVolume"
             class="music-volume-slider flex-1 h-1 appearance-none rounded-full cursor-pointer"
             aria-label="Volume">
      <svg class="h-3.5 w-3.5 text-white/40 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
        <path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/>
      </svg>
    </div>

    <%# Station list %>
    <div class="border-t border-white/10 px-3 py-2 space-y-1">
      <% Ui::MusicPlayerComponent::STATIONS.each do |station| %>
        <button data-action="click->music-player#selectStation"
                data-index="<%= station[:index] %>"
                data-music-player-target="stationItem"
                class="w-full flex items-center gap-2.5 px-2.5 py-1.5 rounded-lg text-left transition-all hover:bg-white/10">
          <span class="text-base leading-none"><%= station[:emoji] %></span>
          <div class="min-w-0">
            <p class="text-white text-xs font-medium truncate"><%= station[:name] %></p>
            <p class="text-white/40 text-xs truncate"><%= station[:label] %></p>
          </div>
        </button>
      <% end %>
    </div>

    <div class="px-4 py-2 border-t border-white/10">
      <p class="text-white/25 text-xs text-center">SomaFM · Internet Radio</p>
    </div>
  </div>

  <%# FAB button %>
  <button data-music-player-target="fab"
          data-action="click->music-player#toggle"
          class="relative p-3 rounded-full bg-violet-600 text-white shadow-lg
                 hover:bg-violet-700 focus:outline-none focus:ring-2 focus:ring-violet-500
                 focus:ring-offset-2 transition-all"
          aria-label="Music player">
    <span data-music-player-target="fabRing"
          class="hidden absolute inset-0 rounded-full bg-violet-500 animate-ping opacity-30"></span>
    <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
      <path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/>
    </svg>
  </button>
</div>
