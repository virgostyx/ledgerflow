<div role="dialog" aria-modal="true" aria-labelledby="modal-title"
     class="fixed inset-0 z-50 overflow-y-auto"
     data-controller="modal"
     data-action="keydown.esc@window->modal#close">
  <div class="fixed inset-0 bg-gray-500/20 transition-opacity"
       data-action="click->modal#close"></div>

  <div class="flex min-h-full w-full <%= alignment_class %> p-4 sm:p-6">
    <div class="relative bg-white rounded-xl shadow-xl w-full max-w-lg mx-4">
      <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100">
        <h2 id="modal-title" class="font-semibold text-gray-900"><%= @title %></h2>
        <button type="button" aria-label="Close"
                class="text-gray-400 hover:text-gray-600 transition-colors"
                data-action="click->modal#close">
          <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
          </svg>
        </button>
      </div>

      <div class="px-6 py-4">
        <%= content %>
      </div>

      <% if footer? %>
        <div class="px-6 py-4 border-t border-gray-200 bg-gray-50 rounded-b-xl">
          <%= footer %>
        </div>
      <% end %>
    </div>
  </div>
</div>
