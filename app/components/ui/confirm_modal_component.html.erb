<div id="confirm-modal"
     class="hidden fixed inset-0 z-50 overflow-y-auto"
     data-controller="confirm"
     data-action="keydown.esc@window->confirm#cancel keydown.enter@window->confirm#confirmAction"
     role="dialog"
     aria-modal="true"
     aria-labelledby="confirm-modal-title">
  <div class="fixed inset-0 bg-gray-500/20 transition-opacity"
       data-action="click->confirm#cancel"></div>

  <div class="flex min-h-full w-full items-center justify-center p-4 sm:p-6">
    <div class="relative bg-white rounded-xl shadow-xl w-full max-w-md"
         data-confirm-target="container">
      <div class="px-6 pt-6 pb-4">
        <div class="flex items-start gap-4">
          <div class="flex-shrink-0">
            <svg class="h-10 w-10 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
            </svg>
          </div>
          <div class="flex-1">
            <h3 class="text-lg font-semibold text-gray-900" id="confirm-modal-title">
              Confirm action
            </h3>
            <p class="mt-2 text-sm text-gray-600" data-confirm-target="message">
              Are you sure you want to proceed?
            </p>
          </div>
        </div>
      </div>

      <div class="px-6 py-4 border-t border-gray-200 bg-gray-50 rounded-b-xl flex gap-3 justify-end">
        <button type="button"
                data-action="click->confirm#cancel"
                class="inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-primary-500 transition-colors">
          Cancel
        </button>
        <button type="button"
                data-action="click->confirm#confirmAction"
                data-confirm-target="confirmButton"
                class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-primary-600 hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-primary-500 transition-colors">
          Confirm
        </button>
      </div>
    </div>
  </div>
</div>
