<div data-controller="currency-converter" class="fixed bottom-36 right-6 z-50">

  <%# Panel %>
  <div data-currency-converter-target="panel"
       class="hidden absolute bottom-full right-0 mb-3 w-72 bg-white rounded-2xl shadow-2xl border border-gray-200 overflow-hidden">

    <%# Header %>
    <div class="flex items-center justify-between px-4 py-3 bg-emerald-600 text-white">
      <div class="flex items-center gap-2">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
             stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
          <circle cx="12" cy="12" r="9"/>
          <path d="M14.8 9A2 2 0 0 0 13 8h-2a2 2 0 0 0 0 4h2a2 2 0 0 1 0 4h-2a2 2 0 0 1-1.8-1"/>
          <path d="M12 6v2m0 8v2"/>
        </svg>
        <span class="text-sm font-semibold">Currency Converter</span>
      </div>
      <button data-action="click->currency-converter#close"
              class="text-emerald-200 hover:text-white transition-colors"
              aria-label="Close">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <%# Body %>
    <div class="p-4 space-y-3">

      <%# Currency select %>
      <div>
        <label class="block text-xs font-medium text-gray-500 mb-1">Currency</label>
        <select data-currency-converter-target="currencySelect"
                data-action="change->currency-converter#currencyChanged"
                class="w-full rounded-lg border border-gray-200 px-3 py-2 text-sm text-gray-800 focus:outline-none focus:ring-2 focus:ring-emerald-400 bg-white">
          <option value="USD">USD — US Dollar</option>
          <option value="GBP">GBP — British Pound</option>
          <option value="CHF">CHF — Swiss Franc</option>
          <option value="JPY">JPY — Japanese Yen</option>
        </select>
      </div>

      <%# Direction row %>
      <div class="flex items-center justify-between text-sm">
        <span class="font-medium text-gray-700" data-currency-converter-target="directionFromLabel">USD</span>
        <button data-action="click->currency-converter#swapDirection"
                class="p-1.5 rounded-full hover:bg-gray-100 text-gray-500 hover:text-emerald-600 transition-colors"
                aria-label="Swap direction">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 21 3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5"/>
          </svg>
        </button>
        <span class="font-medium text-gray-700" data-currency-converter-target="directionToLabel">EUR</span>
      </div>

      <%# Amount input %>
      <div>
        <label class="block text-xs font-medium text-gray-500 mb-1">Amount</label>
        <input type="number"
               data-currency-converter-target="amountInput"
               data-action="input->currency-converter#convert"
               placeholder="0.00"
               min="0"
               step="0.01"
               class="w-full rounded-lg border border-gray-200 px-3 py-2 text-sm text-gray-800 focus:outline-none focus:ring-2 focus:ring-emerald-400">
      </div>

      <%# Result display %>
      <div class="bg-gray-50 rounded-xl px-4 py-3 text-right">
        <div data-currency-converter-target="resultDisplay"
             class="text-2xl font-light text-gray-800 truncate">—</div>
        <div class="text-xs text-gray-400 mt-0.5" data-currency-converter-target="rateInfo">Select an amount to convert</div>
      </div>

    </div>

    <%# Copy to clipboard %>
    <div class="px-3 py-2 bg-gray-50 border-t border-gray-100">
      <button data-action="click->currency-converter#copy"
              class="w-full py-2 px-3 text-sm text-emerald-600 hover:text-emerald-800 hover:bg-emerald-50 rounded-lg transition-colors font-medium flex items-center justify-center gap-2">
        <svg class="h-4 w-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
        </svg>
        <span data-currency-converter-target="copyText">Copy result</span>
      </button>
      <p class="text-center text-xs text-gray-400 mt-1">Esc to close · rates from ECB</p>
    </div>

  </div>

  <%# FAB %>
  <button data-action="click->currency-converter#toggle"
          class="p-3 rounded-full bg-emerald-600 text-white shadow-lg hover:bg-emerald-700
                 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:ring-offset-2 transition-colors"
          aria-label="Open currency converter">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
         stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
      <circle cx="12" cy="12" r="9"/>
      <path d="M14.8 9A2 2 0 0 0 13 8h-2a2 2 0 0 0 0 4h2a2 2 0 0 1 0 4h-2a2 2 0 0 1-1.8-1"/>
      <path d="M12 6v2m0 8v2"/>
    </svg>
  </button>

</div>
