<% content_for :breadcrumb do %>
  <%= render Ui::BreadcrumbsComponent.new(items: [ { label: "Dashboard", path: accounting_root_path }, { label: "Portfolio" } ]) %>
<% end %>

<%= render Ui::PageHeaderComponent.new(title: "Portfolio",
      description: "One line per dossier you work in. Each line is that dossier's own health snapshot (nothing here reads the books of several dossiers), refreshed every night.") do |header| %>
  <% header.with_actions do %>
    <%= link_to "Organizations", organizations_path, class: "px-4 py-2 border border-gray-300 text-sm text-gray-700 rounded-md hover:bg-gray-50" %>
    <%= button_to "Refresh now", portfolio_refresh_path, method: :post, class: "px-4 py-2 border border-gray-300 text-sm text-gray-700 rounded-md hover:bg-gray-50 cursor-pointer" %>
  <% end %>
<% end %>

<%= form_with url: portfolio_path, method: :get, class: "mb-4 flex flex-wrap gap-3 items-end text-sm", data: { turbo: false } do %>
  <div><%= label_tag :organization_id, "Organization", class: "block text-gray-600" %>
    <%= select_tag :organization_id, options_from_collection_for_select(@organizations, :id, :name, params[:organization_id]), include_blank: "All", class: "form-input" %></div>
  <div><%= label_tag :responsible, "In charge", class: "block text-gray-600" %>
    <%= select_tag :responsible, options_for_select([ [ "Me", "me" ] ], params[:responsible]), include_blank: "Anyone", class: "form-input" %></div>
  <div><%= label_tag :closing, "Closing", class: "block text-gray-600" %>
    <%= select_tag :closing, options_for_select(%w[open in_progress ready closed].map { |s| [ s.humanize, s ] }, params[:closing]), include_blank: "Any", class: "form-input" %></div>
  <div><%= label_tag :vat, "VAT", class: "block text-gray-600" %>
    <%= select_tag :vat, options_for_select([ [ "Overdue", "overdue" ], [ "Due within 30 days", "soon" ] ], params[:vat]), include_blank: "Any", class: "form-input" %></div>
  <div><%= label_tag :severity, "Checks (R19)", class: "block text-gray-600" %>
    <%= select_tag :severity, options_for_select([ [ "Blocking anomalies", "blocking" ], [ "Warnings", "warnings" ], [ "Never run", "unchecked" ] ], params[:severity]), include_blank: "Any", class: "form-input" %></div>
  <div><%= label_tag :sort, "Sort by", class: "block text-gray-600" %>
    <%= select_tag :sort, options_for_select([ [ "Name", "name" ], [ "Closing", "closing" ], [ "Next VAT return", "vat" ], [ "Blocking anomalies", "blocking" ], [ "Bank lines waiting", "bank" ], [ "Overdue receivables", "receivables" ], [ "Last entry", "last_entry" ] ], params[:sort]), class: "form-input" %></div>
  <%= submit_tag "Filter", class: "btn-primary" %>
<% end %>

<% if @rows.empty? %>
  <%= render Ui::EmptyStateComponent.new(title: @all_count.zero? ? "No dossier in the portfolio" : "No dossier matches", icon: :inbox,
        description: @all_count.zero? ? "A dossier appears here once its owner turns on “Portfolio and consolidation” in Settings > Entity." : "Change the filters to see the others.") %>
<% else %>
  <div class="bg-white rounded-lg border border-gray-200 overflow-x-auto">
    <table class="w-full text-sm" data-section="portfolio">
      <thead class="bg-gray-50 border-b border-gray-200">
        <tr class="text-xs font-medium text-gray-500 uppercase tracking-wider">
          <th class="px-3 py-3"></th><th class="px-3 py-3 text-left">Dossier</th><th class="px-3 py-3 text-left">Closing</th><th class="px-3 py-3 text-left">Next VAT return</th>
          <th class="px-3 py-3 text-left">Checks</th><th class="px-3 py-3 text-right">Bank lines waiting</th><th class="px-3 py-3 text-right">Peppol</th><th class="px-3 py-3 text-right">Inbox</th>
          <th class="px-3 py-3 text-right">Late tasks</th><th class="px-3 py-3 text-right">Overdue receivables</th><th class="px-3 py-3 text-left">Last entry</th>
          <th class="px-3 py-3 text-left">In charge</th><th class="px-3 py-3 text-left">Computed</th><th class="px-3 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @rows.each do |row| %>
          <% entity, s = row.entity, row.snapshot %>
          <tr data-entity="<%= entity.id %>">
            <td class="px-3 py-3"><%= check_box_tag "entity_ids[]", entity.id, false, form: "bulk-form", id: "entity_#{entity.id}", "aria-label": "Select #{entity.name}" %></td>
            <td class="px-3 py-3 font-medium text-gray-900"><%= entity.name %><div class="text-xs font-normal text-gray-500"><%= entity.organization&.name %></div></td>
            <% if s %>
              <td class="px-3 py-3"><%= s.closing_status.to_s.humanize %> <%= s.closing_year %><%= " (#{s.closing_progress}%)" if s.closing_status == "in_progress" && s.closing_progress %></td>
              <td class="px-3 py-3 <%= 'text-red-700 font-medium' if s.vat_overdue %>"><%= s.next_vat_due_on ? l(s.next_vat_due_on, format: :short) : "—" %><%= " overdue" if s.vat_overdue %></td>
              <td class="px-3 py-3"><% if s.never_checked? %><span class="text-gray-400">Never run</span><% else %><span class="<%= 'text-red-700 font-medium' if s.blocking_count.positive? %>"><%= s.blocking_count %> blocking</span>, <%= s.warning_count %> warning<%= "s" if s.warning_count != 1 %><% end %></td>
              <td class="px-3 py-3 text-right"><%= s.unreconciled_bank_lines %><%= " (oldest #{s.oldest_unreconciled_days} d)" if s.oldest_unreconciled_days %></td>
              <td class="px-3 py-3 text-right"><%= s.peppol_pending %> waiting, <%= s.peppol_anomalies %> in anomaly</td>
              <td class="px-3 py-3 text-right"><%= s.inbox_documents %></td>
              <td class="px-3 py-3 text-right"><%= s.overdue_tasks %></td>
              <td class="px-3 py-3 text-right"><%= number_to_currency(s.overdue_receivables, unit: "€") %></td>
              <td class="px-3 py-3"><%= s.last_posted_on ? l(s.last_posted_on, format: :short) : "—" %></td>
            <% else %>
              <td colspan="9" class="px-3 py-3 text-gray-400">Not calculated yet: refresh, or wait for tonight.</td>
            <% end %>
            <td class="px-3 py-3">
              <% if @responsible_choices[entity.id] %>
                <%= form_with url: portfolio_responsible_path(entity), method: :patch, class: "flex gap-1" do %>
                  <%= select_tag :responsible_id, options_from_collection_for_select(@responsible_choices[entity.id], :id, :full_name, entity.responsible_id), include_blank: "Nobody", class: "form-input text-xs", "aria-label": "In charge of #{entity.name}" %>
                  <%= submit_tag "Save", class: "text-xs text-primary-700 cursor-pointer" %>
                <% end %>
              <% else %><%= entity.responsible&.full_name || "—" %><% end %>
            </td>
            <td class="px-3 py-3 text-gray-500"><%= s ? l(s.computed_at, format: :short) : "—" %></td>
            <td class="px-3 py-3"><%= button_to "Open", switch_entity_path(entity), method: :post, class: "text-primary-700 hover:underline cursor-pointer" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%= form_with url: portfolio_bulk_path, method: :post, id: "bulk-form", class: "mt-4 flex flex-wrap gap-3 items-end text-sm" do %>
    <div><%= label_tag :bulk_action, "For the dossiers ticked", class: "block text-gray-600" %>
      <%= select_tag :bulk_action, options_for_select(@actions.map { |key, a| [ a[:label], key ] }), include_blank: "Choose an action", class: "form-input" %></div>
    <div><%= label_tag :message, "Message (to notify)", class: "block text-gray-600" %>
      <%= text_field_tag :message, nil, class: "form-input", maxlength: 500 %></div>
    <%= submit_tag "Apply", class: "btn-primary" %>
    <p class="text-xs text-gray-500">These actions write no accounting entry, and each applies only where you have the right in that dossier.</p>
  <% end %>
<% end %>
