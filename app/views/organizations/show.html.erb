<% content_for :breadcrumb do %>
  <%= render Ui::BreadcrumbsComponent.new(items: [ { label: "Dashboard", path: accounting_root_path }, { label: "Organizations", path: organizations_path }, { label: @organization.name } ]) %>
<% end %>
<%= render Ui::PageHeaderComponent.new(title: @organization.name) %>

<h2 class="mt-4 mb-2 text-sm font-semibold text-gray-700">Dossiers you can see</h2>
<ul class="bg-white rounded-lg border border-gray-200 divide-y divide-gray-100 text-sm max-w-2xl" data-section="entities">
  <% @entities.each do |entity| %>
    <li class="px-4 py-3 flex items-center justify-between"><span><%= entity.name %></span>
      <% if Portfolio::Access.owner?(current_user, entity) && @owner %>
        <%= button_to "Take out", remove_entity_organization_path(@organization, entity_id: entity.id), method: :delete, class: "text-sm text-red-700 cursor-pointer", form: { data: { turbo_confirm: "Take #{entity.name} out of #{@organization.name}?" } } %>
      <% end %></li>
  <% end %>
  <% if @entities.empty? %><li class="px-4 py-4 text-gray-500">None.</li><% end %>
</ul>
<% if @hidden_count.positive? %><p class="mt-1 text-xs text-gray-500"><%= @hidden_count %> more dossier<%= "s" if @hidden_count > 1 %> you have no access to: not listed.</p><% end %>

<% if @owner && @addable.any? %>
  <%= form_with url: add_entity_organization_path(@organization), method: :post, class: "mt-3 flex gap-2 items-end text-sm" do %>
    <%= select_tag :entity_id, options_from_collection_for_select(@addable, :id, :name), class: "form-input", "aria-label": "Dossier to add" %>
    <%= submit_tag "Add a dossier you own", class: "btn-primary" %>
  <% end %>
<% end %>

<h2 class="mt-8 mb-2 text-sm font-semibold text-gray-700">People</h2>
<ul class="bg-white rounded-lg border border-gray-200 divide-y divide-gray-100 text-sm max-w-2xl" data-section="members">
  <% @members.each do |membership| %>
    <li class="px-4 py-3 flex items-center justify-between"><span><%= membership.user.full_name %> <span class="text-gray-500">(<%= membership.role %>)</span></span>
      <% if @owner %><%= button_to "Remove", remove_member_organization_path(@organization, membership_id: membership.id), method: :delete, class: "text-sm text-red-700 cursor-pointer" %><% end %></li>
  <% end %>
</ul>
<% if @owner %>
  <%= form_with url: add_member_organization_path(@organization), method: :post, class: "mt-3 flex gap-2 items-end text-sm" do %>
    <%= email_field_tag :email, nil, placeholder: "E-mail of a person with an account", class: "form-input", "aria-label": "E-mail" %>
    <%= select_tag :role, options_for_select(OrganizationMembership::ROLES), class: "form-input", "aria-label": "Role" %>
    <%= submit_tag "Add", class: "btn-primary" %>
  <% end %>
<% end %>
