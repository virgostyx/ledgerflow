<% content_for :breadcrumb do %>
  <%= render Ui::BreadcrumbsComponent.new(items: [ { label: "Dashboard", path: accounting_root_path }, { label: "Portfolio", path: portfolio_path }, { label: "Organizations" } ]) %>
<% end %>
<%= render Ui::PageHeaderComponent.new(title: "Organizations", description: "A firm or a group that gathers dossiers. Belonging to one gives access to nothing: you still see a dossier only through your own membership of it.") do |header| %>
  <% header.with_actions do %><%= link_to "New organization", new_organization_path, class: "btn-primary" %><% end %>
<% end %>
<ul class="bg-white rounded-lg border border-gray-200 divide-y divide-gray-100 text-sm" data-section="organizations">
  <% @organizations.each do |organization| %>
    <li class="px-4 py-3"><%= link_to organization.name, organization_path(organization), class: "text-primary-700 hover:underline" %></li>
  <% end %>
  <% if @organizations.empty? %><li class="px-4 py-6 text-center text-gray-500">No organization yet.</li><% end %>
</ul>
