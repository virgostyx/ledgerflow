<% content_for :breadcrumb do %>
  <%= render Ui::BreadcrumbsComponent.new(items: [ { label: "Dashboard", path: accounting_root_path }, { label: "Organizations", path: organizations_path }, { label: "New" } ]) %>
<% end %>
<%= render Ui::PageHeaderComponent.new(title: "New organization") %>
<%= form_with model: @organization, class: "max-w-md space-y-4" do |f| %>
  <% if @organization.errors.any? %><p class="text-sm text-red-700"><%= @organization.errors.full_messages.to_sentence %></p><% end %>
  <div><%= f.label :name, "Name", class: "block text-sm font-medium text-gray-700 mb-1" %><%= f.text_field :name, class: "form-input w-full" %></div>
  <%= f.submit "Create", class: "btn-primary" %>
<% end %>
