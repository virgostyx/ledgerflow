<h1 class="text-xl font-semibold">Welcome</h1>
<p class="mt-2 text-sm text-gray-600">Choose a password (12 characters or more). Next you will set up a second factor: it is required.</p>
<%= render "portal/shared/flash" %>
<%= form_with url: portal_invitation_path(params[:token]), class: "mt-4 space-y-3" do |f| %>
  <div><%= f.label :password, "Password", class: "block text-sm" %><%= f.password_field :password, autocomplete: "new-password", minlength: 12, required: true, class: "w-full rounded border p-2" %></div>
  <div><%= f.label :password_confirmation, "Repeat the password", class: "block text-sm" %><%= f.password_field :password_confirmation, autocomplete: "new-password", required: true, class: "w-full rounded border p-2" %></div>
  <%= f.submit "Continue", class: "portal-button rounded px-4 py-2" %>
<% end %>
