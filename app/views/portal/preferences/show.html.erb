<h1 class="text-xl font-semibold">Preferences</h1>
<%= render "portal/shared/flash" %>
<%= form_with url: preferences_path, method: :patch, class: "mt-4 space-y-2 text-sm" do |f| %>
  <p>E-mails about new publications:</p>
  <% { "immediate" => "As soon as they are published", "daily" => "Once a day", "off" => "Never" }.each do |value, label| %>
    <label class="block"><%= f.radio_button :notification_frequency, value, checked: current_portal_user.notification_frequency == value %> <%= label %></label>
  <% end %>
  <p class="text-gray-600">Security alerts are always sent.</p>
  <label class="mt-3 block"><%= hidden_field_tag :wipe_outbox_on_sign_out, "0", id: nil %><%= check_box_tag :wipe_outbox_on_sign_out, "1", current_portal_user.wipe_outbox_on_sign_out %> Erase the documents waiting to be sent when I sign out (advised on a shared device)</label>
  <%= f.submit "Save", class: "portal-button rounded px-4 py-2" %>
<% end %>
<%= link_to "Back", portal_root_path, class: "mt-4 inline-block text-sm underline" %>
