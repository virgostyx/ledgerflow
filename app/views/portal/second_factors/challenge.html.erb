<h1 class="text-xl font-semibold">Second factor</h1>
<p class="mt-2 text-sm text-gray-600">Give the 6-digit code from your app, or a backup code.</p>
<%= render "portal/shared/flash" %>
<%= form_with url: portal_second_factor_challenge_path, class: "mt-4 space-y-3" do |f| %>
  <div><%= f.label :code, "Code", class: "block text-sm" %><%= f.text_field :code, autocomplete: "one-time-code", required: true, class: "w-full rounded border p-2" %></div>
  <%= f.submit "Sign in", class: "rounded bg-gray-900 px-4 py-2 text-white" %>
<% end %>
