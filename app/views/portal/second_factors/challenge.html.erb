<h1 class="text-xl font-semibold">Second factor</h1>
<p class="mt-2 text-sm text-gray-600"><%= params[:totp_only] == "1" ? "Give the 6-digit code from your authenticator app (a backup code is not enough here)." : "Give the 6-digit code from your app, or a backup code." %></p>
<%= render "portal/shared/flash" %>
<%= form_with url: portal_second_factor_challenge_path, class: "mt-4 space-y-3" do |f| %>
  <div><%= f.label :code, "Code", class: "block text-sm" %><%= f.text_field :code, autocomplete: "one-time-code", required: true, class: "w-full rounded border p-2" %></div>
  <%= hidden_field_tag :return_to, params[:return_to], id: nil %>
  <%= hidden_field_tag :totp_only, params[:totp_only], id: nil %>
  <%= f.submit "Sign in", class: "portal-button rounded px-4 py-2" %>
<% end %>
