<h1 class="text-xl font-semibold">Client portal</h1>
<p class="mt-1 text-sm text-gray-600">Signed in as <%= current_portal_user.full_name %>.</p>
<% if @companies.empty? %>
  <p class="mt-4 text-sm">Nothing is shared with you at the moment.</p>
<% else %>
  <ul class="mt-4 space-y-1"><% @companies.each do |company| %><li><%= company.name %></li><% end %></ul>
<% end %>
<% if Portal::Upload.companies_open_to(current_portal_user).exists? %>
  <div class="mt-4 grid gap-3 sm:grid-cols-2">
    <%= link_to "Take a photo", new_upload_path, class: "rounded bg-gray-900 px-6 py-5 text-center text-lg text-white" %>
    <%= link_to "Choose a file", new_upload_path, class: "rounded bg-gray-900 px-6 py-5 text-center text-lg text-white" %>
    <%= link_to "Requested documents", document_requests_path, class: "rounded border border-gray-900 px-6 py-5 text-center text-lg" %>
    <%= link_to "Send by e-mail", portal_mail_path, class: "rounded border border-gray-900 px-6 py-5 text-center text-lg" %>
  </div>
  <div class="mt-3"><%= link_to "My sends", uploads_path, class: "underline" %>
  </div>
<% end %>
<%= link_to "Dashboard", portal_dashboard_path, class: "mt-4 inline-block underline" if current_portal_user.open_grants.where("portal_grants.capabilities @> ?", [ "dashboard.view" ].to_json).exists? %>
<%= link_to "Questions", questions_path, class: "mt-4 ml-4 inline-block underline" if current_portal_user.open_grants.where("portal_grants.capabilities @> ?", [ "questions.answer" ].to_json).exists? %>
<%= link_to "Messages", messages_path, class: "mt-4 ml-4 inline-block underline" if current_portal_user.open_grants.where("portal_grants.capabilities @> ?", [ "messages.use" ].to_json).exists? %>
<%= link_to "Publications", publications_path, class: "mt-4 inline-block underline" %>
<%= link_to "Devices", devices_path, class: "mt-4 ml-4 inline-block underline" %>
<%= link_to "Ask for someone's access", new_access_request_path, class: "mt-4 ml-4 inline-block underline" if current_portal_user.open_grants.where("portal_grants.capabilities @> ?", [ "access.request" ].to_json).exists? %>
<%= link_to "Preferences", preferences_path, class: "mt-4 ml-4 inline-block underline" %>
<%= button_to "Sign out", portal_session_path, method: :delete, class: "mt-6 text-sm underline" %>
