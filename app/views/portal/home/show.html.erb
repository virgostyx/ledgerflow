<h1 class="text-xl font-semibold">Client portal</h1>
<p class="mt-1 text-sm text-gray-600">Signed in as <%= current_portal_user.full_name %>.</p>
<% if @companies.empty? %>
  <p class="mt-4 text-sm">Nothing is shared with you at the moment.</p>
<% else %>
  <ul class="mt-4 space-y-1"><% @companies.each do |company| %><li><%= company.name %></li><% end %></ul>
<% end %>
<%= link_to "Publications", publications_path, class: "mt-4 inline-block underline" %>
<%= link_to "Devices", devices_path, class: "mt-4 ml-4 inline-block underline" %>
<%= link_to "Preferences", preferences_path, class: "mt-4 ml-4 inline-block underline" %>
<%= button_to "Sign out", portal_session_path, method: :delete, class: "mt-6 text-sm underline" %>
