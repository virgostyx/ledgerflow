<h1 class="text-xl font-semibold"><%= @publication.title %></h1>
<p class="text-xs text-gray-500"><%= @publication.company.name %> - published <%= @publication.published_at.to_date %> - version <%= @publication.version %><% if @publication.period_start %> - period <%= @publication.period_start %> to <%= @publication.period_end %><% end %></p>
<% if @publication.message.present? %><p class="mt-3 whitespace-pre-line text-sm"><%= @publication.message %></p><% end %>
<% if (check = @publication.certificate_check) %>
  <p class="mt-3 text-sm" role="status"><%= t("portal.certificate.#{check.state}", date: check.checked_at.utc.strftime("%Y-%m-%d %H:%M UTC")) %></p>
<% end %>
<ul class="mt-4 space-y-2">
  <% @links.each do |file, signed| %>
    <li class="rounded border bg-white p-3 text-sm">
      <%= link_to file.filename, portal_download_path(signed), class: "font-medium underline" %>
      <span class="text-gray-500">(<%= number_to_human_size(file.byte_size) %>)</span>
      <p class="break-all font-mono text-xs text-gray-500">SHA-256 <%= file.sha256 %></p>
    </li>
  <% end %>
</ul>
<%= render "portal/shared/flash" %>
<% if @publication.requires_approval? && @approver %>
  <section class="mt-6 rounded border border-gray-300 p-3 text-sm">
    <% if @own %>
      <p><strong><%= t("portal.approvals.your_decision") %></strong>: <%= t("portal.approvals.decisions.#{@own.decision}") %></p>
    <% else %>
      <h2 class="font-semibold"><%= t("portal.approvals.title") %></h2>
      <p class="mt-1"><%= @legal_text %></p>
      <% unless @opened %><p class="mt-2 text-amber-800" role="alert"><%= t("portal.approvals.open_first") %></p><% end %>
      <%= form_with url: approval_publication_path(@publication), class: "mt-3 space-y-2" do %>
        <fieldset>
          <% %w[approved approved_with_remarks refused].each do |decision| %>
            <label class="block"><%= radio_button_tag :decision, decision, false, disabled: !@opened %> <%= t("portal.approvals.decisions.#{decision}") %></label>
          <% end %>
        </fieldset>
        <div><%= label_tag :comment, t("portal.approvals.comment"), class: "block" %><%= text_area_tag :comment, nil, rows: 3, maxlength: 2000, class: "w-full rounded border border-gray-300 px-2 py-1" %></div>
        <label class="block"><%= check_box_tag :confirm, "1", false, disabled: !@opened %> <%= t("portal.approvals.confirm") %></label>
        <ul class="ml-5 list-disc font-mono text-xs"><% @links.each_key do |file| %><li><%= file.filename %> — <%= file.sha256.first(12) %></li><% end %></ul>
        <%= submit_tag t("portal.approvals.submit"), disabled: !@opened, class: "portal-button rounded px-4 py-2" %>
      <% end %>
    <% end %>
  </section>
<% end %>
<%= link_to "Back", publications_path, class: "mt-4 inline-block text-sm underline" %>
