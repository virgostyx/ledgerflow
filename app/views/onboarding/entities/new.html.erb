<div>
  <h2 class="text-lg font-semibold text-indigo-700 mb-1">Create your accounting entity</h2>
  <p class="text-sm text-gray-500 mb-6">
    An entity is the legal structure whose accounts you manage (ASBL, SA, Foundation…).
    You can create as many as you need.
  </p>

  <%= form_with model: @entity, url: onboarding_entity_path, method: :post, class: "space-y-5" do |f| %>
    <% if @entity.errors.any? %>
      <div class="rounded-lg bg-red-50 border border-red-200 p-4">
        <p class="text-sm font-medium text-red-700 mb-2"><%= pluralize(@entity.errors.count, "error") %> prevented this from being saved:</p>
        <ul class="text-sm text-red-600 list-disc list-inside space-y-1">
          <% @entity.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= f.label :name, "Entity name *", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :name, required: true,
            placeholder: "My Company",
            class: "block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm
                    focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
    </div>

    <div>
      <%= f.label :legal_name, "Legal name *", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :legal_name, required: true,
            placeholder: "My Company SA (full official name)",
            class: "block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm
                    focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
    </div>

    <div>
      <%= f.label :legal_form, "Legal form", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.select :legal_form,
            [["ASBL / VZW", "ASBL"], ["Fondation / Stichting", "Fondation"],
             ["SA / NV", "SA"], ["SRL / BV", "SRL"], ["SCRL / CVBA", "SCRL"],
             ["Sole proprietorship", "Self-employed"], ["Other", "Other"]],
            { include_blank: "Select a legal form" },
            class: "block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm
                    focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
    </div>

    <div>
      <%= f.label :vat_number, "VAT number (optional)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :vat_number,
            placeholder: "BE0123456789",
            class: "block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm font-mono
                    focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
      <p class="text-xs text-gray-400 mt-1">Format: BE followed by 10 digits. You can add it later.</p>
    </div>

    <div>
      <%= f.label :country, "Country *", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.select :country,
            [["Belgium", "BE"], ["Luxembourg", "LU"], ["Netherlands", "NL"],
             ["France", "FR"], ["Germany", "DE"]],
            { selected: "BE" },
            class: "block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm
                    focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
    </div>

    <%= f.submit "Create entity & get started",
          class: "w-full bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium
                  rounded-lg px-4 py-2.5 cursor-pointer transition-colors" %>
  <% end %>
</div>
