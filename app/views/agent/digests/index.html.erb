<% content_for :breadcrumb do %><span class="text-gray-900 font-medium">Assistant summaries</span><% end %>
<div class="space-y-4">
  <p class="text-sm text-gray-600">What deserves your attention, built from your books with your own rights, and only when there is something to say. Nothing here changes anything.</p>
  <p class="text-sm"><%= link_to "Summary preferences", agent_digest_preference_path, class: "text-indigo-700 hover:underline" %> · <%= @preference.enabled? ? "On, #{@preference.frequency}" : "Off" %></p>
  <% if @digests.empty? %>
    <p class="text-sm text-gray-500">No summary yet. <%= "Turn it on in the preferences." unless @preference.enabled? %></p>
  <% else %>
    <ul class="divide-y divide-gray-100 rounded-lg border border-gray-200 bg-white text-sm">
      <% @digests.each do |digest| %>
        <li class="flex items-center justify-between px-4 py-3 <%= 'font-semibold' unless digest.read_at %>">
          <span><%= link_to digest.title, agent_digest_path(digest), class: "text-indigo-700 hover:underline" %> <span class="font-normal text-gray-500">· <%= pluralize(digest.item_count, "point") %></span></span>
          <span class="font-normal text-gray-400"><%= l(digest.created_at, format: :short) %></span>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
