<%
  text = {
    disabled_platform: "The assistant is switched off for the moment. The rest of the application is not affected.",
    feature_off: "The assistant is not turned on for this entity.",
    not_enabled: "The assistant is not turned on for this entity. An owner can turn it on in the entity settings.",
    forbidden: "You do not have access to the assistant.",
    failed: "Something went wrong while answering. Try again, or use the reports directly."
  }.fetch(reason.to_sym, "The assistant is not available.")
%>
<p role="alert" class="m-4 rounded-md border border-amber-200 bg-amber-50 p-3 text-sm text-amber-800"><%= text %></p>
