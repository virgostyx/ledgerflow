<div id="agent_conversation_<%= conversation.id %>_live" class="mr-6 rounded-lg border border-dashed border-gray-300 bg-white p-3 text-sm text-gray-900">
  <div id="agent_conversation_<%= conversation.id %>_live_steps" class="space-y-0.5"></div>
  <div id="agent_conversation_<%= conversation.id %>_live_text" class="whitespace-pre-wrap"></div>
  <div class="mt-2 flex items-center justify-between text-xs text-gray-400">
    <span>Writing…</span>
    <%= button_to "Stop", agent_conversation_stop_path(conversation), class: "rounded border border-gray-300 px-2 py-0.5 text-gray-700 hover:bg-gray-50" %>
  </div>
</div>
