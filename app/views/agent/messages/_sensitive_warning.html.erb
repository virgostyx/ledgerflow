<%
  wording = {
    iban: { name: "a bank account number (IBAN)", mask: "Only its last four characters will be sent to the language model.", send: "It will be sent as it is, because this entity allows it.", block: "This entity does not let bank account numbers go: it cannot be sent." },
    national_number: { name: "a national number", mask: "It will be replaced by a placeholder before anything is sent.", send: "It will be sent as it is, because this entity allows it.", block: "This entity does not let personal identifiers go: it cannot be sent." },
    card: { name: "a bank card number", block: "A bank card number can never be sent." },
    password: { name: "a password", block: "A password can never be sent." }
  }
%>
<div role="alert" class="mb-2 rounded-md border border-amber-300 bg-amber-50 p-3 text-sm text-amber-900">
  <p class="font-medium">Your message holds data that needs your attention.</p>
  <ul class="mt-1 list-disc space-y-1 pl-5">
    <% review.findings.each do |finding| %>
      <li>It contains <%= wording.dig(finding.kind, :name) %><%= " (#{finding.count} times)" if finding.count > 1 %>. <%= wording.dig(finding.kind, finding.effect) %></li>
    <% end %>
  </ul>
  <div class="mt-2 flex items-center gap-3">
    <% unless review.blocked? %>
      <%= button_to "Send anyway", agent_conversation_messages_path(conversation), params: { question: question, confirm_sensitive: "1" }, class: "rounded border border-amber-400 bg-white px-3 py-1 text-sm font-medium hover:bg-amber-100" %>
    <% end %>
    <span class="text-xs">Edit your message above to remove it<%= review.blocked? ? ", then send again" : " instead" %>.</span>
  </div>
</div>
