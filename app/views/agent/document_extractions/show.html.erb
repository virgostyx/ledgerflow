<% content_for :breadcrumb do %><span class="text-gray-900 font-medium"><%= link_to "Documents read by the assistant", agent_document_extractions_path %> / <%= @document.name %></span><% end %>
<% badge = ->(text, tone) { content_tag(:span, text, class: "rounded-full px-2 py-0.5 text-xs #{{ ok: 'bg-green-50 text-green-800', warn: 'bg-amber-50 text-amber-800', bad: 'bg-red-50 text-red-800', grey: 'bg-gray-100 text-gray-700' }[tone]}") } %>
<div class="space-y-4">
  <div class="flex flex-wrap items-center gap-3 text-sm">
    <span class="font-medium text-gray-900"><%= @extraction.document_type.to_s.tr("_", " ").capitalize.presence || "Reading" %></span>
    <%= badge.call(@extraction.status.capitalize, { "proposed" => :warn, "confirmed" => :ok, "rejected" => :grey, "failed" => :bad }[@extraction.status]) %>
    <span class="text-gray-500"><%= @extraction.engine == "ubl" ? "Read from the structured invoice, without the model" : "Read by the assistant from the masked text (no file left)" %></span>
    <%= link_to "Open the document", accounting_document_path(@document), class: "text-indigo-700 hover:underline" %>
  </div>

  <% if @extraction.failed? %>
    <p role="alert" class="rounded-md border border-red-200 bg-red-50 p-3 text-sm text-red-800"><%= @extraction.error %></p>
  <% end %>
  <% if @extraction.suspicious %>
    <p role="alert" class="rounded-md border border-red-200 bg-red-50 p-3 text-sm text-red-800">The text of this document looks like an instruction to an AI. It was treated as data and had no effect, but read what was extracted with care.</p>
  <% end %>
  <% @extraction.warnings.each do |warning| %><p class="rounded-md border border-amber-200 bg-amber-50 p-2 text-sm text-amber-900"><%= warning %></p><% end %>

  <% unless @extraction.failed? %>
    <div class="grid gap-4 lg:grid-cols-2">
      <section aria-label="The text of the document" class="max-h-[32rem] overflow-y-auto rounded-lg border border-gray-200 bg-white p-3 text-xs">
        <% if @pages.empty? %>
          <p class="text-gray-500">No text was read from this document.</p>
        <% else %>
          <% @pages.each_with_index do |page, index| %>
            <h3 class="mt-2 font-semibold text-gray-700">Page <%= index + 1 %></h3>
            <% page.lines.each do |line| %>
              <% hit = @highlight && @highlight["page"] == index + 1 && @highlight["snippet"].present? && line.strip == @highlight["snippet"] %>
              <p class="<%= 'bg-yellow-100' if hit %> whitespace-pre-wrap font-mono" <%= 'id=source' if hit %>><%= line.chomp %></p>
            <% end %>
          <% end %>
        <% end %>
      </section>

      <section aria-label="The fields read">
        <table class="min-w-full divide-y divide-gray-200 text-sm">
          <thead class="text-left text-xs uppercase text-gray-500"><tr><th class="py-1 pr-2">Field</th><th class="pr-2">Value</th><th>State</th></tr></thead>
          <tbody class="divide-y divide-gray-100 align-top">
            <% @extraction.fields.each do |name, field| %>
              <tr>
                <td class="py-2 pr-2 font-medium text-gray-900"><%= t("documents.fields.#{name}", default: name.humanize) %></td>
                <td class="pr-2">
                  <% if field["state"] == "not_found" %>
                    <span class="text-gray-500">Not found in the document</span>
                  <% else %>
                    <span class="font-mono"><%= field["value"] %></span>
                    <% if field["page"] %><%= link_to "page #{field['page']}", agent_document_extraction_path(@extraction, field: name, anchor: "source"), class: "ml-1 text-xs text-indigo-700 hover:underline", title: "Show where it was read" %><% end %>
                    <% if field.dig("validation", "status") == "invalid" %><p class="text-xs text-red-700">Check failed: <%= field.dig("validation", "reason") %></p><% end %>
                  <% end %>
                </td>
                <td class="space-y-1">
                  <% unless field["state"] == "not_found" %>
                    <%= badge.call("Confidence #{field['confidence']}", field["confidence"] == "low" ? :warn : :grey) if field["confidence"] %>
                    <%= badge.call(field.dig("validation", "status") == "valid" ? "Checked" : (field.dig("validation", "status") == "invalid" ? "Check failed" : "Not checked"), field.dig("validation", "status") == "valid" ? :ok : (field.dig("validation", "status") == "invalid" ? :bad : :grey)) if field["validation"] %>
                  <% end %>
                  <%= badge.call({ "confirmed" => "Confirmed", "needs_confirmation" => "Confirm by hand", "not_found" => "Not found", "ok" => "To confirm" }[field["state"]] || "To confirm", { "confirmed" => :ok, "ok" => :grey }.fetch(field["state"], :warn)) %>
                  <% if @can_confirm && @extraction.proposed? && field["value"] && field["state"] != "confirmed" %>
                    <%= form_with url: confirm_field_agent_document_extraction_path(@extraction), class: "flex items-center gap-1" do %>
                      <%= hidden_field_tag :name, name, id: nil %>
                      <%= text_field_tag :value, field["value"], id: "value_#{name}", class: "w-32 rounded border-gray-300 text-xs font-mono", aria: { label: "Value of #{name}" } %>
                      <%= submit_tag "Confirm", class: "text-xs font-medium text-indigo-700 hover:underline cursor-pointer" %>
                    <% end %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>

        <% checks = @extraction.data["validation"].to_h %>
        <% if checks.any? %>
          <ul class="mt-2 space-y-0.5 text-xs">
            <% checks.each do |name, check| %><li class="<%= check['status'] == 'valid' ? 'text-green-800' : 'text-red-800' %>"><%= check["status"] == "valid" ? "✓" : "✗" %> <%= name.humanize %><%= " — #{check['reason']}" if check["reason"] %></li><% end %>
          </ul>
        <% end %>

        <% if @extraction.proposed? %>
          <div class="mt-4 flex flex-wrap items-center gap-2">
            <%= button_to "Confirm all", confirm_all_agent_document_extraction_path(@extraction), disabled: !(@extraction.confirm_all? && @can_confirm),
                  class: "rounded bg-indigo-600 px-3 py-1 text-sm text-white hover:bg-indigo-700 disabled:cursor-not-allowed disabled:opacity-40", title: (@extraction.confirm_all? ? nil : "Some fields are weak, failed a check or were not found: confirm them one by one.") %>
            <%= button_to "Reject", reject_agent_document_extraction_path(@extraction), class: "rounded border border-gray-300 px-3 py-1 text-sm hover:bg-gray-50" %>
          </div>
          <% unless @extraction.confirm_all? %><p class="mt-1 text-xs text-gray-600">“Confirm all” needs every field to be sure, checked and found: <%= @extraction.weak_fields.to_sentence.presence || "nothing was read" %>.</p><% end %>
        <% end %>
        <% if @extraction.confirmed? && @extraction.entry_allowed? %>
          <%= button_to "Propose the entry", agent_conversations_path, params: { subject_type: "doc", subject_id: @document.id, screen: "agent/document_extractions#show", explain: "1" }, class: "mt-4 rounded bg-indigo-600 px-3 py-1 text-sm text-white hover:bg-indigo-700" %>
        <% elsif @extraction.confirmed? %>
          <p class="mt-4 text-xs text-gray-600">This is not an invoice or a credit note: no entry is proposed from it.</p>
        <% end %>
      </section>
    </div>

    <details class="text-xs text-gray-600">
      <summary class="cursor-pointer text-indigo-700">What was sent to the model</summary>
      <pre class="mt-1 max-h-72 overflow-auto whitespace-pre-wrap rounded border border-gray-200 bg-white p-2"><%= JSON.pretty_generate(@extraction.data["sent"] || { "sent" => "nothing: the document was structured" }) %></pre>
    </details>
  <% end %>
</div>
