<% content_for :breadcrumb do %><span class="text-gray-900 font-medium"><%= link_to "Case memory", agent_memory_notes_path %> / New note</span><% end %>
<% if @proposal %><p role="status" class="mb-3 max-w-xl rounded-md border border-indigo-200 bg-indigo-50 p-2 text-sm text-indigo-900">The assistant proposed this note. Read it, correct it, and keep it if it is right.</p><% end %>
<%= render "form", note: @note, proposal: @proposal %>
