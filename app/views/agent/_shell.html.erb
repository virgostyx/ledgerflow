<div data-controller="agent-panel" data-action="keydown@window->agent-panel#keydown agent:open@window->agent-panel#open">
  <button type="button" data-agent-panel-target="button" data-action="agent-panel#toggle" aria-expanded="false" aria-controls="agent_drawer" aria-keyshortcuts="Control+/"
          class="fixed right-0 top-1/3 z-30 rounded-l-md bg-indigo-600 px-2 py-3 text-xs font-medium text-white shadow hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 [writing-mode:vertical-rl]">
    Assistant
  </button>
  <aside id="agent_drawer" hidden data-agent-panel-target="drawer" role="complementary" aria-label="Assistant"
         class="fixed inset-y-0 right-0 z-40 flex w-full max-w-md flex-col border-l border-gray-200 bg-white shadow-xl">
    <div class="flex items-center justify-between border-b border-gray-200 px-4 py-2">
      <span class="text-sm font-semibold text-gray-900">Assistant <span class="font-normal text-gray-400">(Ctrl+/)</span></span>
      <button type="button" data-agent-panel-target="close" data-action="agent-panel#close" aria-label="Close the assistant"
              class="rounded p-1 text-gray-500 hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-indigo-500">✕</button>
    </div>
    <%= turbo_frame_tag "agent_panel", src: agent_conversations_path(screen: "#{controller_path}##{action_name}"), loading: :lazy, class: "block min-h-0 flex-1 overflow-y-auto" %>
  </aside>
</div>
