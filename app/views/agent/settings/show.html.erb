<% content_for :breadcrumb do %><span class="text-gray-900 font-medium">Assistant settings</span><% end %>
<% consent = Agent::Consent.find_by(version: Agent::Consent::VERSION) %>
<% labels = { "public_ref" => "Technical references and codes", "financial" => "Amounts, balances, dates", "personal" => "Names of people and companies", "bank_identifier" => "Bank account numbers",
              "tax_identifier" => "VAT and company numbers", "free_text" => "Free text (labels, descriptions)" } %>

<div class="max-w-2xl space-y-6">
  <p class="text-sm text-gray-600">The assistant reads the books of this entity through the reports and answers questions. It never validates, sends or posts anything: it prepares, a person decides.</p>
  <p class="text-sm"><%= link_to "Assistant summaries", agent_digests_path, class: "text-indigo-700 hover:underline" %> · <%= link_to "Knowledge base", agent_knowledge_documents_path, class: "text-indigo-700 hover:underline" %> · <%= link_to "Security events of the assistant", agent_security_events_path, class: "text-indigo-700 hover:underline" %> · <%= link_to "What the assistant does with the data", agent_privacy_path, class: "text-indigo-700 hover:underline" %> · <%= link_to "Access and erasure", new_agent_subject_request_path, class: "text-indigo-700 hover:underline" %> · <%= link_to "Read a conversation (exceptional)", agent_reviews_path, class: "text-indigo-700 hover:underline" %></p>

  <%= form_with model: @setting, url: agent_setting_path, method: :patch, scope: :agent_setting, class: "space-y-6" do |f| %>
    <% if @setting.errors.any? %>
      <p role="alert" class="rounded-md border border-red-200 bg-red-50 p-2 text-sm text-red-700"><%= @setting.errors.full_messages.to_sentence %></p>
    <% end %>

    <section class="space-y-3 rounded-lg border border-gray-200 bg-white p-4">
      <h2 class="text-sm font-semibold text-gray-900">Data processing terms</h2>
      <%= render "agent/settings/consent" %>
      <% if consent %>
        <p class="text-xs text-green-700">Accepted on <%= l(consent.accepted_at, format: :short) %> by <%= consent.accepted_by.email %> (terms of <%= consent.version %>).</p>
      <% else %>
        <div class="flex items-start gap-2">
          <%= check_box_tag :accept_consent, "1", false, class: "mt-1 rounded border-gray-300" %>
          <%= label_tag :accept_consent, "I have read these terms and I accept them for this entity (version #{Agent::Consent::VERSION}).", class: "text-sm text-gray-700" %>
        </div>
      <% end %>
    </section>

    <section class="space-y-3 rounded-lg border border-gray-200 bg-white p-4">
      <div class="flex items-start gap-2">
        <%= f.check_box :enabled, class: "mt-1 rounded border-gray-300" %>
        <%= f.label :enabled, class: "text-sm text-gray-700" do %>
          Turn the assistant on for this entity
          <span class="block text-xs text-gray-400">People who have the right to use it see the assistant tab on every page. An emergency switch on the platform can still switch it off everywhere.</span>
        <% end %>
      </div>
    </section>

    <section class="space-y-3 rounded-lg border border-gray-200 bg-white p-4">
      <h2 class="text-sm font-semibold text-gray-900">What goes to the language model</h2>
      <div class="flex items-start gap-2">
        <%= f.check_box :restricted, class: "mt-1 rounded border-gray-300" %>
        <%= f.label :restricted, class: "text-sm text-gray-700" do %>
          Restricted mode: aggregates only
          <span class="block text-xs text-gray-400">No free text, no name, no bank or VAT number leaves LedgerFlow, whatever is chosen below.</span>
        <% end %>
      </div>
      <table class="min-w-full text-sm">
        <% Agent::Setting::DATA_CLASSES.each do |data_class| %>
          <tr>
            <td class="py-1 pr-3 text-gray-700"><label for="agent_setting_data_class_modes_<%= data_class %>"><%= labels.fetch(data_class) %></label></td>
            <td class="py-1">
              <%= select_tag "agent_setting[data_class_modes][#{data_class}]", options_for_select([ [ "As it is", "send" ], [ "Masked", "mask" ], [ "Never sent", "block" ] ], @setting.data_class_modes[data_class] || Agent::Setting::DEFAULT_MODES[data_class]),
                    id: "agent_setting_data_class_modes_#{data_class}", class: "rounded-md border-gray-300 text-sm" %>
            </td>
          </tr>
        <% end %>
      </table>
    </section>

    <section class="rounded-lg border border-gray-200 bg-white p-4">
      <%= f.label :retention_days, "Keep conversations for", class: "block text-sm text-gray-700" %>
      <%= f.select :retention_days, Agent::Setting::RETENTION_CHOICES.map { |days| [ "#{days} days", days ] }, {}, class: "mt-1 rounded-md border-gray-300 text-sm" %>
      <p class="mt-1 text-xs text-gray-400">After that, the content of a conversation is deleted. Only the audit trail remains.</p>
    </section>

    <section class="rounded-lg border border-gray-200 bg-white p-4">
      <p class="text-sm font-medium text-gray-700">Reading documents</p>
      <p class="mt-1 text-sm text-gray-600">Text only: when you ask the assistant to read a document, the text read locally is sent, masked (identifiers and names as tokens), once, for that document. No file and no image is ever sent.</p>
      <p class="mt-1 text-xs text-gray-400">Sending the document itself is not available.</p>
    </section>

    <section class="rounded-lg border border-gray-200 bg-white p-4">
      <%= f.label :review_threshold, "Extra review above (EUR)", class: "block text-sm text-gray-700" %>
      <%= f.number_field :review_threshold, step: "0.01", min: 0, class: "mt-1 w-40 rounded-md border-gray-300 text-sm" %>
      <p class="mt-1 text-xs text-gray-400">An entry the assistant proposes for a total at or above this amount shows its justification open, and asks you to confirm that you read it before the draft is created.</p>
    </section>

    <section class="rounded-lg border border-gray-200 bg-white p-4 space-y-2">
      <p class="text-sm font-medium text-gray-700">Writing profile of the company</p>
      <p class="text-xs text-gray-500">The style the assistant follows when it drafts a text. It learns nothing by itself: it changes only here, by an owner. Approve three to five examples of texts you like, or none.</p>
      <% profile = @setting.writing_profile.to_h %>
      <div class="grid grid-cols-2 gap-3 text-sm">
        <div><%= label_tag "writing_profile_formality", "Address" %><%= select_tag "writing_profile[formality]", options_for_select([ [ "Formal (vous)", "vous" ], [ "Informal (tu)", "tu" ], [ "Neutral", "neutral" ] ], profile["formality"]), include_blank: true, id: "writing_profile_formality", class: "mt-1 w-full rounded-md border-gray-300 text-sm" %></div>
        <div><%= label_tag "writing_profile_length_words", "Target length (words)" %><%= number_field_tag "writing_profile[length_words]", profile["length_words"], min: 20, max: 500, id: "writing_profile_length_words", class: "mt-1 w-full rounded-md border-gray-300 text-sm" %></div>
        <div><%= label_tag "writing_profile_opening", "Opening formula" %><%= text_field_tag "writing_profile[opening]", profile["opening"], id: "writing_profile_opening", class: "mt-1 w-full rounded-md border-gray-300 text-sm" %></div>
        <div><%= label_tag "writing_profile_closing", "Closing formula" %><%= text_field_tag "writing_profile[closing]", profile["closing"], id: "writing_profile_closing", class: "mt-1 w-full rounded-md border-gray-300 text-sm" %></div>
      </div>
      <div class="text-sm"><%= label_tag "writing_profile_signature", "Signature" %><%= text_area_tag "writing_profile[signature]", profile["signature"], rows: 2, id: "writing_profile_signature", class: "mt-1 w-full rounded-md border-gray-300 text-sm" %></div>
      <% (1..3).each do |level| %>
        <div class="text-sm"><%= label_tag "writing_profile_firmness_#{level}", "Firmness of a level #{level} reminder" %><%= text_field_tag "writing_profile[firmness][#{level}]", profile.dig("firmness", level.to_s), id: "writing_profile_firmness_#{level}", class: "mt-1 w-full rounded-md border-gray-300 text-sm" %></div>
      <% end %>
      <% 5.times do |index| %>
        <div class="text-sm"><%= label_tag "writing_profile_example_#{index}", "Approved example #{index + 1}" %><%= text_area_tag "writing_profile[examples][]", Array(profile["examples"])[index], rows: 3, id: "writing_profile_example_#{index}", class: "mt-1 w-full rounded-md border-gray-300 text-sm" %></div>
      <% end %>
    </section>

    <section class="rounded-lg border border-gray-200 bg-white p-4">
      <label class="flex items-center gap-2 text-sm text-gray-700"><%= f.check_box :digest_email_details %> Allow names and figures in the e-mails of the summary</label>
      <p class="mt-1 text-xs text-gray-400">By default the e-mail of a summary carries counts and links only: an e-mail leaves the application and may be read elsewhere.</p>
    </section>

    <%= f.submit "Save", class: "rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700" %>
  <% end %>
</div>
