<% content_for :breadcrumb do %><span class="text-gray-900 font-medium"><%= link_to "Knowledge base", agent_knowledge_documents_path %> / Gaps</span><% end %>
<div class="space-y-4">
  <p class="text-sm text-gray-600">Questions for which the base had no passage, and answers found not useful, the most frequent first. They say what to add.</p>
  <% if @gaps.empty? %>
    <p class="text-sm text-gray-500">Nothing to report.</p>
  <% else %>
    <div class="overflow-x-auto rounded-lg border border-gray-200 bg-white">
      <table class="min-w-full divide-y divide-gray-200 text-sm">
        <thead class="bg-gray-50 text-left text-xs uppercase text-gray-500"><tr><th class="px-3 py-2">Question</th><th class="px-3 py-2">What happened</th><th class="px-3 py-2">Times</th><th class="px-3 py-2">Last</th></tr></thead>
        <tbody class="divide-y divide-gray-100">
          <% @gaps.each do |gap| %>
            <tr><td class="px-3 py-2"><%= gap[:question] %></td><td class="px-3 py-2"><%= gap[:kind] == "no_passage" ? "No passage found" : "Answer not useful" %></td><td class="px-3 py-2"><%= gap[:count] %></td><td class="whitespace-nowrap px-3 py-2 text-gray-500"><%= l(gap[:last_at], format: :short) %></td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
