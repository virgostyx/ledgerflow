<% content_for :breadcrumb do %><span class="text-gray-900 font-medium">Assistant: a conversation read</span><% end %>
<div class="max-w-3xl space-y-4">
  <p class="rounded-md border border-amber-200 bg-amber-50 p-3 text-sm text-amber-900">Read-only. You are reading a conversation of <%= @review.author.email %>, for this reason: “<%= @review.reason %>”. They were told, and it is in the audit trail. This reading ends at <%= l(@review.reviewed_at + Agent::ConversationReview::OPEN_FOR, format: :short) %>.</p>
  <% @messages.each do |message| %>
    <div class="rounded-lg border border-gray-200 bg-white p-3 text-sm">
      <p class="text-xs font-medium uppercase text-gray-500"><%= message.role %> · <%= l(message.created_at, format: :short) %></p>
      <div class="mt-1 whitespace-pre-wrap"><%= @conversation.reveal(message.content) %></div>
    </div>
  <% end %>
  <%= link_to "← Back to the list", agent_reviews_path, class: "text-sm text-indigo-700 hover:underline" %>
</div>
