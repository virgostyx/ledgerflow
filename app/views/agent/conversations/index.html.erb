<turbo-frame id="agent_panel">
  <div class="p-4 space-y-4">
    <div class="flex items-center justify-between">
      <h2 class="text-base font-semibold text-gray-900">Assistant</h2>
      <%= button_to "New conversation", agent_conversations_path, params: { screen: @screen }, method: :post,
            class: "rounded-md bg-indigo-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
    </div>

    <p class="text-xs"><%= link_to "Privacy: what is sent and kept", agent_privacy_path, class: "text-indigo-700 hover:underline" %> · <%= link_to "Export my conversations", export_agent_conversations_path, data: { turbo: false }, class: "text-indigo-700 hover:underline" %></p>

    <% if @conversations.empty? %>
      <p class="text-sm text-gray-500">No conversation yet. Start one to ask a question about the books of this entity.</p>
    <% else %>
      <ul class="divide-y divide-gray-100 rounded-lg border border-gray-200 bg-white">
        <% @conversations.each do |conversation| %>
          <li class="flex items-center justify-between gap-2 px-3 py-2">
            <%= link_to conversation.title.presence || "Untitled", agent_conversation_path(conversation), class: "min-w-0 flex-1 truncate text-sm text-indigo-700 hover:underline" %>
            <time class="shrink-0 text-xs text-gray-400" datetime="<%= conversation.updated_at.iso8601 %>"><%= l(conversation.updated_at, format: :short) %></time>
            <%= button_to "Archive", agent_conversation_path(conversation), method: :patch, params: { agent_conversation: { archived: "1" } },
                  class: "text-xs text-gray-500 hover:text-gray-800", form: { aria: { label: "Archive #{conversation.title}" } } %>
            <%= button_to "Delete", agent_conversation_path(conversation), method: :delete,
                  class: "text-xs text-red-600 hover:text-red-800", form: { data: { turbo_confirm: "Delete this conversation and everything said in it?" }, aria: { label: "Delete #{conversation.title}" } } %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
</turbo-frame>
