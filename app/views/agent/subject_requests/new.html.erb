<% content_for :breadcrumb do %><span class="text-gray-900 font-medium">Assistant: access and erasure</span><% end %>
<div class="max-w-2xl space-y-4">
  <p class="text-sm text-gray-600">Find a natural person in the conversations with the assistant, to give them what concerns them or to erase it. The search reads the conversations of this entity; it shows who was talking and when, not what was said. Each export or erasure is written in the audit trail with its reason, and holds a fingerprint of the name, not the name.</p>

  <% if @error %><p role="alert" class="rounded-md border border-red-200 bg-red-50 p-2 text-sm text-red-700"><%= @error %></p><% end %>

  <%= form_with url: agent_subject_requests_path, method: :post, class: "space-y-3 rounded-lg border border-gray-200 bg-white p-4" do %>
    <div>
      <%= label_tag :name, "Name of the person", class: "block text-sm text-gray-700" %>
      <%= text_field_tag :name, @name, class: "mt-1 w-full rounded-md border-gray-300 text-sm", maxlength: 120 %>
    </div>
    <div>
      <%= label_tag :reason, "Reason of the request (required to export or erase)", class: "block text-sm text-gray-700" %>
      <%= text_field_tag :reason, params[:reason], class: "mt-1 w-full rounded-md border-gray-300 text-sm", maxlength: 500 %>
    </div>
    <div class="flex gap-2">
      <%= button_tag "Search", name: "operation", value: "search", class: "rounded-md bg-gray-800 px-3 py-1.5 text-sm font-medium text-white" %>
      <% if @conversations&.any? %>
        <%= button_tag "Export what concerns them", name: "operation", value: "export", class: "rounded-md bg-indigo-600 px-3 py-1.5 text-sm font-medium text-white" %>
        <%= button_tag "Erase it", name: "operation", value: "erase", class: "rounded-md bg-red-600 px-3 py-1.5 text-sm font-medium text-white", data: { turbo_confirm: "Erase these conversations for good?" } %>
      <% end %>
    </div>
  <% end %>

  <% if @conversations %>
    <% if @conversations.empty? %>
      <p class="text-sm text-gray-500">No conversation mentions this person.</p>
    <% else %>
      <ul class="divide-y divide-gray-100 rounded-lg border border-gray-200 bg-white text-sm">
        <% @conversations.each do |conversation| %>
          <li class="flex justify-between px-3 py-2"><span><%= conversation.title %> · <%= conversation.user.email %></span><time class="text-gray-400"><%= l(conversation.updated_at, format: :short) %></time></li>
        <% end %>
      </ul>
    <% end %>
  <% end %>
</div>
