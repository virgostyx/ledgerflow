<% content_for :breadcrumb do %><span class="text-gray-900 font-medium"><%= link_to "Knowledge base", (@manager ? agent_knowledge_documents_path : accounting_root_path) %> / <%= @document.title %></span><% end %>
<div class="space-y-6">
  <% if @document.retired? %>
    <p role="status" class="rounded-md border border-gray-300 bg-gray-50 p-3 text-sm text-gray-700">Document withdrawn on <%= l(@document.retired_at.to_date) %>: the assistant no longer quotes it.</p>
  <% elsif @document.draft? %>
    <p role="status" class="rounded-md border border-amber-200 bg-amber-50 p-3 text-sm text-amber-800">Draft: not used yet. It must be reviewed first.</p>
  <% end %>
  <% if @document.injection_suspected? %>
    <p role="alert" class="rounded-md border border-red-200 bg-red-50 p-3 text-sm text-red-800">Some text of this document looks like an instruction to an AI. The assistant treats it as data and ignores it; read it before you review the document.</p>
  <% end %>

  <dl class="grid grid-cols-2 gap-x-6 gap-y-2 text-sm md:grid-cols-3">
    <% { "Scope" => @document.scope.capitalize, "Version" => @document.version, "Source" => @document.source, "Licence" => @document.licence, "Country" => @document.jurisdiction, "Language" => @document.language.upcase,
         "In force" => "#{l(@document.valid_from)} – #{@document.valid_to ? l(@document.valid_to) : 'open'}", "Status" => @document.status.capitalize,
         "Reviewed" => (@document.reviewed? || @document.retired?) && @document.reviewed_at ? "#{l(@document.reviewed_at.to_date)} by #{@document.reviewed_by&.email}" : "—" }.each do |term, value| %>
      <div><dt class="text-xs uppercase text-gray-500"><%= term %></dt><dd class="text-gray-900"><%= value %></dd></div>
    <% end %>
  </dl>

  <% if @manager && @document.editable_by?(ActsAsTenant.current_tenant) %>
    <div class="flex flex-wrap gap-3">
      <% if @document.draft? %>
        <%= button_to "Review (mark as reviewed)", review_agent_knowledge_document_path(@document), params: (@document.version > 1 ? { retire_previous: "1" } : {}), class: "rounded-md bg-indigo-600 px-3 py-2 text-sm text-white hover:bg-indigo-700" %>
      <% end %>
      <%= link_to "New version", new_version_agent_knowledge_document_path(@document), class: "rounded-md border border-gray-300 px-3 py-2 text-sm hover:bg-gray-50" %>
      <% unless @document.retired? %>
        <%= button_to "Withdraw", retire_agent_knowledge_document_path(@document), class: "rounded-md border border-gray-300 px-3 py-2 text-sm hover:bg-gray-50", form: { data: { turbo_confirm: "Withdraw this document? The assistant will stop quoting it." } } %>
      <% end %>
    </div>
  <% end %>

  <% if @previous %>
    <div>
      <h2 class="text-sm font-semibold text-gray-900">Changes since version <%= @previous.version %></h2>
      <% if @removed.empty? && @added.empty? %>
        <p class="text-sm text-gray-500">The text is the same.</p>
      <% else %>
        <ul class="mt-1 space-y-1 font-mono text-xs">
          <% @removed.each do |line| %><li class="bg-red-50 px-2 py-1 text-red-800">− <%= line %></li><% end %>
          <% @added.each do |line| %><li class="bg-green-50 px-2 py-1 text-green-800">+ <%= line %></li><% end %>
        </ul>
      <% end %>
    </div>
  <% end %>

  <div>
    <h2 class="text-sm font-semibold text-gray-900">Passages</h2>
    <ol class="mt-2 space-y-3">
      <% @chunks.each do |chunk| %>
        <li id="p-<%= chunk.position %>" class="rounded-md border border-gray-200 bg-white p-3 text-sm target:ring-2 target:ring-indigo-400">
          <p class="text-xs text-gray-500">Passage <%= chunk.position %><%= " · #{chunk.section}" if chunk.section %><%= " · low quality" if chunk.quality == "low" %></p>
          <p class="mt-1 whitespace-pre-line text-gray-900"><%= chunk.content %></p>
        </li>
      <% end %>
    </ol>
  </div>
</div>
