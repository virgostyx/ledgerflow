<% content_for :breadcrumb do %><span class="text-gray-900 font-medium"><%= link_to "Texts drafted by the assistant", agent_text_drafts_path %> / <%= @draft.kind.humanize %></span><% end %>
<div class="grid gap-4 lg:grid-cols-3">
  <div class="space-y-4 lg:col-span-2" data-controller="clipboard" data-clipboard-url-value="<%= copied_agent_text_draft_path(@draft) %>">
    <p class="text-sm text-gray-600">Written by the assistant for you<%= " about #{@draft.partner.name}" if @draft.partner %>, in <%= @draft.language.upcase %>. <strong>It has not been sent and cannot be: a person sends it, through the usual screens.</strong></p>
    <% @draft.warnings.each do |warning| %><p class="rounded-md border border-amber-200 bg-amber-50 p-2 text-sm text-amber-900"><%= warning %></p><% end %>

    <%= form_with url: agent_text_draft_path(@draft), method: :patch, class: "space-y-2" do %>
      <% if @draft.subject_line.present? || @draft.kind == "dunning_letter" %>
        <%= text_field_tag :subject, @draft.subject_line, maxlength: 200, disabled: !@draft.draft?, aria: { label: "Subject" }, class: "w-full rounded-md border-gray-300 text-sm" %>
      <% end %>
      <%= text_area_tag :body, @draft.body, rows: 16, disabled: !@draft.draft?, data: { clipboard_target: "source" }, aria: { label: "Text" }, class: "w-full rounded-md border-gray-300 font-mono text-sm" %>
      <% if @draft.draft? %><%= submit_tag "Save my changes", class: "rounded-md border border-gray-300 px-3 py-1.5 text-sm hover:bg-gray-50" %><% end %>
    <% end %>

    <% if @draft.draft? %>
      <div class="flex flex-wrap items-center gap-2 text-sm">
        <button type="button" data-action="clipboard#copy" class="rounded-md bg-indigo-600 px-3 py-1.5 text-white hover:bg-indigo-700">Copy</button>
        <% @items.each do |item| %>
          <%= button_to "Use in the reminder of #{l(item.run_on)}", use_in_reminder_agent_text_draft_path(@draft, item_id: item.id), class: "rounded-md border border-indigo-300 px-3 py-1.5 text-indigo-800 hover:bg-indigo-50" %>
        <% end %>
        <% @tasks.each do |task| %>
          <%= button_to "Save in the task “#{task.title.truncate(30)}”", save_in_task_agent_text_draft_path(@draft, task_id: task.id), class: "rounded-md border border-gray-300 px-3 py-1.5 hover:bg-gray-50" %>
        <% end %>
        <%= button_to "Reject", reject_agent_text_draft_path(@draft), class: "rounded-md border border-gray-300 px-3 py-1.5 hover:bg-gray-50" %>
      </div>
      <%= form_with url: regenerate_agent_text_draft_path(@draft), class: "flex flex-wrap items-end gap-2 text-sm" do %>
        <div><%= label_tag :instruction, "Another version" %><%= select_tag :instruction, options_for_select(Agent::TextDraftsController::INSTRUCTIONS.keys.map { |key| [ key.humanize.sub("Translate", "Translate to"), key ] }), include_blank: "Say it yourself…", class: "mt-1 rounded-md border-gray-300 text-sm" %></div>
        <div><%= label_tag :custom, "Your instruction" %><%= text_field_tag :custom, nil, maxlength: 200, class: "mt-1 rounded-md border-gray-300 text-sm" %></div>
        <%= submit_tag "Rewrite with the assistant", class: "rounded-md border border-gray-300 px-3 py-1.5 hover:bg-gray-50" %>
      <% end %>
    <% else %>
      <p class="text-sm text-gray-600">This draft is <%= @draft.status %><%= " (#{@draft.outcome.humanize.downcase}, #{@draft.used_in})" if @draft.outcome %>.</p>
    <% end %>
  </div>

  <aside class="space-y-4">
    <section class="rounded-lg border border-gray-200 bg-white p-3 text-sm" aria-label="Facts used">
      <h2 class="font-semibold text-gray-900">Facts used</h2>
      <% if @draft.facts.empty? %><p class="mt-1 text-gray-500">None listed: check every figure, date and number against the books.</p><% end %>
      <ul class="mt-1 space-y-1">
        <% @draft.facts.each do |fact| %>
          <% path = fact["ref"] && Agent::Refs.path(fact["ref"]) %>
          <li><span class="text-gray-600"><%= fact["label"] %>:</span> <span class="font-mono"><%= fact["value"] %></span> <%= link_to "source", path, class: "text-xs text-indigo-700 hover:underline" if path %></li>
        <% end %>
      </ul>
    </section>
    <section class="rounded-lg border border-gray-200 bg-white p-3 text-sm" aria-label="Versions">
      <h2 class="font-semibold text-gray-900">Versions</h2>
      <ol class="mt-1 space-y-1">
        <% @draft.versions.each_with_index do |version, index| %>
          <li>#<%= index + 1 %> · <%= version["by"] == "person" ? "you" : "assistant" %> · <%= version["at"].to_s.first(10) %><%= " · #{version['instruction']}" if version["instruction"] %></li>
        <% end %>
      </ol>
      <% if @previous %>
        <p class="mt-2 text-xs font-medium text-gray-700">Changes since the previous version</p>
        <ul class="font-mono text-xs">
          <% @removed.each do |line| %><li class="bg-red-50 px-1 text-red-800">− <%= line %></li><% end %>
          <% @added.each do |line| %><li class="bg-green-50 px-1 text-green-800">+ <%= line %></li><% end %>
        </ul>
      <% end %>
    </section>
  </aside>
</div>
