<% content_for :breadcrumb do %><span class="text-gray-900 font-medium">Texts drafted by the assistant</span><% end %>
<div class="space-y-4">
  <p class="text-sm text-gray-600">The texts the assistant wrote for you. It sends nothing: you read, change and use them.</p>
  <% if @drafts.empty? %>
    <p class="text-sm text-gray-500">No draft yet.</p>
  <% else %>
    <ul class="divide-y divide-gray-100 rounded-lg border border-gray-200 bg-white text-sm">
      <% @drafts.each do |draft| %>
        <li class="flex items-center justify-between px-4 py-3">
          <span><%= link_to "#{draft.kind.humanize}#{" — #{draft.partner.name}" if draft.partner}", agent_text_draft_path(draft), class: "text-indigo-700 hover:underline" %> <span class="text-gray-500">· <%= draft.language.upcase %> · <%= draft.status %><%= " (#{draft.outcome.humanize.downcase})" if draft.outcome %></span></span>
          <span class="text-gray-400"><%= l(draft.created_at, format: :short) %></span>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
