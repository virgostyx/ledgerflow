<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>LedgerFlow API <%= @document.dig("info", "version") %></title>
  <style>
    body { font: 15px/1.5 system-ui, sans-serif; margin: 0 auto; max-width: 56rem; padding: 2rem 1rem; color: #1f2937; }
    h1 { margin-bottom: .25rem } code { background: #f3f4f6; padding: .1rem .3rem; border-radius: .25rem }
    .op { border: 1px solid #e5e7eb; border-radius: .5rem; margin: .75rem 0; padding: .75rem 1rem } .method { font-weight: 700; text-transform: uppercase; margin-right: .5rem }
    .get { color: #047857 } .post { color: #1d4ed8 } .patch { color: #b45309 } .scope { float: right; font-size: .85rem; color: #6b7280 }
    table { border-collapse: collapse; margin-top: .5rem; font-size: .9rem } td, th { padding: .15rem .75rem .15rem 0; text-align: left; vertical-align: top }
  </style>
</head>
<body>
  <h1><%= @document.dig("info", "title") %> <small>v<%= @document.dig("info", "version") %></small></h1>
  <p><%= @document.dig("info", "description") %></p>
  <p>The machine-readable document: <a href="/api/v1/openapi.json">/api/v1/openapi.json</a> (OpenAPI 3.1). Base URL: <code>/api/v1</code>.</p>
  <% @document["paths"].each do |path, item| %>
    <% item.each do |method, op| %>
      <div class="op" id="<%= op["operationId"] %>">
        <span class="scope">scope <code><%= op["x-required-scope"] %></code></span>
        <span class="method <%= method %>"><%= method %></span><code><%= path %></code>
        <div><%= op["summary"] %></div>
        <% params = Array(op["parameters"]).map { |p| p["$ref"] ? @document.dig(*p["$ref"].delete_prefix("#/").split("/")) : p } %>
        <% if params.any? %>
          <table><% params.each do |p| %><tr><td><code><%= p["name"] %></code></td><td><%= p["in"] %><%= " (required)" if p["required"] %></td><td><%= p["description"] %></td></tr><% end %></table>
        <% end %>
        <div>Responses: <%= op["responses"].keys.join(", ") %></div>
      </div>
    <% end %>
  <% end %>
</body>
</html>
