<%# Hero %>
<section class="max-w-5xl mx-auto px-6 py-16 text-center">
  <div class="inline-flex items-center gap-2 bg-primary-100 text-primary-700 text-xs font-medium px-3 py-1 rounded-full mb-6">
    PCMN compliant • Belgian VAT • Peppol 2026
  </div>

  <h1 class="text-4xl font-bold text-primary-700 mb-4">
    Free Belgian accounting<br>for every business
  </h1>
  <p class="text-lg text-gray-500 mb-8 max-w-2xl mx-auto">
    LedgerFlow is a free, open-source accounting platform. Every Belgian business —
    ASBL, SA, SRL, sole trader — deserves professional bookkeeping.
    Accounting should be a right, not a privilege.
  </p>

  <% if Rails.configuration.x.open_signup %>
    <%= link_to 'Get started free', new_user_registration_path,
          class: 'inline-block bg-primary-600 hover:bg-primary-700 text-white font-semibold px-8 py-3 rounded-lg transition-colors' %>
  <% else %>
    <%= link_to 'Sign in', new_user_session_path,
          class: 'inline-block bg-primary-600 hover:bg-primary-700 text-white font-semibold px-8 py-3 rounded-lg transition-colors' %>
  <% end %>
  <a href="#demo" class="inline-block ml-3 text-primary-700 font-semibold px-4 py-3 hover:underline">See it work ↓</a>
</section>

<%# Live demo %>
<% ogm_base = 2_026_001 # invoice 2026-001
   ogm_check = (ogm_base % 97).then { |c| c.zero? ? 97 : c }
   ogm = format('%010d%02d', ogm_base, ogm_check).then { |d| "+++#{d[0, 3]}/#{d[3, 4]}/#{d[7, 5]}+++" } %>
<section id="demo" class="max-w-4xl mx-auto px-6 pb-16 scroll-mt-4" data-controller="ledger-demo">
  <div class="bg-white rounded-2xl shadow-lg border border-gray-200 p-6">
    <h2 class="text-xl font-bold text-gray-900 mb-1">Try it: one invoice, one balanced entry</h2>
    <p class="text-sm text-gray-500 mb-5">Type an amount. LedgerFlow posts it the Belgian way — PCMN accounts, VAT split, debits = credits.</p>
    <div class="flex flex-wrap items-center gap-4 mb-5">
      <div class="flex gap-3" role="radiogroup" aria-label="Invoice type">
        <% { 'sale' => 'Sale', 'purchase' => 'Purchase', 'payment' => 'Payment received' }.each do |k, l| %>
          <label class="text-sm font-medium text-gray-700 inline-flex items-center gap-1">
            <input type="radio" name="kind" value="<%= k %>" <%= 'checked' if k == 'sale' %> data-action="change->ledger-demo#update"> <%= l %>
          </label>
        <% end %>
      </div>
      <label class="text-sm font-medium text-gray-700">Amount excl. VAT (€)
        <input type="number" min="0" max="999999999.99" step="0.01" value="1000" inputmode="decimal"
               data-ledger-demo-target="net" data-action="input->ledger-demo#update"
               class="ml-2 w-36 border border-gray-300 rounded-lg px-3 py-2 text-right">
      </label>
      <div class="flex gap-3" role="radiogroup" aria-label="VAT rate">
        <% [21, 12, 6, 0].each do |r| %>
          <label class="text-sm text-gray-700 inline-flex items-center gap-1">
            <input type="radio" name="rate" value="<%= r %>" <%= 'checked' if r == 21 %> data-action="change->ledger-demo#update"> <%= r %>%
          </label>
        <% end %>
      </div>
    </div>
    <div class="min-h-44"><%# keeps the card height steady when switching scenarios %>
      <table class="w-full text-sm">
        <thead><tr class="text-left text-gray-500 border-b"><th class="py-2">Account</th><th class="text-right">Debit</th><th class="text-right">Credit</th></tr></thead>
        <tbody class="tabular-nums" data-ledger-demo-target="sale">
          <tr><td class="py-2">400000 Customers</td><td class="text-right" data-ledger-demo-target="grossCell">1 210,00 €</td><td></td></tr>
          <tr><td class="py-2">700000 Sales</td><td></td><td class="text-right" data-ledger-demo-target="netCell">1 000,00 €</td></tr>
          <tr><td class="py-2">451000 VAT payable</td><td></td><td class="text-right" data-ledger-demo-target="vatCell">210,00 €</td></tr>
          <tr><td colspan="3" class="pt-2 text-xs text-gray-500">Invoice 2026-001 · payment reference <span class="font-mono text-gray-600"><%= ogm %></span></td></tr>
        </tbody>
        <tbody class="tabular-nums" data-ledger-demo-target="purchase" hidden>
          <tr><td class="py-2">604000 Purchases of goods</td><td class="text-right" data-ledger-demo-target="netCell">1 000,00 €</td><td></td></tr>
          <tr><td class="py-2">411000 VAT recoverable</td><td class="text-right" data-ledger-demo-target="vatCell">210,00 €</td><td></td></tr>
          <tr><td class="py-2">440000 Suppliers</td><td></td><td class="text-right" data-ledger-demo-target="grossCell">1 210,00 €</td></tr>
        </tbody>
        <tbody class="tabular-nums" data-ledger-demo-target="payment" hidden>
          <tr><td class="py-2">550000 Bank</td><td class="text-right" data-ledger-demo-target="grossCell">1 210,00 €</td><td></td></tr>
          <tr><td class="py-2">400000 Customers</td><td></td><td class="text-right" data-ledger-demo-target="grossCell">1 210,00 €</td></tr>
          <tr><td colspan="3" class="pt-2 text-xs text-gray-500">Customer pays invoice 2026-001 in full — the open item is lettered and closed.</td></tr>
        </tbody>
      </table>
    </div>
    <p class="mt-4 text-sm font-medium text-green-700" data-ledger-demo-target="status" aria-live="polite">Debit 1 210,00 € = Credit 1 210,00 € ✓ balanced</p>
    <button type="button" data-action="ledger-demo#toggleBreak" data-ledger-demo-target="breakBtn"
            class="mt-3 text-sm font-medium text-primary-700 border border-primary-300 rounded-lg px-3 py-1 hover:bg-primary-50">Try to break it</button>
    <p class="mt-1 text-xs text-gray-500">The database refuses unbalanced entries — by trigger, not by good intentions.</p>
    <div class="mt-6 text-center">
      <% if Rails.configuration.x.open_signup %>
        <%= link_to 'Create your free account', new_user_registration_path,
              class: 'inline-block bg-primary-600 hover:bg-primary-700 text-white font-semibold px-6 py-2 rounded-lg transition-colors' %>
        <p class="mt-2 text-sm text-gray-500">Already have an account? <%= link_to 'Sign in', new_user_session_path, class: 'text-primary-700 font-medium hover:underline' %></p>
      <% else %>
        <%= link_to 'Sign in to your books', new_user_session_path,
              class: 'inline-block bg-primary-600 hover:bg-primary-700 text-white font-semibold px-6 py-2 rounded-lg transition-colors' %>
      <% end %>
    </div>
  </div>
</section>

<%# Features %>
<section class="bg-gray-50 py-16">
  <div class="max-w-5xl mx-auto px-6">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-200">
        <div class="text-2xl mb-3">🆓</div>
        <h3 class="font-semibold text-gray-900 mb-2">100% Free & Open Source</h3>
        <p class="text-sm text-gray-500">
          No subscription, no hidden fees. LedgerFlow is
          <a href="https://github.com/virgostyx/ledgerflow" target="_blank" rel="noopener noreferrer" class="text-primary-700 underline">open source</a> —
          your data stays yours, forever.
        </p>
      </div>
      <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-200">
        <div class="text-2xl mb-3">📒</div>
        <h3 class="font-semibold text-gray-900 mb-2">Belgian PCMN Chart of Accounts</h3>
        <p class="text-sm text-gray-500">
          Belgian PCMN pre-loaded for all company types.
          Double-entry enforced by PostgreSQL trigger.
        </p>
      </div>
      <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-200">
        <div class="text-2xl mb-3">🇧🇪</div>
        <h3 class="font-semibold text-gray-900 mb-2">Belgian VAT & Peppol 2026</h3>
        <p class="text-sm text-gray-500">
          VAT returns (boxes 01-88) and UBL 2.1 e-invoicing via Digiteal —
          ready for the 2026 Belgian legal obligation.
        </p>
      </div>
    </div>
  </div>
</section>

<%# Compliance %>
<section class="max-w-5xl mx-auto px-6 py-16 text-center">
  <p class="text-sm text-gray-500">
    Immutable audit trail • 7-year retention • NBB year-end close •
    BudgetFlow integration via JWT API
  </p>
</section>
