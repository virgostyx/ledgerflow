<%# Hero %>
<section class="max-w-5xl mx-auto px-6 py-20 text-center">
  <div class="inline-flex items-center gap-2 bg-primary-100 text-primary-700 text-xs font-medium px-3 py-1 rounded-full mb-6">
    PCMN compliant • Belgian VAT • Peppol 2026
  </div>

  <h1 class="text-4xl font-bold text-primary-700 mb-4">
    Belgian-compliant accounting<br>for your foundation
  </h1>
  <p class="text-lg text-gray-500 mb-8 max-w-2xl mx-auto">
    LedgerFlow replaces WinBooks with a modern application, integrated with your
    project management workflows and compliant with Belgian legal obligations.
  </p>

  <%= link_to 'Sign in', new_user_session_path,
        class: 'inline-block bg-primary-600 hover:bg-primary-700 text-white font-semibold px-8 py-3 rounded-lg transition-colors' %>
</section>

<%# Features %>
<section class="bg-gray-50 py-16">
  <div class="max-w-5xl mx-auto px-6">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-200">
        <div class="text-2xl mb-3">📒</div>
        <h3 class="font-semibold text-gray-900 mb-2">PCMN Chart of Accounts</h3>
        <p class="text-sm text-gray-500">
          782 PCMN accounts pre-loaded for NPOs/Foundations under RD 2019.
          Double-entry with PostgreSQL trigger.
        </p>
      </div>
      <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-200">
        <div class="text-2xl mb-3">🇧🇪</div>
        <h3 class="font-semibold text-gray-900 mb-2">Integrated Belgian VAT</h3>
        <p class="text-sm text-gray-500">
          VAT returns boxes 01-88. Automatic generation
          from accounting entries.
        </p>
      </div>
      <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-200">
        <div class="text-2xl mb-3">🔗</div>
        <h3 class="font-semibold text-gray-900 mb-2">Peppol 2026</h3>
        <p class="text-sm text-gray-500">
          UBL 2.1 e-invoicing via Digiteal.
          Ready for the Belgian legal obligation in 2026.
        </p>
      </div>
    </div>
  </div>
</section>

<%# Compliance %>
<section class="max-w-5xl mx-auto px-6 py-16 text-center">
  <p class="text-sm text-gray-400">
    Immutable audit trail • 7-year retention • NBB year-end close •
    BudgetFlow integration via JWT API
  </p>
</section>
