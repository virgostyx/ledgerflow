<%# Hero %>
<section class="max-w-5xl mx-auto px-6 py-20 text-center">
  <div class="inline-flex items-center gap-2 bg-indigo-100 text-indigo-700 text-xs font-medium px-3 py-1 rounded-full mb-6">
    Conforme PCMN • TVA belge • Peppol 2026
  </div>

  <h1 class="text-4xl font-bold text-indigo-700 mb-4">
    Comptabilité belge conforme<br>pour votre fondation
  </h1>
  <p class="text-lg text-gray-500 mb-8 max-w-2xl mx-auto">
    LedgerFlow remplace WinBooks avec une application moderne, intégrée à vos flux
    de gestion de projets et conforme aux obligations légales belges.
  </p>

  <%= link_to 'Se connecter', new_user_session_path,
        class: 'inline-block bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-8 py-3 rounded-lg transition-colors' %>
</section>

<%# Fonctionnalités %>
<section class="bg-gray-50 py-16">
  <div class="max-w-5xl mx-auto px-6">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-200">
        <div class="text-2xl mb-3">📒</div>
        <h3 class="font-semibold text-gray-900 mb-2">Plan comptable PCMN</h3>
        <p class="text-sm text-gray-500">
          782 comptes PCMN pré-chargés version ASBL/Fondation AR 2019.
          Partie double avec trigger PostgreSQL.
        </p>
      </div>
      <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-200">
        <div class="text-2xl mb-3">🇧🇪</div>
        <h3 class="font-semibold text-gray-900 mb-2">TVA belge intégrée</h3>
        <p class="text-sm text-gray-500">
          Déclarations TVA grilles 01-88. Génération automatique
          depuis les écritures comptables.
        </p>
      </div>
      <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-200">
        <div class="text-2xl mb-3">🔗</div>
        <h3 class="font-semibold text-gray-900 mb-2">Peppol 2026</h3>
        <p class="text-sm text-gray-500">
          Facturation électronique UBL 2.1 via Digiteal.
          Prêt pour l'obligation légale belge 2026.
        </p>
      </div>
    </div>
  </div>
</section>

<%# Conformité %>
<section class="max-w-5xl mx-auto px-6 py-16 text-center">
  <p class="text-sm text-gray-400">
    Audit trail immuable • Conservation 7 ans • Clôture d'exercice BNB •
    Intégration BudgetFlow via API JWT
  </p>
</section>
