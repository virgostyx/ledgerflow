<% content_for :breadcrumb do %>
  <%= render Ui::BreadcrumbsComponent.new(items: [
    { label: 'Dashboard', path: accounting_root_path },
    { label: 'Reports' },
    { label: t("accounting.reports.aged_balance.title") }
  ]) %>
<% end %>

<% t_ab = ->(key, **opts) { t("accounting.reports.aged_balance.#{key}", **opts) } %>

<div class="mx-auto max-w-7xl px-4 py-8">
  <div class="mb-6 flex items-center justify-between">
    <h1 class="text-2xl font-bold text-gray-900"><%= t_ab.(:title) %></h1>
    <%= link_to t("accounting.reports.export_csv"),
          accounting_reports_aged_balance_path(kind: @kind, as_of: @as_of, format: :csv),
          class: "btn-secondary text-sm" %>
  </div>

  <% if @rows.any? %>
    <div class="mb-6 grid gap-4 md:grid-cols-2">
      <%= render Reports::ChartComponent.new(option: Charts::AgedBuckets.buckets(@totals), title: "Balance by ageing bucket", height: 260) %>
      <%= render Reports::ChartComponent.new(option: Charts::AgedBuckets.top_partners(@rows), title: "Ten largest balances", height: 260) %>
    </div>
  <% end %>

  <%= form_with url: accounting_reports_aged_balance_path, method: :get, class: "mb-6 flex gap-4 items-end" do |f| %>
    <div>
      <%= f.label :kind, t_ab.(:kind), class: "block text-sm font-medium text-gray-700" %>
      <%= f.select :kind, [ [ t_ab.(:customer), "customer" ], [ t_ab.(:supplier), "supplier" ] ], { selected: @kind }, class: "mt-1 form-input" %>
    </div>
    <div>
      <%= f.label :as_of, t_ab.(:as_of), class: "block text-sm font-medium text-gray-700" %>
      <%= f.date_field :as_of, value: @as_of, class: "mt-1 form-input" %>
    </div>
    <label class="text-sm text-gray-700 pb-2"><%= check_box_tag :by_currency, 1, params[:by_currency].present? %> By currency</label>
    <label class="text-sm text-gray-700 pb-2"><%= check_box_tag :at_closing_rate, 1, params[:at_closing_rate].present? %> At the closing rate</label>
    <%= f.submit t("accounting.reports.filter"), class: "btn-primary" %>
  <% end %>

  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200 text-sm">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-2 text-left font-medium text-gray-600"><%= t_ab.(:partner) %></th>
          <% Accounting::AgedBalanceQuery::BUCKETS.each do |bucket| %>
            <th class="px-4 py-2 text-right font-medium text-gray-600"><%= t_ab.(bucket) %></th>
          <% end %>
          <th class="px-4 py-2 text-right font-medium text-gray-600"><%= t_ab.(:unallocated) %></th>
          <th class="px-4 py-2 text-right font-medium text-gray-600"><%= t_ab.(:total) %></th>
          <th class="px-4 py-2 text-right font-medium text-gray-600"><%= t_ab.(:overdue) %></th>
          <th class="px-4 py-2 text-right font-medium text-gray-600"><%= t_ab.(:overdue_pct) %></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100 bg-white">
        <% partner_refs  = Accounting::Partner.where(id: @rows.filter_map(&:partner_id)).index_by(&:id) %>
        <% partner_tasks = feature?(:f08) ? Accounting::TaskBadges.counts(Accounting::Partner, partner_refs.keys) : {} %>
        <% @rows.each do |row| %>
          <tr>
            <td class="px-4 py-2">
              <%= row.partner_name || t_ab.(:no_partner) %>
              <% if row.partner_id %>
                <%= task_badge(partner_refs[row.partner_id], count: partner_tasks.fetch(row.partner_id, 0)) %>
                <%= task_link(partner_refs[row.partner_id], label: "＋ Task") %>
                <% if @kind == :customer && feature?(:f09) && dunning_can?(:index?) %><%= link_to "Reminders", accounting_dunning_runs_path, class: "ml-2 text-primary-700 hover:underline text-sm" %><% end %>
              <% end %>
            </td>
            <% (Accounting::AgedBalanceQuery::BUCKETS + %i[unallocated]).each do |col| %>
              <td class="px-4 py-2 text-right"><%= number_to_currency(row[col], unit: "€") %></td>
            <% end %>
            <td class="px-4 py-2 text-right font-semibold"><%= number_to_currency(row.total, unit: "€") %><%= render "agent/explain_button", subject_type: "R04", subject_id: "#{@as_of.iso8601}:#{@kind}:#{row.partner_id}" if row.partner_id %></td>
            <td class="px-4 py-2 text-right"><%= number_to_currency(row.overdue, unit: "€") %></td>
            <td class="px-4 py-2 text-right"><%= row.overdue_pct.nil? ? "" : number_to_percentage(row.overdue_pct, precision: 1) %></td>
          </tr>
        <% end %>
        <% if @rows.empty? %>
          <tr><td colspan="10" class="px-4 py-6 text-center text-gray-400"><%= t("accounting.reports.no_data") %></td></tr>
        <% end %>
      </tbody>
      <tfoot class="bg-gray-50 font-bold">
        <tr>
          <td class="px-4 py-2">
            <%= link_to t("accounting.reports.totals"),
                  accounting_reports_unlettered_lines_path(kind: @kind, as_of: @as_of),
                  class: "text-primary-700 hover:underline" %>
          </td>
          <% (Accounting::AgedBalanceQuery::BUCKETS + %i[unallocated total]).each do |col| %>
            <td class="px-4 py-2 text-right"><%= number_to_currency(@totals[col], unit: "€") %></td>
          <% end %>
          <td class="px-4 py-2 text-right"><%= number_to_currency(@totals.overdue, unit: "€") %></td>
          <td class="px-4 py-2 text-right"><%= @totals.overdue_pct.nil? ? "" : number_to_percentage(@totals.overdue_pct, precision: 1) %></td>
        </tr>
      </tfoot>
    </table>
  </div>

  <% if @by_currency %>
    <h2 class="mt-8 mb-2 text-sm font-semibold text-gray-700">By currency</h2>
    <div class="overflow-x-auto" data-section="by-currency">
      <table class="min-w-full divide-y divide-gray-200 text-sm">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 py-2 text-left font-medium text-gray-600">Currency</th>
            <th class="px-4 py-2 text-left font-medium text-gray-600">Partner</th>
            <th class="px-4 py-2 text-right font-medium text-gray-600">Amount in currency</th>
            <th class="px-4 py-2 text-right font-medium text-gray-600">Booked (EUR)</th>
            <% if params[:at_closing_rate].present? %>
              <th class="px-4 py-2 text-right font-medium text-gray-600">Closing rate (per 1 EUR)</th>
              <th class="px-4 py-2 text-right font-medium text-gray-600">At the closing rate (EUR)</th>
            <% end %>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 bg-white font-mono">
          <% @by_currency.each do |r| %>
            <tr>
              <td class="px-4 py-2 font-sans"><%= r.currency %></td>
              <td class="px-4 py-2 font-sans"><%= r.partner_name || t_ab.(:no_partner) %></td>
              <td class="px-4 py-2 text-right"><%= format("%.#{Accounting::Currency.decimals_of(r.currency)}f", r.foreign_amount) %></td>
              <td class="px-4 py-2 text-right"><%= format("%.2f", r.booked_eur) %></td>
              <% if params[:at_closing_rate].present? %>
                <td class="px-4 py-2 text-right"><%= r.rate&.to_s("F") %></td>
                <td class="px-4 py-2 text-right"><%= r.revalued_eur ? format("%.2f", r.revalued_eur) : "No rate" %></td>
              <% end %>
            </tr>
          <% end %>
          <% if @by_currency.empty? %>
            <tr><td colspan="6" class="px-4 py-4 text-center text-gray-400 font-sans"><%= t("accounting.reports.no_data") %></td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <% if @stale_credits.any? %>
    <h2 class="mt-8 mb-2 text-sm font-semibold text-gray-700"><%= t_ab.(:stale_title, days: @stale_days) %></h2>
    <table class="min-w-full divide-y divide-gray-200 text-sm">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-2 text-left font-medium text-gray-600"><%= t_ab.(:partner) %></th>
          <th class="px-4 py-2 text-left font-medium text-gray-600"><%= t_ab.(:reference) %></th>
          <th class="px-4 py-2 text-right font-medium text-gray-600"><%= t_ab.(:age_days) %></th>
          <th class="px-4 py-2 text-right font-medium text-gray-600"><%= t_ab.(:total) %></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100 bg-white">
        <% @stale_credits.each do |row| %>
          <tr>
            <td class="px-4 py-2"><%= row.partner_name || t_ab.(:no_partner) %></td>
            <td class="px-4 py-2"><%= row.reference %></td>
            <td class="px-4 py-2 text-right"><%= row.age_days %></td>
            <td class="px-4 py-2 text-right"><%= number_to_currency(row.amount, unit: "€") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>