<% content_for :breadcrumb do %>
  <%= render Ui::BreadcrumbsComponent.new(items: [
    { label: 'Dashboard', path: accounting_root_path },
    { label: 'Reports' },
    { label: 'Trial Balance' }
  ]) %>
<% end %>

<div class="mx-auto max-w-7xl px-4 py-8">
  <div class="mb-6 flex items-center justify-between">
    <h1 class="text-2xl font-bold text-gray-900"><%= t("accounting.reports.trial_balance.title") %></h1>
    <div class="flex gap-2">
      <%= link_to t("accounting.reports.export_csv"),
            accounting_reports_trial_balance_path(fiscal_year_id: @fiscal_year.id,
                                                  as_of: @as_of, comparative: params[:comparative], format: :csv),
            class: "btn-secondary text-sm" %>
      <%= link_to t("accounting.reports.export_xlsx"),
            accounting_reports_trial_balance_path(fiscal_year_id: @fiscal_year.id,
                                                  as_of: @as_of, comparative: params[:comparative], format: :xlsx),
            class: "btn-secondary text-sm" %>
      <%= link_to "PDF",
            accounting_reports_trial_balance_path(fiscal_year_id: @fiscal_year.id,
                                                  as_of: @as_of, comparative: params[:comparative], format: :pdf),
            class: "btn-secondary text-sm" %>
    </div>
  </div>

  <%= form_with url: accounting_reports_trial_balance_path, method: :get, class: "mb-6 flex gap-4 items-end" do |f| %>
    <%= hidden_field_tag :fiscal_year_id, @fiscal_year.id %>
    <div>
      <%= f.label :as_of, t("accounting.reports.trial_balance.as_of"), class: "block text-sm font-medium text-gray-700" %>
      <%= f.date_field :as_of, value: @as_of, class: "mt-1 form-input" %>
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700">Comparative</label>
      <select name="comparative" class="mt-1 form-select">
        <option value="">None</option>
        <option value="previous_year" <%= "selected" if params[:comparative] == "previous_year" %>>Previous year</option>
      </select>
    </div>
    <%= f.submit t("accounting.reports.filter"), class: "btn-primary" %>
  <% end %>

  <% if @result.rows.empty? %>
    <p class="px-4 py-6 text-center text-gray-400"><%= t("accounting.reports.no_data") %></p>
  <% else %>
    <%= render Reports::TableComponent.new(result: @result, columns: trial_balance_view_columns) %>

    <p class="mt-4 text-sm font-semibold text-gray-700">
      Result for the period: <%= Accounting::MoneyPresenter.new(@result.totals[:result]).format %>
    </p>
  <% end %>
</div>
