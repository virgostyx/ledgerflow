<div class="mx-auto max-w-5xl px-4 py-8">
  <div class="mb-6 flex items-center justify-between">
    <h1 class="text-2xl font-bold text-gray-900">Cash-flow statement</h1>
    <%= link_to "Export XLSX (both methods)", accounting_reports_cash_flow_path(fiscal_year_id: @fiscal_year.id, from: @from, to: @to, format: :xlsx), class: "btn-secondary text-sm" %>
  </div>

  <%= form_with url: accounting_reports_cash_flow_path, method: :get, class: "mb-6 flex flex-wrap gap-4 items-end" do |f| %>
    <%= hidden_field_tag :fiscal_year_id, @fiscal_year.id %>
    <div><label class="block text-sm font-medium text-gray-700">From</label><%= f.date_field :from, value: @from, class: "mt-1 form-input" %></div>
    <div><label class="block text-sm font-medium text-gray-700">To</label><%= f.date_field :to, value: @to, class: "mt-1 form-input" %></div>
    <div><label class="block text-sm font-medium text-gray-700">Method</label>
      <%= f.select :method_view, [ [ "Indirect", "indirect" ], [ "Direct", "direct" ] ], { selected: @method.to_s }, class: "mt-1 form-select" %></div>
    <%= f.submit "Update", class: "btn-primary" %>
  <% end %>

  <div class="mb-6 rounded-lg border border-gray-200 bg-white p-4">
    <%= render Reports::ChartComponent.new(option: Charts::CashFlowWaterfall.call(@statement), title: "Cash from opening to closing balance", height: 260) %>
  </div>

  <% sheet = @statement.public_send(@method) %>
  <% money = ->(v) { number_to_currency(v, unit: "€") } %>
  <table class="min-w-full divide-y divide-gray-200 text-sm">
    <tbody class="divide-y divide-gray-100 bg-white">
      <tr class="bg-gray-50 font-semibold"><td class="px-4 py-2">Opening cash (55, 57)</td><td class="px-4 py-2 text-right font-mono"><%= money.(@statement.opening_cash) %></td></tr>
      <% Accounting::CashFlowStatement::SECTIONS.each do |section| %>
        <% lines = sheet.lines.select { |l| l.section == section } %>
        <% next if lines.empty? || (section != :operating && section != :investing && section != :financing && sheet.section_total(section).zero? && lines.all? { |l| l.amount.zero? }) %>
        <tr class="bg-gray-50 font-semibold"><td class="px-4 py-2"><%= section == :unclassified ? "Non classé" : "#{section.to_s.humanize} activities" %></td>
          <td class="px-4 py-2 text-right font-mono"><%= money.(sheet.section_total(section)) %></td></tr>
        <% lines.each do |l| %>
          <tr><td class="px-8 py-1 text-gray-700"><%= l.label %></td><td class="px-4 py-1 text-right font-mono"><%= money.(l.amount) %></td></tr>
        <% end %>
      <% end %>
      <tr class="font-semibold"><td class="px-4 py-2">Net change in cash</td><td class="px-4 py-2 text-right font-mono"><%= money.(sheet.total) %></td></tr>
      <tr class="bg-gray-50 font-semibold"><td class="px-4 py-2">Closing cash</td><td class="px-4 py-2 text-right font-mono"><%= money.(@statement.closing_cash) %></td></tr>
    </tbody>
  </table>
  <p class="mt-3 text-xs text-gray-500">
    Check (I9): indirect <%= money.(@statement.indirect.total) %> · direct <%= money.(@statement.direct.total) %> · closing − opening <%= money.(@statement.net_change) %>.
  </p>
</div>
