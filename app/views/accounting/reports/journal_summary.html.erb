<div class="mx-auto max-w-7xl px-4 py-8">
  <h1 class="mb-6 text-2xl font-bold text-gray-900">Journals — summary</h1>

  <% @gaps.each do |journal_id, gaps| %>
    <p class="mb-2 rounded bg-amber-50 px-4 py-2 text-sm text-amber-800">
      <%= Accounting::Journal.find(journal_id).code %>: missing numbers <%= gaps.join(", ") %>
    </p>
  <% end %>

  <table class="min-w-full divide-y divide-gray-200 text-sm">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-4 py-2 text-left font-medium text-gray-600">Journal</th>
        <th class="px-4 py-2 text-left font-medium text-gray-600">Month</th>
        <th class="px-4 py-2 text-right font-medium text-gray-600">Entries</th>
        <th class="px-4 py-2 text-right font-medium text-gray-600">Debit</th>
        <th class="px-4 py-2 text-right font-medium text-gray-600">Credit</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100 bg-white">
      <% @rows.each do |row| %>
        <tr>
          <td class="px-4 py-2 font-mono"><%= row.journal_code %></td>
          <td class="px-4 py-2"><%= l(row.month, format: :short) %></td>
          <td class="px-4 py-2 text-right"><%= row.entry_count %></td>
          <td class="px-4 py-2 text-right"><%= number_to_currency(row.total_debit, unit: "€") %></td>
          <td class="px-4 py-2 text-right"><%= number_to_currency(row.total_credit, unit: "€") %></td>
        </tr>
      <% end %>
      <% if @rows.empty? %>
        <tr>
          <td colspan="5" class="px-4 py-6 text-center text-gray-400"><%= t("accounting.reports.no_data") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
