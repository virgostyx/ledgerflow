<% content_for :breadcrumb do %>
  <%= render Ui::BreadcrumbsComponent.new(items: [
    { label: 'Dashboard', path: accounting_root_path },
    { label: 'Reports' },
    { label: 'Annual accounts' }
  ]) %>
<% end %>

<%= render Ui::PageHeaderComponent.new(title: "Annual accounts #{@report.fiscal_year.year}",
      description: 'Balance sheet and income statement by legal heading, following the abridged model for companies (BNB codes).') do |header| %>
  <% header.with_actions do %>
    <%= form_with url: accounting_reports_annual_accounts_path, method: :get, class: 'flex items-center gap-2' do %>
      <%= select_tag :fiscal_year_id, options_from_collection_for_select(Accounting::FiscalYear.order(year: :desc), :id, :year, @report.fiscal_year.id),
            class: 'rounded-md border border-gray-300 px-2 py-1.5 text-sm', onchange: 'this.form.requestSubmit()' %>
    <% end %>
    <%= link_to 'Export XLSX', accounting_reports_annual_accounts_path(fiscal_year_id: @report.fiscal_year.id, format: :xlsx),
          class: 'px-4 py-2 border border-gray-300 text-sm text-gray-700 rounded-md hover:bg-gray-50 transition-colors' %>
  <% end %>
<% end %>

<p class="mb-4 rounded-md border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
  The mapping of accounts to headings has not been validated by an accountant. Check it before filing anything with the
  National Bank of Belgium. Accounts of class 69 and 79 (appropriation of the result) are not shown.
</p>

<% if @report.balanced? %>
  <p class="mb-4 text-sm font-medium text-green-700">The balance sheet is balanced.</p>
<% else %>
  <p class="mb-4 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
    The balance sheet does not balance: assets and liabilities differ by <%= Accounting::MoneyPresenter.new(@report.difference.abs).format %>.
    This usually means an account that fits no heading (below), or a previous fiscal year that was not carried forward.
  </p>
<% end %>

<% if @report.unmapped.any? %>
  <div class="mb-6 bg-white rounded-lg border border-gray-200 overflow-x-clip">
    <h2 class="px-4 py-3 text-sm font-semibold text-red-700 border-b border-gray-200">Accounts that fit no heading</h2>
    <table class="w-full text-sm">
      <tbody class="divide-y divide-gray-100">
        <% @report.unmapped.each do |account| %>
          <tr>
            <td class="px-3 py-2 font-mono"><%= account.code %></td>
            <td class="px-3 py-2"><%= account.label %></td>
            <td class="px-3 py-2 text-right font-mono"><%= Accounting::MoneyPresenter.new(account.balance).format %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
  <%= render 'annual_statement', title: 'Balance sheet: assets', rows: @report.rows(:assets), report: @report %>
  <%= render 'annual_statement', title: 'Balance sheet: liabilities', rows: @report.rows(:liabilities), report: @report %>
</div>

<div class="mb-2 flex gap-2">
  <%= link_to 'Annual', accounting_reports_annual_accounts_path(fiscal_year_id: @report.fiscal_year.id),
        class: "px-3 py-1 text-sm rounded-md #{@monthly ? 'text-gray-600 hover:bg-gray-100' : 'bg-primary-600 text-white'}" %>
  <%= link_to 'Monthly', accounting_reports_annual_accounts_path(fiscal_year_id: @report.fiscal_year.id, view: 'monthly'),
        class: "px-3 py-1 text-sm rounded-md #{@monthly ? 'bg-primary-600 text-white' : 'text-gray-600 hover:bg-gray-100'}" %>
</div>

<% if @monthly %>
  <div class="bg-white rounded-lg border border-gray-200 overflow-x-auto">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 border-b border-gray-200">
        <tr class="text-xs font-medium text-gray-500 uppercase tracking-wider">
          <th class="px-3 py-2 text-left">Heading</th>
          <% (1..12).each { |n| %><th class="px-3 py-2 text-right">M<%= n %></th><% } %>
          <th class="px-3 py-2 text-right">Cumulative</th>
          <% if @report.previous_year %><th class="px-3 py-2 text-right">Cumulative N-1</th><% end %>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @report.monthly_income.each do |row| %>
          <% weight = { 0 => "font-bold bg-gray-50", 1 => "font-semibold", 2 => "" }.fetch(row.level) %>
          <tr class="<%= weight %>">
            <td class="px-3 py-2 text-gray-800 whitespace-nowrap"><%= row.label %></td>
            <% row.months.each do |m| %><td class="px-3 py-2 text-right font-mono"><%= Accounting::MoneyPresenter.new(m).format %></td><% end %>
            <td class="px-3 py-2 text-right font-mono"><%= Accounting::MoneyPresenter.new(row.cumulative).format %></td>
            <% if @report.previous_year %>
              <td class="px-3 py-2 text-right font-mono text-gray-600"><%= Accounting::MoneyPresenter.new(row.previous_cumulative).format %></td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <%= render 'annual_statement', title: 'Income statement', rows: @report.rows(:income), report: @report %>
<% end %>
