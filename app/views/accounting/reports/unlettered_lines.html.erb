<div class="mx-auto max-w-7xl px-4 py-8">
  <h1 class="mb-6 text-2xl font-bold text-gray-900">Unlettered lines</h1>

  <%= form_with url: accounting_reports_unlettered_lines_path, method: :get, class: "mb-6 flex gap-4 items-end" do |f| %>
    <div>
      <label class="block text-sm font-medium text-gray-700">Type</label>
      <%= f.select :kind, [ [ "Both", "both" ], [ "Customers", "customer" ], [ "Suppliers", "supplier" ] ],
            { selected: @kind }, class: "mt-1 form-select" %>
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700">As of</label>
      <%= f.date_field :as_of, value: @as_of, class: "mt-1 form-input" %>
    </div>
    <%= f.submit "Filter", class: "btn-primary" %>
  <% end %>

  <% @rows.group_by(&:partner_name).each do |partner_name, lines| %>
    <h2 class="mt-6 mb-2 text-sm font-semibold text-gray-700">
      <%= partner_name || "No partner" %> — subtotal: <%= number_to_currency(lines.sum(&:residual), unit: "€") %>
    </h2>
    <table class="min-w-full divide-y divide-gray-200 text-sm">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-2 text-left font-medium text-gray-600">Account</th>
          <th class="px-4 py-2 text-left font-medium text-gray-600">Date</th>
          <th class="px-4 py-2 text-left font-medium text-gray-600">Journal</th>
          <th class="px-4 py-2 text-left font-medium text-gray-600">Reference</th>
          <th class="px-4 py-2 text-left font-medium text-gray-600">Due date</th>
          <th class="px-4 py-2 text-right font-medium text-gray-600">Debit</th>
          <th class="px-4 py-2 text-right font-medium text-gray-600">Credit</th>
          <th class="px-4 py-2 text-right font-medium text-gray-600">Residual</th>
          <th class="px-4 py-2 text-right font-medium text-gray-600">Age (days)</th>
          <th class="px-4 py-2 text-left font-medium text-gray-600">Lettering</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100 bg-white">
        <% lines.each do |row| %>
          <tr>
            <td class="px-4 py-2 font-mono"><%= row.account_code %></td>
            <td class="px-4 py-2"><%= l(row.entry_date, format: :short) %></td>
            <td class="px-4 py-2"><%= row.journal_code %></td>
            <td class="px-4 py-2 font-mono text-xs"><%= row.reference %></td>
            <td class="px-4 py-2"><%= l(row.due_date, format: :short) %></td>
            <td class="px-4 py-2 text-right"><%= row.debit.positive? ? number_to_currency(row.debit, unit: "€") : "" %></td>
            <td class="px-4 py-2 text-right"><%= row.credit.positive? ? number_to_currency(row.credit, unit: "€") : "" %></td>
            <td class="px-4 py-2 text-right font-semibold"><%= number_to_currency(row.residual, unit: "€") %></td>
            <td class="px-4 py-2 text-right"><%= row.age_days %></td>
            <td class="px-4 py-2 font-mono text-xs"><%= row.lettering_code %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>

  <% if @rows.empty? %>
    <p class="px-4 py-6 text-center text-gray-400">No open, unlettered lines.</p>
  <% end %>

  <% if @balanced_groups.any? %>
    <h2 class="mt-8 mb-2 text-sm font-semibold text-amber-700">Balanced groups left unlettered</h2>
    <p class="mb-2 text-sm text-gray-500">These lines cancel each other out but were never lettered — candidates for immediate lettering.</p>
    <ul class="list-disc pl-5 text-sm">
      <% @balanced_groups.each do |group| %>
        <li><%= group.partner_name || "No partner" %> — <%= group.account_code %> (<%= group.lines.size %> lines)</li>
      <% end %>
    </ul>
  <% end %>
</div>
