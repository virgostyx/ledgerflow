<div class="mx-auto max-w-7xl px-4 py-8">
  <h1 class="mb-6 text-2xl font-bold text-gray-900"><%= t("accounting.reports.general_ledger.title") %></h1>

  <%= form_with url: accounting_reports_general_ledger_path, method: :get, class: "mb-6 flex flex-wrap gap-4 items-end" do |f| %>
    <%= hidden_field_tag :fiscal_year_id, @fiscal_year.id %>
    <div>
      <%= f.label :account_id, t("accounting.reports.general_ledger.account"), class: "block text-sm font-medium text-gray-700" %>
      <%= f.select :account_id,
            @accounts.map { |a| [a.full_label, a.id] },
            { include_blank: t("accounting.reports.general_ledger.select_account"),
              selected: @account&.id },
            class: "mt-1 form-select" %>
    </div>
    <div>
      <%= f.label :date_from, t("accounting.reports.date_from"), class: "block text-sm font-medium text-gray-700" %>
      <%= f.date_field :date_from, value: @date_from, class: "mt-1 form-input" %>
    </div>
    <div>
      <%= f.label :date_to, t("accounting.reports.date_to"), class: "block text-sm font-medium text-gray-700" %>
      <%= f.date_field :date_to, value: @date_to, class: "mt-1 form-input" %>
    </div>
    <%= f.submit t("accounting.reports.filter"), class: "btn-primary" %>
    <% if @account %>
      <%= link_to t("accounting.reports.export_csv"),
            accounting_reports_general_ledger_path(fiscal_year_id: @fiscal_year.id,
                                                   account_id: @account.id,
                                                   date_from: @date_from,
                                                   date_to: @date_to,
                                                   format: :csv),
            class: "btn-secondary text-sm" %>
    <% end %>
  <% end %>

  <% if @account %>
    <h2 class="mb-4 text-lg font-semibold text-primary-700"><%= @account.full_label %></h2>

    <table class="min-w-full divide-y divide-gray-200 text-sm">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-2 text-left font-medium text-gray-600"><%= t("accounting.reports.csv.date") %></th>
          <th class="px-4 py-2 text-left font-medium text-gray-600"><%= t("accounting.reports.csv.reference") %></th>
          <th class="px-4 py-2 text-left font-medium text-gray-600"><%= t("accounting.reports.csv.label") %></th>
          <th class="px-4 py-2 text-right font-medium text-gray-600"><%= t("accounting.reports.csv.debit") %></th>
          <th class="px-4 py-2 text-right font-medium text-gray-600"><%= t("accounting.reports.csv.credit") %></th>
          <th class="px-4 py-2 text-right font-medium text-gray-600"><%= t("accounting.reports.csv.running_balance") %></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100 bg-white">
        <% @rows.each do |row| %>
          <tr>
            <td class="px-4 py-2"><%= l(row.entry_date, format: :short) %></td>
            <td class="px-4 py-2 font-mono text-xs"><%= row.reference %></td>
            <td class="px-4 py-2"><%= row.label %></td>
            <td class="px-4 py-2 text-right"><%= row.debit.positive? ? number_to_currency(row.debit, unit: "€") : "" %></td>
            <td class="px-4 py-2 text-right"><%= row.credit.positive? ? number_to_currency(row.credit, unit: "€") : "" %></td>
            <td class="px-4 py-2 text-right font-semibold"><%= number_to_currency(row.running_balance, unit: "€") %></td>
          </tr>
        <% end %>
        <% if @rows.empty? %>
          <tr>
            <td colspan="6" class="px-4 py-6 text-center text-gray-400">
              <%= t("accounting.reports.no_data") %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-gray-500"><%= t("accounting.reports.general_ledger.select_account_prompt") %></p>
  <% end %>
</div>
