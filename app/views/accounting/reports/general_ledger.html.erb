<div class="mx-auto max-w-7xl px-4 py-8">
  <h1 class="mb-6 text-2xl font-bold text-gray-900"><%= t("accounting.reports.general_ledger.title") %></h1>

  <%= form_with url: accounting_reports_general_ledger_path, method: :get, class: "mb-6 flex flex-wrap gap-4 items-end" do |f| %>
    <%= hidden_field_tag :fiscal_year_id, @fiscal_year.id %>
    <div>
      <%= f.label :account_id, t("accounting.reports.general_ledger.account"), class: "block text-sm font-medium text-gray-700" %>
      <%= f.select :account_id,
            @accounts.map { |a| [a.full_label, a.id] },
            { include_blank: t("accounting.reports.general_ledger.select_account"),
              selected: @account&.id },
            class: "mt-1 form-select" %>
    </div>
    <div>
      <%= f.label :date_from, t("accounting.reports.date_from"), class: "block text-sm font-medium text-gray-700" %>
      <%= f.date_field :date_from, value: @date_from, class: "mt-1 form-input" %>
    </div>
    <div>
      <%= f.label :date_to, t("accounting.reports.date_to"), class: "block text-sm font-medium text-gray-700" %>
      <%= f.date_field :date_to, value: @date_to, class: "mt-1 form-input" %>
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700">Partner</label>
      <%= f.select :partner_id, Accounting::Partner.order(:name).pluck(:name, :id),
            { include_blank: "All partners", selected: @partner&.id }, class: "mt-1 form-select" %>
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700">Journal</label>
      <%= f.select :journal_id, Accounting::Journal.active.order(:code).pluck(:code, :id),
            { include_blank: "All journals", selected: @journal_filter&.id }, class: "mt-1 form-select" %>
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700">Lettering</label>
      <%= f.select :lettering, [ ["All", ""], ["Lettered", "lettered"], ["Unlettered", "unlettered"] ],
            { selected: params[:lettering] }, class: "mt-1 form-select" %>
    </div>
    <%= f.submit t("accounting.reports.filter"), class: "btn-primary" %>
    <% if @account %>
      <%= link_to t("accounting.reports.export_csv"),
            accounting_reports_general_ledger_path(fiscal_year_id: @fiscal_year.id,
                                                   account_id: @account.id,
                                                   date_from: @date_from,
                                                   date_to: @date_to,
                                                   format: :csv),
            class: "btn-secondary text-sm" %>
    <% end %>
  <% end %>

  <% if @account %>
    <% @foreign = @rows.any? { |r| r.currency != "EUR" } %>
    <h2 class="mb-4 text-lg font-semibold text-primary-700"><%= @account.full_label %></h2>

    <table class="min-w-full divide-y divide-gray-200 text-sm">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-2 text-left font-medium text-gray-600"><%= t("accounting.reports.csv.date") %></th>
          <th class="px-4 py-2 text-left font-medium text-gray-600"><%= t("accounting.reports.csv.reference") %></th>
          <th class="px-4 py-2 text-left font-medium text-gray-600"><%= t("accounting.reports.csv.label") %></th>
          <th class="px-4 py-2 text-left font-medium text-gray-600">Partner</th>
          <th class="px-4 py-2 text-right font-medium text-gray-600"><%= t("accounting.reports.csv.debit") %></th>
          <th class="px-4 py-2 text-right font-medium text-gray-600"><%= t("accounting.reports.csv.credit") %></th>
          <th class="px-4 py-2 text-right font-medium text-gray-600"><%= t("accounting.reports.csv.running_balance") %></th>
          <th class="px-4 py-2 text-left font-medium text-gray-600">Lettering</th>
          <% if @foreign %>
            <th class="px-4 py-2 text-right font-medium text-gray-600">Amount in currency</th>
            <th class="px-4 py-2 text-right font-medium text-gray-600">Rate (per 1 EUR)</th>
          <% end %>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100 bg-white">
        <tr class="bg-gray-50 font-semibold">
          <td class="px-4 py-2" colspan="6">Report (opening balance)</td>
          <td class="px-4 py-2 text-right"><%= number_to_currency((@query&.opening_balance || 0), unit: "€") %></td>
          <td colspan="<%= @foreign ? 3 : 1 %>"></td>
        </tr>
        <% line_tasks = feature?(:f08) ? Accounting::TaskBadges.counts(Accounting::JournalEntryLine, @rows.map(&:line_id)) : {} %>
        <% can_task = task_allowed_for?(nil) %>
        <% @rows.each do |row| %>
          <tr>
            <td class="px-4 py-2"><%= l(row.entry_date, format: :short) %></td>
            <td class="px-4 py-2 font-mono text-xs">
              <%= link_to row.reference, accounting_journal_entry_path(row.journal_entry_id), class: "text-primary-700 hover:underline" %>
            </td>
            <td class="px-4 py-2"><%= row.label %>
              <% if feature?(:f08) %>
                <% if line_tasks.fetch(row.line_id, 0).positive? %><%= link_to "#{line_tasks[row.line_id]} task#{'s' if line_tasks[row.line_id] > 1}", accounting_tasks_path(scope: 'all', target_type: 'Accounting::JournalEntryLine', target_id: row.line_id), class: "ml-1 text-xs px-1.5 rounded-full bg-blue-100 text-blue-800", title: "Open tasks about this line" %><% end %>
                <% if can_task %><%= link_to "＋", new_accounting_task_path(target_type: 'Accounting::JournalEntryLine', target_id: row.line_id), class: "ml-1 text-xs text-primary-700", title: "Add a task about this line" %><% end %>
              <% end %></td>
            <td class="px-4 py-2">
              <% if row.partner_id %>
                <%= link_to row.partner_name,
                      accounting_reports_general_ledger_path(fiscal_year_id: @fiscal_year.id, account_id: @account.id, partner_id: row.partner_id),
                      class: "text-primary-700 hover:underline" %>
              <% end %>
            </td>
            <td class="px-4 py-2 text-right"><%= row.debit.positive? ? number_to_currency(row.debit, unit: "€") : "" %></td>
            <td class="px-4 py-2 text-right"><%= row.credit.positive? ? number_to_currency(row.credit, unit: "€") : "" %></td>
            <td class="px-4 py-2 text-right font-semibold"><%= number_to_currency(row.running_balance, unit: "€") %></td>
            <td class="px-4 py-2 font-mono text-xs">
              <%= link_to row.lettering_code, accounting_lettering_path(row.lettering_id), class: "text-primary-700 hover:underline", title: "History of this lettering" if row.lettering_id %>
            </td>
            <% if @foreign %>
              <td class="px-4 py-2 text-right font-mono text-xs"><%= "#{format("%.#{Accounting::Currency.decimals_of(row.currency)}f", row.amount_currency)} #{row.currency}" if row.amount_currency && row.currency != "EUR" %></td>
              <td class="px-4 py-2 text-right font-mono text-xs"><%= row.exchange_rate.to_s("F") if row.exchange_rate && row.currency != "EUR" %></td>
            <% end %>
          </tr>
        <% end %>
        <% if @rows.empty? %>
          <tr>
            <td colspan="<%= @foreign ? 10 : 8 %>" class="px-4 py-6 text-center text-gray-400">
              <%= t("accounting.reports.no_data") %>
            </td>
          </tr>
        <% end %>
        <tr class="bg-gray-50 font-semibold border-t-2 border-gray-300">
          <td class="px-4 py-2" colspan="3">Total movements</td>
          <td></td>
          <td class="px-4 py-2 text-right"><%= number_to_currency(@rows.sum(&:debit), unit: "€") %></td>
          <td class="px-4 py-2 text-right"><%= number_to_currency(@rows.sum(&:credit), unit: "€") %></td>
          <td class="px-4 py-2 text-right">Closing balance: <%= number_to_currency(@rows.last&.running_balance || (@query&.opening_balance || 0), unit: "€") %></td>
          <td colspan="<%= @foreign ? 3 : 1 %>"></td>
        </tr>
      </tbody>
    </table>
  <% else %>
    <p class="text-gray-500"><%= t("accounting.reports.general_ledger.select_account_prompt") %></p>
  <% end %>
</div>
