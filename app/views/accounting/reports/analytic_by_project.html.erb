<div class="mx-auto max-w-7xl px-4 py-8">
  <h1 class="mb-6 text-2xl font-bold text-gray-900"><%= t("accounting.reports.analytic.title") %></h1>

  <%= form_with url: accounting_reports_analytic_by_project_path, method: :get, class: "mb-6 flex gap-4 items-end" do |f| %>
    <%= hidden_field_tag :fiscal_year_id, @fiscal_year.id %>
    <div>
      <%= f.label :project_id, t("accounting.reports.analytic.project_id"), class: "block text-sm font-medium text-gray-700" %>
      <%= f.number_field :project_id, value: @project_id, placeholder: "ex: 42",
                         class: "mt-1 form-input w-32" %>
    </div>
    <%= f.submit t("accounting.reports.filter"), class: "btn-primary" %>
  <% end %>

  <table class="min-w-full divide-y divide-gray-200 text-sm">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-4 py-2 text-left font-medium text-gray-600"><%= t("accounting.reports.analytic.project_id") %></th>
        <th class="px-4 py-2 text-right font-medium text-gray-600"><%= t("accounting.reports.analytic.charges") %></th>
        <th class="px-4 py-2 text-right font-medium text-gray-600"><%= t("accounting.reports.analytic.produits") %></th>
        <th class="px-4 py-2 text-right font-medium text-gray-600"><%= t("accounting.reports.analytic.solde") %></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100 bg-white">
      <% @rows.each do |row| %>
        <tr>
          <td class="px-4 py-2 font-semibold">
            <%= t("accounting.reports.analytic.project_prefix") %> <%= row.project_id %>
          </td>
          <td class="px-4 py-2 text-right text-red-700"><%= number_to_currency(row.charges, unit: "€") %></td>
          <td class="px-4 py-2 text-right text-emerald-700"><%= number_to_currency(row.produits, unit: "€") %></td>
          <td class="px-4 py-2 text-right font-bold <%= row.solde >= 0 ? 'text-emerald-700' : 'text-red-700' %>">
            <%= number_to_currency(row.solde, unit: "€") %>
          </td>
        </tr>
      <% end %>
      <% if @rows.empty? %>
        <tr>
          <td colspan="4" class="px-4 py-6 text-center text-gray-400">
            <%= t("accounting.reports.no_data") %>
          </td>
        </tr>
      <% end %>
    </tbody>
    <% unless @rows.empty? %>
      <tfoot class="bg-gray-50 font-bold">
        <tr>
          <td class="px-4 py-2"><%= t("accounting.reports.totals") %></td>
          <td class="px-4 py-2 text-right text-red-700"><%= number_to_currency(@rows.sum(&:charges), unit: "€") %></td>
          <td class="px-4 py-2 text-right text-emerald-700"><%= number_to_currency(@rows.sum(&:produits), unit: "€") %></td>
          <td class="px-4 py-2 text-right <%= @rows.sum(&:solde) >= 0 ? 'text-emerald-700' : 'text-red-700' %>">
            <%= number_to_currency(@rows.sum(&:solde), unit: "€") %>
          </td>
        </tr>
      </tfoot>
    <% end %>
  </table>
</div>
