<% content_for :breadcrumb do %>
  <%= render Ui::BreadcrumbsComponent.new(items: [
    { label: 'Dashboard', path: accounting_root_path },
    { label: 'Lettering' }
  ]) %>
<% end %>

<%= render Ui::PageHeaderComponent.new(title: 'Lettering') %>

<%= form_with url: new_accounting_lettering_path, method: :get, class: 'mb-6 flex items-end gap-3' do |f| %>
  <div class="relative min-w-80" data-controller="floating-label">
    <%= f.select :account_id, @accounts.map { |a| [a.full_label, a.id] }, { selected: @account&.id, include_blank: true },
          class: 'block w-full rounded-lg border border-gray-300 px-3 py-3 text-sm text-gray-900 bg-transparent focus:outline-none focus:ring-2 focus:ring-primary-500',
          data: { floating_label_target: 'input', action: 'focus->floating-label#focus blur->floating-label#blur change->floating-label#checkValue' } %>
    <%= f.label :account_id, 'Account', class: 'lf-floating-label', data: { floating_label_target: 'label' } %>
  </div>
  <%= f.submit 'Show lines', class: 'px-4 py-2 bg-gray-100 text-sm font-medium rounded-md hover:bg-gray-200 cursor-pointer' %>
<% end %>

<% if @account %>
  <%= form_with url: new_accounting_lettering_path, method: :get, class: 'mb-4 flex flex-wrap items-end gap-3 text-sm' do |f| %>
    <%= hidden_field_tag :account_id, @account.id %>
    <label>Partner <%= f.select :partner_id, @partners.map { |p| [p.name, p.id] }, { selected: params[:partner_id], include_blank: 'All' }, class: 'block rounded-md border border-gray-300 px-2 py-1' %></label>
    <label>From (EUR) <%= f.number_field :min_amount, value: params[:min_amount], step: '0.01', min: 0, class: 'block w-28 rounded-md border border-gray-300 px-2 py-1' %></label>
    <label>To (EUR) <%= f.number_field :max_amount, value: params[:max_amount], step: '0.01', min: 0, class: 'block w-28 rounded-md border border-gray-300 px-2 py-1' %></label>
    <label>Older than (days) <%= f.number_field :older_than, value: params[:older_than], min: 0, class: 'block w-24 rounded-md border border-gray-300 px-2 py-1' %></label>
    <label>State <%= f.select :state, [['All', ''], ['Open', 'open'], ['Partly settled', 'partly']], { selected: params[:state] }, class: 'block rounded-md border border-gray-300 px-2 py-1' %></label>
    <%= f.submit 'Filter', class: 'px-3 py-1 bg-gray-100 rounded-md hover:bg-gray-200 cursor-pointer' %>
  <% end %>

  <div class="mb-6">
    <div class="flex items-center justify-between mb-2">
      <h2 class="text-sm font-semibold text-gray-700">Suggestions</h2>
      <%= button_to 'Refresh suggestions', accounting_lettering_suggestions_path(account_id: @account.id), method: :post, class: 'text-sm text-primary-700 hover:underline cursor-pointer' %>
    </div>
    <% if @suggestions.any? %>
      <%# the checkboxes belong to this form by attribute: the Accept and Reject buttons are forms of their own, which cannot be nested %>
      <%= form_with url: preview_accounting_lettering_suggestions_path, method: :post, id: 'preview_suggestions' do %>
        <%= submit_tag 'Preview the ticked suggestions', class: 'px-3 py-1 bg-gray-100 text-sm rounded-md hover:bg-gray-200 cursor-pointer mb-2' %>
      <% end %>
      <div>
        <ul class="bg-white rounded-lg border border-gray-200 divide-y divide-gray-100 text-sm mb-2">
          <% @suggestions.each do |suggestion| %>
            <li class="px-4 py-2 flex items-center gap-3">
              <%= check_box_tag 'suggestion_ids[]', suggestion.id, false, id: "suggestion_ids_#{suggestion.id}", form: 'preview_suggestions' %>
              <span class="font-semibold w-10"><%= suggestion.score %></span>
              <span class="text-gray-500 w-16">rule <%= suggestion.rule %></span>
              <span class="flex-1"><%= suggestion.partner&.name %> — <%= suggestion.line_ids.map { |id| @suggestion_lines[id]&.journal_entry&.reference }.compact.join(' · ') %>
                <%= '(with a rounding entry)' if suggestion.rule == 6 %></span>
              <%= button_to 'Accept', accept_accounting_lettering_suggestion_path(suggestion), method: :post, form: { class: 'shrink-0' }, class: 'text-primary-700 hover:underline cursor-pointer' %>
              <%= button_to 'Reject', reject_accounting_lettering_suggestion_path(suggestion), method: :post, form: { class: 'shrink-0' }, class: 'text-gray-500 hover:underline cursor-pointer' %>
            </li>
          <% end %>
        </ul>
      </div>
    <% else %>
      <p class="text-sm text-gray-500">No suggestion for this account.</p>
    <% end %>
  </div>

  <% open_amounts = @lines.index_with(&:open_amount).transform_keys(&:id) %>
  <%= form_with url: accounting_letterings_path, method: :post, data: { controller: 'lettering-total', lettering_total_tolerance_value: ActsAsTenant.current_tenant.bank_rounding_tolerance.to_s, action: 'keydown@window->lettering-total#key' } do |f| %>
    <%= hidden_field_tag :account_id, @account.id %>
    <div class="bg-white rounded-lg border border-gray-200 overflow-x-auto mb-4">
      <table class="w-full text-sm">
        <thead class="bg-gray-50 border-b border-gray-200">
          <tr>
            <th class="px-4 py-3"></th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Date</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Entry</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Partner</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Label</th>
            <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Debit</th>
            <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Credit</th>
            <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Open</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @lines.each do |line| %>
            <tr>
              <td class="px-4 py-2"><%= check_box_tag 'line_ids[]', line.id, false, id: "line_ids_#{line.id}",
                    data: { debit: line.debit, credit: line.credit, partner: line.partner_id, action: 'lettering-total#update', lettering_total_target: 'box' } %></td>
              <td class="px-4 py-2"><%= l line.journal_entry.entry_date %></td>
              <td class="px-4 py-2"><%= link_to line.journal_entry.reference, accounting_journal_entry_path(line.journal_entry), class: 'text-primary-600 hover:underline' %></td>
              <td class="px-4 py-2"><%= line.partner&.name %></td>
              <td class="px-4 py-2"><%= line.label %></td>
              <td class="px-4 py-2 text-right"><%= number_with_precision(line.debit, precision: 2) if line.debit > 0 %></td>
              <td class="px-4 py-2 text-right"><%= number_with_precision(line.credit, precision: 2) if line.credit > 0 %></td>
              <td class="px-4 py-2 text-right text-gray-500"><%= number_with_precision(open_amounts.fetch(line.id, line.debit + line.credit), precision: 2) %></td>
            </tr>
          <% end %>
          <% if @lines.empty? %>
            <tr><td colspan="8" class="px-4 py-6 text-center text-gray-500">No unlettered lines on this account.</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <div class="flex items-center gap-4">
      <%= f.submit 'Letter selected lines', data: { lettering_total_target: 'submit' },
            class: 'px-4 py-2 bg-primary-600 text-white text-sm font-medium rounded-md hover:bg-primary-700 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed' %>
      <%= f.submit 'Allocate partially', formaction: accounting_line_allocations_path, data: { lettering_total_target: 'allocate' },
            class: 'px-4 py-2 bg-gray-100 text-sm font-medium rounded-md hover:bg-gray-200 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed' %>
      <% if Accounting::CreateRoundingAccounts.ready? %>
        <%= f.submit 'Letter with a rounding entry', formaction: accounting_lettering_write_offs_path, data: { lettering_total_target: 'rounding' },
              title: 'Books the small difference on the rounding account, as a draft entry',
              class: 'px-4 py-2 bg-gray-100 text-sm font-medium rounded-md hover:bg-gray-200 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed' %>
      <% end %>
      <span class="text-sm text-gray-600">Difference: <strong data-lettering-total-target="difference">0.00</strong></span>
    </div>
    <% if policy(Accounting::Lettering).cross_partner? %>
      <div class="mt-3 flex items-center gap-3 text-sm text-gray-700">
        <label class="flex items-center gap-1"><%= check_box_tag :cross_partner, '1', false %> Letter lines of different partners (correction)</label>
        <%= text_field_tag :reason, nil, placeholder: 'Reason (required for a correction)', class: 'border rounded px-2 py-1 text-sm w-72' %>
      </div>
    <% end %>
    <p class="mt-3 text-xs text-gray-400">Keys: j / k move, x ticks the line, n next partner, l letters.</p>
  <% end %>

  <% if @allocations.any? %>
    <h2 class="text-sm font-semibold text-gray-700 mt-8 mb-2">Partly settled</h2>
    <ul class="bg-white rounded-lg border border-gray-200 divide-y divide-gray-100 text-sm">
      <% @allocations.each do |allocation| %>
        <li class="px-4 py-2 flex items-center justify-between">
          <span>
            <%= allocation.credit_line.partner&.name || 'no partner' %> —
            <%= allocation.debit_line.journal_entry.reference %> / <%= allocation.credit_line.journal_entry.reference %> —
            <strong><%= number_with_precision(allocation.amount, precision: 2) %></strong>
          </span>
          <%= button_to 'Remove', accounting_line_allocation_path(allocation), method: :delete, class: 'text-red-600 hover:underline' %>
        </li>
      <% end %>
    </ul>
  <% end %>

  <% if @letterings.any? %>
    <h2 class="text-sm font-semibold text-gray-700 mt-8 mb-2">Recent letterings</h2>
    <ul class="bg-white rounded-lg border border-gray-200 divide-y divide-gray-100 text-sm">
      <% @letterings.each do |lettering| %>
        <li class="px-4 py-2 flex items-center justify-between">
          <span><strong><%= lettering.code %></strong> — <%= lettering.partner&.name || 'no partner' %> — <%= l lettering.lettered_on %></span>
          <%= form_with url: accounting_lettering_path(lettering), method: :delete, class: 'flex gap-2 items-center' do %>
            <%= text_field_tag :reason, nil, placeholder: 'Reason (required)', required: true, class: 'border rounded px-2 py-1 text-sm' %>
            <%= submit_tag 'Remove', class: 'text-red-600 hover:underline' %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
<% end %>
