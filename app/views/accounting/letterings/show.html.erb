<% content_for :breadcrumb do %>
  <%= render Ui::BreadcrumbsComponent.new(items: [
    { label: 'Dashboard', path: accounting_root_path },
    { label: 'Lettering', path: new_accounting_lettering_path(account_id: @lettering.account_id) },
    { label: @lettering.code }
  ]) %>
<% end %>

<%= render Ui::PageHeaderComponent.new(title: "Lettering #{@lettering.code}") %>

<p class="text-sm text-gray-600 mb-4">
  <%= @lettering.account.full_label %> — <%= @lettering.partner&.name || 'several partners' %> — <%= l @lettering.lettered_on %> —
  <%= @lettering.kind.humanize %><%= ', automatic' if @lettering.auto %><%= " — by #{@lettering.lettered_by.email}" if @lettering.lettered_by %>
  <%= " — reason: #{@lettering.reason}" if @lettering.reason.present? %>
</p>

<h2 class="text-sm font-semibold text-gray-700 mb-2">Lines</h2>
<ul class="bg-white rounded-lg border border-gray-200 divide-y divide-gray-100 text-sm mb-6">
  <% @lines.each do |line| %>
    <li class="px-4 py-2 flex justify-between">
      <span><%= link_to line.journal_entry.reference, accounting_journal_entry_path(line.journal_entry), class: 'text-primary-600 hover:underline' %> — <%= line.partner&.name %> <%= line.label %></span>
      <span><%= number_with_precision(line.debit.positive? ? line.debit : -line.credit, precision: 2) %></span>
    </li>
  <% end %>
</ul>

<h2 class="text-sm font-semibold text-gray-700 mb-2">History of these lines</h2>
<table class="w-full text-sm bg-white rounded-lg border border-gray-200">
  <tbody class="divide-y divide-gray-100">
    <% @events.each do |event| %>
      <tr>
        <td class="px-4 py-2"><%= l event.created_at, format: :short %></td>
        <td class="px-4 py-2"><%= event.action %> <span class="font-mono"><%= event.code %></span></td>
        <td class="px-4 py-2"><%= event.user&.email || 'system' %><%= ' (automatic)' if event.auto %></td>
        <td class="px-4 py-2 text-gray-500"><%= event.reason %></td>
      </tr>
    <% end %>
  </tbody>
</table>
