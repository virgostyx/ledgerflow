<% content_for :breadcrumb do %>
  <%= render Ui::BreadcrumbsComponent.new(items: [
    { label: 'Dashboard', path: accounting_root_path },
    { label: 'Payment Batches' }
  ]) %>
<% end %>

<%= render Ui::PageHeaderComponent.new(title: 'Payment Batches') do |header| %>
  <% if policy(Accounting::PaymentBatch).create? %>
    <% header.with_actions do %>
      <%= link_to 'New Payment Batch', new_accounting_payment_batch_path,
            class: 'inline-flex items-center px-4 py-2 bg-primary-600 text-white text-sm font-medium rounded-md hover:bg-primary-700 transition-colors' %>
    <% end %>
  <% end %>
<% end %>

<% if @payment_batches.empty? %>
  <%= render Ui::EmptyStateComponent.new(
        title: 'No payment batches yet',
        description: 'Group posted supplier invoices into a SEPA payment batch.',
        icon: :clipboard
      ) do |state| %>
    <% if policy(Accounting::PaymentBatch).create? %>
      <% state.with_actions do %>
        <%= link_to 'New Payment Batch', new_accounting_payment_batch_path,
              class: 'inline-flex items-center px-4 py-2 bg-primary-600 text-white text-sm font-medium rounded-md hover:bg-primary-700 transition-colors' %>
      <% end %>
    <% end %>
  <% end %>
<% else %>
  <div class="bg-white rounded-lg border border-gray-200 overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 border-b border-gray-200">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Bank account</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Execution date</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Invoices</th>
          <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Total</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @payment_batches.each do |batch| %>
          <% presenter = Accounting::PaymentBatchPresenter.new(batch) %>
          <tr class="hover:bg-gray-50 transition-colors">
            <td class="px-4 py-3 text-gray-700 font-medium"><%= batch.bank_account.label_fr %></td>
            <td class="px-4 py-3 text-gray-500"><%= presenter.formatted_requested_execution_date %></td>
            <td class="px-4 py-3 text-gray-500"><%= presenter.line_count %></td>
            <td class="px-4 py-3 text-right font-mono text-gray-900"><%= presenter.formatted_total %></td>
            <td class="px-4 py-3"><%= render Accounting::StatusBadgeComponent.new(status: batch.status.to_sym) %></td>
            <td class="px-4 py-3 text-right">
              <%= link_to 'View', accounting_payment_batch_path(batch),
                    class: 'text-primary-600 hover:text-primary-800 text-sm font-medium' %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
