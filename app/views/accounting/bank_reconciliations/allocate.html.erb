<% content_for :breadcrumb do %>
  <%= render Ui::BreadcrumbsComponent.new(items: [
    { label: 'Dashboard', path: accounting_root_path },
    { label: 'Bank Reconciliation', path: accounting_bank_reconciliation_path },
    { label: 'Allocate to invoices' }
  ]) %>
<% end %>

<%= render Ui::PageHeaderComponent.new(title: 'Allocate to invoices') %>

<div class="bg-white rounded-lg border border-gray-200 p-5 mb-6 text-sm">
  <div class="flex flex-wrap gap-x-8 gap-y-1">
    <span><span class="text-gray-500">Date:</span> <%= Accounting::DatePresenter.new(@transaction.transaction_date).format %></span>
    <span><span class="text-gray-500">Description:</span> <%= @transaction.description %></span>
    <span><span class="text-gray-500">Amount to allocate:</span>
      <span class="font-mono font-semibold text-emerald-700"><%= Accounting::MoneyPresenter.new(@transaction.amount).format %></span></span>
  </div>
  <p class="mt-2 text-xs text-gray-500">
    Enter an amount next to each invoice this transfer pays (one client only). The amounts must add up to the transfer;
    an amount above an invoice's balance leaves a credit on the client's account.
  </p>
</div>

<%= form_with url: accounting_bank_reconciliation_path, method: :patch do %>
  <%= hidden_field_tag 'bank_reconciliation[bank_transaction_id]', @transaction.id %>
  <div class="bg-white rounded-lg border border-gray-200 overflow-hidden">
    <% if @invoices.any? %>
      <table class="w-full text-sm">
        <thead class="bg-gray-50 border-b border-gray-200">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Client</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Invoice</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Due</th>
            <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Balance</th>
            <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Allocate</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @invoices.each do |invoice| %>
            <tr class="hover:bg-gray-50">
              <td class="px-4 py-3 text-gray-700"><%= invoice.partner.name %></td>
              <td class="px-4 py-3"><%= link_to invoice.invoice_number, accounting_invoice_path(invoice), class: 'text-primary-600 hover:underline' %></td>
              <td class="px-4 py-3 text-gray-500"><%= Accounting::DatePresenter.new(invoice.due_date).format if invoice.due_date %></td>
              <td class="px-4 py-3 text-right font-mono"><%= Accounting::MoneyPresenter.new(invoice.remaining_amount).format %></td>
              <td class="px-4 py-3 text-right">
                <%= text_field_tag "bank_reconciliation[allocations][#{invoice.id}]", nil, inputmode: 'decimal', autocomplete: 'off',
                      class: 'w-28 text-right font-mono rounded-md border-gray-300 text-sm focus:ring-primary-500 focus:border-primary-500' %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="px-4 py-8 text-center text-sm text-gray-500">No open customer invoices.</div>
    <% end %>
  </div>

  <div class="mt-4 flex gap-3">
    <%= submit_tag 'Book allocation',
          class: 'px-4 py-2 bg-primary-600 text-white text-sm font-medium rounded-md hover:bg-primary-700 transition-colors' %>
    <%= link_to 'Cancel', accounting_bank_reconciliation_path, class: 'px-4 py-2 text-sm text-gray-600 hover:underline' %>
  </div>
<% end %>
