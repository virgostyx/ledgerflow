<% content_for :breadcrumb do %>
  <%= render Ui::BreadcrumbsComponent.new(items: [
    { label: 'Dashboard', path: accounting_root_path },
    { label: 'Bank Reconciliation' }
  ]) %>
<% end %>

<%= render Ui::PageHeaderComponent.new(title: 'Bank Reconciliation') %>

<%# Import CAMT.053 %>
<div class="bg-white rounded-lg border border-gray-200 p-5 mb-6">
  <h2 class="text-sm font-semibold text-gray-700 mb-3">Import a statement (CAMT.053)</h2>
  <%= form_with url: accounting_bank_reconciliation_path, method: :patch,
                multipart: true, class: 'flex flex-wrap gap-3 items-end' do |f| %>
    <div>
      <%= label_tag :bank_account_id, 'Bank account', class: 'block text-xs font-medium text-gray-500 mb-1' %>
      <%= select_tag 'bank_reconciliation[bank_account_id]',
            options_from_collection_for_select(@bank_accounts, :id, :label_fr),
            class: 'rounded-md border-gray-300 text-sm focus:ring-primary-500 focus:border-primary-500' %>
    </div>
    <div>
      <%= label_tag :camt_file, 'Statement (CAMT.053 or CSV)', class: 'block text-xs font-medium text-gray-500 mb-1' %>
      <%= file_field_tag 'bank_reconciliation[camt_file]',
            accept: '.xml,application/xml,.csv,text/csv',
            class: 'text-sm text-gray-500' %>
    </div>
    <%= submit_tag 'Import',
          class: 'px-4 py-2 bg-primary-600 text-white text-sm font-medium rounded-md hover:bg-primary-700 transition-colors' %>
  <% end %>

  <details class="mt-4">
    <summary class="text-sm font-medium text-primary-600 cursor-pointer">Record a movement manually</summary>
    <%= form_with url: accounting_bank_reconciliation_path, method: :patch, scope: :bank_reconciliation,
                  class: 'flex flex-wrap gap-3 items-end mt-3' do |f| %>
      <%= hidden_field_tag 'bank_reconciliation[manual]', '1' %>
      <%= select_tag 'bank_reconciliation[bank_account_id]',
            options_for_select(@bank_accounts.map { |a| ["#{a.label_fr} (#{a.currency})", a.id] }),
            class: 'rounded-md border-gray-300 text-sm' %>
      <%= date_field_tag 'bank_reconciliation[transaction_date]', Date.current, required: true, title: 'Booking date', class: 'rounded-md border-gray-300 text-sm' %>
      <%= date_field_tag 'bank_reconciliation[value_date]', nil, title: 'Value date', class: 'rounded-md border-gray-300 text-sm' %>
      <%= text_field_tag 'bank_reconciliation[amount]', nil, required: true, placeholder: 'Amount (− = outgoing)', class: 'rounded-md border-gray-300 text-sm' %>
      <%= text_field_tag 'bank_reconciliation[reference]', nil, placeholder: 'Reference', class: 'rounded-md border-gray-300 text-sm' %>
      <%= text_field_tag 'bank_reconciliation[description]', nil, placeholder: 'Description', class: 'rounded-md border-gray-300 text-sm' %>
      <%= submit_tag 'Record', class: 'px-4 py-2 bg-primary-600 text-white text-sm font-medium rounded-md hover:bg-primary-700 transition-colors' %>
    <% end %>
  </details>
</div>

<%= render 'shared/filters', fields: [
  { name: :q, label: 'Search', type: :text },
  { name: :direction, label: 'Direction', type: :select, options: [['Credit (incoming)', 'credit'], ['Debit (outgoing)', 'debit']] },
  { name: :from, label: 'From', type: :date },
  { name: :to, label: 'To', type: :date }
] %>

<%# Pending transactions %>
<div class="bg-white rounded-lg border border-gray-200 overflow-hidden">
  <div class="px-4 py-3 border-b border-gray-200 flex items-center justify-between">
    <h2 class="text-sm font-semibold text-gray-700">
      Pending transactions
      <span class="ml-1.5 inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600">
        <%= @pagy.count %>
      </span>
    </h2>
  </div>

  <% if @pending_transactions.any? || filters_active? %>
    <table class="w-full text-sm">
      <thead class="bg-gray-50 border-b border-gray-200">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Description</th>
          <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Amount</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Counterpart</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @pending_transactions.each do |tx| %>
          <tr class="hover:bg-gray-50 transition-colors">
            <td class="px-4 py-3 text-gray-500">
              <%= Accounting::DatePresenter.new(tx.transaction_date).format %>
            </td>
            <td class="px-4 py-3 text-gray-700">
              <%= tx.description %>
              <% if (suggestion = @suggestions[tx]) %>
                <div class="mt-1 flex items-center gap-2 text-xs text-emerald-700">
                  <span>Suggested: <%= case suggestion.kind
                        when :invoice  then "invoice #{suggestion.target.invoice_number}"
                        when :expense  then "bank fees (#{suggestion.target.code})"
                        when :invoices then "invoices #{suggestion.target.map(&:invoice_number).join(', ')}"
                        else "payment batch #{suggestion.target.message_id}#{' — will be marked as executed' if suggestion.target.generated?}"
                        end %> (<%= suggestion.confidence %> confidence<%= ", overpaid by #{Accounting::MoneyPresenter.new(suggestion.excess).format}" if suggestion.excess&.positive? %>)</span>
                  <%= button_to 'Accept', accounting_bank_reconciliation_path, method: :patch,
                        params: { 'bank_reconciliation[bank_transaction_id]' => tx.id, 'bank_reconciliation[accept_suggestion]' => 1 },
                        class: 'px-2 py-1 bg-primary-600 text-white rounded-md hover:bg-primary-700' %>
                </div>
              <% end %>
            </td>
            <td class="px-4 py-3 text-right font-mono <%= tx.credit? ? 'text-emerald-700' : 'text-red-700' %>">
              <%= Accounting::MoneyPresenter.new(tx.amount).format %>
            </td>
            <td class="px-4 py-3">
              <% manual_form = capture do %>
                <%= form_with url: accounting_bank_reconciliation_path, method: :patch,
                              class: 'flex gap-2 items-center' do |f| %>
                  <%= hidden_field_tag 'bank_reconciliation[bank_transaction_id]', tx.id %>
                  <%= select_tag 'bank_reconciliation[account_id]',
                        options_from_collection_for_select(@accounts, :id,
                          ->(a) { "#{a.code} — #{a.label_fr}" }),
                        prompt: 'Select an account',
                        class: 'rounded-md border-gray-300 text-xs focus:ring-primary-500 focus:border-primary-500' %>
                  <% unless tx.bank_account.currency == 'EUR' %>
                    <%= text_field_tag 'bank_reconciliation[eur_amount]', nil, required: true, placeholder: "EUR amount (#{tx.currency} movement)", class: 'rounded-md border-gray-300 text-xs w-40' %>
                  <% end %>
                  <%= submit_tag 'Reconcile',
                        class: 'px-3 py-1.5 bg-emerald-600 text-white text-xs font-medium rounded-md hover:bg-emerald-700 transition-colors' %>
                <% end %>
              <% end %>
              <% if @suggestions[tx] %>
                <details>
                  <summary class="text-xs text-gray-500 cursor-pointer">Reconcile manually</summary>
                  <div class="mt-2"><%= manual_form %></div>
                </details>
              <% else %>
                <%= manual_form %>
              <% end %>
              <% if tx.debit? && @payable_invoices.any? %>
                <details class="mt-2">
                  <summary class="text-xs text-primary-600 cursor-pointer">Pay a supplier invoice</summary>
                  <%= form_with url: accounting_bank_reconciliation_path, method: :patch, class: 'mt-2 flex gap-2 items-center' do %>
                    <%= hidden_field_tag 'bank_reconciliation[bank_transaction_id]', tx.id %>
                    <%= select_tag 'bank_reconciliation[pay_invoice_id]',
                          options_for_select(@payable_invoices.map { |i| ["#{i.invoice_number} — #{i.partner.name} (#{i.total_incl_vat} #{i.currency})", i.id] }),
                          class: 'rounded-md border-gray-300 text-xs' %>
                    <% unless tx.bank_account.currency == 'EUR' %>
                      <%= text_field_tag 'bank_reconciliation[eur_amount]', nil, required: true, placeholder: 'EUR amount debited', class: 'rounded-md border-gray-300 text-xs w-36' %>
                    <% end %>
                    <%= text_field_tag 'bank_reconciliation[invoice_amount]', nil, placeholder: 'Deposit: amount for this invoice (optional)', class: 'rounded-md border-gray-300 text-xs w-56' %>
                    <%= submit_tag 'Pay', class: 'px-3 py-1.5 bg-emerald-600 text-white text-xs font-medium rounded-md hover:bg-emerald-700' %>
                  <% end %>
                </details>
              <% end %>
              <% if tx.credit? %>
                <%= link_to 'Allocate to invoices', allocate_accounting_bank_reconciliation_path(bank_transaction_id: tx.id),
                      class: 'block mt-2 text-xs text-primary-600 hover:underline' %>
              <% end %>
              <%= button_to 'Ignore', accounting_bank_reconciliation_path, method: :patch,
                    params: { 'bank_reconciliation[bank_transaction_id]' => tx.id, 'bank_reconciliation[ignore]' => 1 },
                    data: { turbo_confirm: 'Ignore this transaction? It will be removed from the list without any accounting entry.' },
                    class: 'mt-1 text-xs text-gray-500 underline hover:text-gray-700' %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <div class="px-4 pb-4"><%= render 'shared/pagination', pagy: @pagy %></div>
  <% else %>
    <div class="px-4 py-8 text-center">
      <p class="text-sm text-gray-500">No pending transactions. Import a CAMT.053 file to begin.</p>
    </div>
  <% end %>
</div>
