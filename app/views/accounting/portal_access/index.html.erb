<div class="mx-auto max-w-6xl px-4 py-8">
  <h1 class="mb-1 text-2xl font-bold text-gray-900">Client portal</h1>
  <p class="mb-6 max-w-3xl text-sm text-gray-600">People from outside who may sign in to the portal of this company. They see only what you publish to them; a right exists only if it is listed here. Everyone signs in with a second factor; if they lose it, you reset their access and they are invited again.</p>

  <p class="mb-4 text-xs <%= Portal.restricted_database? ? 'text-gray-500' : 'text-amber-700' %>">
    Database connection of the portal: <%= Portal.restricted_database? ? "a role limited to the portal's tables" : "the application's own (not restricted: ask your administrator to set PORTAL_DATABASE_URL)" %>.
  </p>

  <table class="mb-8 w-full text-sm">
    <thead><tr class="border-b text-left text-gray-500"><th class="py-2">Person</th><th>Role</th><th>Rights</th><th>Last access</th><th>Identity</th><th></th></tr></thead>
    <tbody>
      <% @grants.each do |grant| %>
        <% person = grant.portal_user %>
        <tr class="border-b align-top">
          <td class="py-2"><%= person.full_name %><br><span class="text-gray-500"><%= person.email %></span> <span class="text-xs text-gray-400"><%= person.status %><%= " (revoked)" if grant.revoked_at %></span></td>
          <td><%= grant.role %></td>
          <td class="text-xs text-gray-600"><%= grant.capabilities.join(", ").presence || "none" %></td>
          <td><%= person.last_seen_at ? l(person.last_seen_at.in_time_zone, format: :short) : "never" %>
            <% if @review[grant.id]&.inactive %><br><span class="text-xs font-medium text-amber-700">not used for 90 days</span><% end %></td>
          <td><%= person.identity_verified_at ? "verified #{l(person.identity_verified_at.in_time_zone, format: :short)}" : "not verified" %></td>
          <td class="flex gap-3">
            <% if grant.revoked_at.nil? %>
              <% if person.suspended? %><%= button_to "Reinstate", reinstate_accounting_portal_access_path(grant), class: "underline cursor-pointer" %><% end %>
              <%= button_to "Verify identity", verify_identity_accounting_portal_access_path(grant), class: "underline cursor-pointer" %>
              <%= button_to "Reset access", reset_accounting_portal_access_path(grant), class: "underline cursor-pointer", form: { data: { turbo_confirm: "Wipe the password and the second factor of this person, and invite them again?" } } %>
              <%= button_to "Revoke", accounting_portal_access_path(grant), method: :delete, class: "text-red-700 underline cursor-pointer", form: { data: { turbo_confirm: "Revoke this access now?" } } %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <% if @requests.any? %>
    <h2 class="mb-2 font-semibold">Access requested by clients</h2>
    <ul class="mb-8 space-y-2 text-sm">
      <% @requests.each do |ask| %>
        <li class="flex flex-wrap items-center gap-3 rounded border bg-white p-2">
          <span><strong><%= ask.full_name %></strong> (<%= ask.email %>) as <%= ask.role %>, asked by <%= ask.requested_by.full_name %><%= " - #{ask.note}" if ask.note.present? %></span>
          <%= button_to "Grant and invite", grant_accounting_portal_access_request_path(ask.token), class: "underline cursor-pointer" %>
          <%= button_to "Decline", decline_accounting_portal_access_request_path(ask.token), class: "text-red-700 underline cursor-pointer" %>
        </li>
      <% end %>
    </ul>
  <% end %>

  <% if @pending.any? %>
    <h2 class="mb-2 font-semibold">Invitations waiting</h2>
    <ul class="mb-8 text-sm text-gray-700"><% @pending.each do |invitation| %><li><%= invitation.email %> - <%= invitation.role %> - expires <%= l(invitation.expires_at.in_time_zone, format: :short) %></li><% end %></ul>
  <% end %>

  <p class="mb-6 flex gap-4 text-sm"><%= link_to "Publications", accounting_portal_publications_path, class: "underline" %><%= link_to "Portal activity", accounting_portal_activity_index_path, class: "underline" %><%= link_to "Documents asked of the client", accounting_portal_document_requests_path, class: "underline" if feature?(:b02b) %></p>

  <h2 class="mb-2 font-semibold">Invite someone</h2>
  <%= form_with url: accounting_portal_access_index_path, class: "flex flex-wrap items-end gap-3 text-sm" do |f| %>
    <div><%= f.label :full_name, "Name", class: "block" %><%= f.text_field :full_name, required: true, class: "rounded border p-2" %></div>
    <div><%= f.label :email, "Email", class: "block" %><%= f.email_field :email, required: true, class: "rounded border p-2" %></div>
    <div><%= f.label :role, "Role", class: "block" %><%= f.select :role, Portal::ROLES, {}, class: "rounded border p-2" %></div>
    <%= f.submit "Invite", class: "rounded bg-gray-900 px-4 py-2 text-white" %>
  <% end %>

  <h2 class="mb-2 mt-8 font-semibold">Look of the portal</h2>
  <p class="mb-2 text-xs text-gray-500">Colours are refused when text cannot be read on them (WCAG AA). The logo is a PNG or JPEG of 200 KB at most.</p>
  <%= form_with url: accounting_portal_branding_path, method: :patch, multipart: true, class: "flex flex-wrap items-end gap-3 text-sm" do |f| %>
    <div><%= f.label :display_name, "Name shown", class: "block" %><%= f.text_field :display_name, value: @brand&.display_name || ActsAsTenant.current_tenant.name, required: true, class: "rounded border p-2" %></div>
    <div><%= f.label :sender_name, "Signs the e-mails", class: "block" %><%= f.text_field :sender_name, value: @brand&.sender_name, class: "rounded border p-2" %></div>
    <div><%= f.label :primary_color, "Buttons", class: "block" %><%= f.color_field :primary_color, value: @brand&.primary_color || "#1f2937" %></div>
    <div><%= f.label :background_color, "Background", class: "block" %><%= f.color_field :background_color, value: @brand&.background_color || "#f9fafb" %></div>
    <div><%= f.label :logo, "Logo", class: "block" %><%= f.file_field :logo, accept: "image/png,image/jpeg" %></div>
    <%= f.submit "Save", class: "rounded border px-4 py-2" %>
  <% end %>
</div>
