<% content_for :breadcrumb do %>
  <%= render Ui::BreadcrumbsComponent.new(items: [
    { label: 'Dashboard', path: accounting_root_path },
    { label: 'VAT Declarations', path: accounting_vat_declarations_path },
    { label: "#{Accounting::DatePresenter.new(@declaration.period_start).format} — #{Accounting::DatePresenter.new(@declaration.period_end).format}" }
  ]) %>
<% end %>

<%= render Ui::PageHeaderComponent.new(
      title: 'VAT Declaration',
      description: "#{Accounting::DatePresenter.new(@declaration.period_start).format} — #{Accounting::DatePresenter.new(@declaration.period_end).format}",
      back_path: accounting_vat_declarations_path,
      back_text: 'VAT Declarations'
    ) %>

<div class="bg-white rounded-lg border border-gray-200 p-6 max-w-2xl">
  <dl class="grid grid-cols-3 gap-4 mb-6">
    <div>
      <dt class="text-xs font-medium text-gray-500 uppercase tracking-wider">Type</dt>
      <dd class="mt-1 text-sm text-gray-900 capitalize"><%= @declaration.period_type %></dd>
    </div>
    <div>
      <dt class="text-xs font-medium text-gray-500 uppercase tracking-wider">Status</dt>
      <dd class="mt-1 text-sm text-gray-900"><%= @declaration.status %></dd>
    </div>
  </dl>

  <% if @declaration.grids.any? %>
    <h2 class="text-sm font-semibold text-gray-700 mb-3">VAT Boxes</h2>
    <table class="w-full text-sm border-collapse">
      <thead>
        <tr class="bg-gray-50 border-b border-gray-200">
          <th class="px-3 py-2 text-left text-xs font-medium text-gray-500">Box code</th>
          <th class="px-3 py-2 text-right text-xs font-medium text-gray-500">Amount (€)</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @declaration.grids.sort.each do |code, amount| %>
          <tr>
            <td class="px-3 py-2 font-mono text-gray-700"><%= code %></td>
            <td class="px-3 py-2 text-right font-mono text-gray-900">
              <%= Accounting::MoneyPresenter.new(BigDecimal(amount)).format %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <%= render Ui::EmptyStateComponent.new(title: 'No VAT boxes for this period.', icon: :inbox) %>
  <% end %>
</div>
