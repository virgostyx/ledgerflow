<h1 class="text-lg font-semibold text-indigo-700 mb-4">VAT Declarations</h1>

<% if policy(Accounting::VatDeclaration).create? %>
  <%= link_to 'New declaration', new_accounting_vat_declaration_path,
        class: 'inline-flex items-center px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-md hover:bg-indigo-700 mb-4' %>
<% end %>

<table class="w-full text-sm">
  <thead class="bg-gray-50 border-b border-gray-200">
    <tr>
      <th class="px-4 py-3 text-left text-xs font-medium text-gray-500">Period</th>
      <th class="px-4 py-3 text-left text-xs font-medium text-gray-500">Type</th>
      <th class="px-4 py-3 text-left text-xs font-medium text-gray-500">Status</th>
      <th class="px-4 py-3"></th>
    </tr>
  </thead>
  <tbody class="divide-y divide-gray-100">
    <% @declarations.each do |decl| %>
      <tr class="hover:bg-gray-50">
        <td class="px-4 py-3 text-gray-700">
          <%= Accounting::DatePresenter.new(decl.period_start).format %> —
          <%= Accounting::DatePresenter.new(decl.period_end).format %>
        </td>
        <td class="px-4 py-3 text-gray-500"><%= decl.period_type %></td>
        <td class="px-4 py-3"><%= decl.status %></td>
        <td class="px-4 py-3">
          <%= link_to 'View', accounting_vat_declaration_path(decl),
                class: 'text-indigo-600 hover:underline text-sm' %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
