<h1 class="text-lg font-semibold text-indigo-700 mb-4">Nouvelle déclaration TVA</h1>

<%= form_with model: @declaration, scope: :accounting_vat_declaration,
              url: accounting_vat_declarations_path,
              class: 'max-w-lg' do |f| %>

  <div class="mb-4">
    <%= f.label :fiscal_year_id, 'Exercice fiscal', class: 'block text-sm font-medium text-gray-700 mb-1' %>
    <%= f.collection_select :fiscal_year_id, @fiscal_years, :id,
          ->(fy) { "#{fy.start_date.year}" },
          { include_blank: false },
          { class: 'block w-full rounded-md border-gray-300 text-sm' } %>
  </div>

  <div class="mb-4">
    <%= f.label :period_type, 'Type de période', class: 'block text-sm font-medium text-gray-700 mb-1' %>
    <%= f.select :period_type,
          [['Mensuelle', 'monthly'], ['Trimestrielle', 'quarterly']],
          { include_blank: false },
          { class: 'block w-full rounded-md border-gray-300 text-sm' } %>
  </div>

  <div class="mb-4">
    <%= f.label :period_start, 'Début de période', class: 'block text-sm font-medium text-gray-700 mb-1' %>
    <%= f.date_field :period_start, class: 'block w-full rounded-md border-gray-300 text-sm' %>
  </div>

  <div class="mb-6">
    <%= f.label :period_end, 'Fin de période', class: 'block text-sm font-medium text-gray-700 mb-1' %>
    <%= f.date_field :period_end, class: 'block w-full rounded-md border-gray-300 text-sm' %>
  </div>

  <div class="flex gap-3">
    <%= f.submit 'Générer la déclaration',
          class: 'px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-md hover:bg-indigo-700' %>
    <%= link_to 'Annuler', accounting_vat_declarations_path,
          class: 'px-4 py-2 text-sm text-gray-600 hover:text-gray-800' %>
  </div>

<% end %>
