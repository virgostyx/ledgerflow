<% content_for :breadcrumb do %>
  <%= render Ui::BreadcrumbsComponent.new(items: [{ label: 'Dashboard' }]) %>
<% end %>

<%= render Ui::PageHeaderComponent.new(title: 'Dashboard') %>

<%= render ::Layouts::DashboardKpiComponent.new(kpis: @kpis) %>

<% if @indicators.any? %>
  <h2 class="mt-8 mb-3 text-sm font-semibold text-gray-700">Key indicators</h2>
  <% sources = { trial_balance: accounting_reports_trial_balance_path, income_statement: accounting_reports_income_statement_path,
                 balance_sheet: accounting_reports_balance_sheet_path, aged_balance: accounting_reports_aged_balance_path } %>
  <div class="grid grid-cols-2 gap-4 lg:grid-cols-5" id="key-indicators">
    <% @indicators.each do |c| %>
      <% tone = { danger: "text-red-700", warning: "text-amber-600", ok: "text-emerald-700" }.fetch(c.status, "text-gray-900") %>
      <div class="rounded-lg border border-gray-200 bg-white p-4" title="<%= c.formula %>" data-kpi="<%= c.key %>">
        <div class="text-xs font-medium uppercase tracking-wider text-gray-500"><%= c.label %></div>
        <% if c.error %>
          <div class="mt-2 text-sm text-red-700"><%= c.error %></div>
        <% else %>
          <div class="mt-2 text-xl font-semibold <%= tone %>">
            <%= if c.value.nil? then "—"
                elsif c.unit == :money then number_to_currency(c.value, unit: "€")
                elsif c.unit == :percent then "#{c.value.round(1)} %"
                else c.value.round(1) end %>
          </div>
        <% end %>
        <%= link_to "Source report", sources.fetch(c.source), class: "mt-2 inline-block text-xs text-primary-600 hover:underline" %>
      </div>
    <% end %>
  </div>
<% end %>

<div class="mt-8 grid grid-cols-2 gap-4">
  <div class="bg-white rounded-lg border border-gray-200 p-5">
    <h2 class="text-sm font-semibold text-gray-700 mb-3">Quick links</h2>
    <ul class="space-y-2 text-sm">
      <li><%= link_to "Journal entries", accounting_journal_entries_path, class: "text-primary-600 hover:underline" %></li>
      <li><%= link_to "Sales", accounting_sales_path, class: "text-primary-600 hover:underline" %></li>
      <li><%= link_to "Purchases", accounting_purchases_path, class: "text-primary-600 hover:underline" %></li>
      <li><%= link_to "Partners", accounting_partners_path, class: "text-primary-600 hover:underline" %></li>
      <li><%= link_to "Bank reconciliation", accounting_bank_reconciliation_path, class: "text-primary-600 hover:underline" %></li>
    </ul>
  </div>

  <div class="bg-white rounded-lg border border-gray-200 p-5">
    <h2 class="text-sm font-semibold text-gray-700 mb-3">Reports</h2>
    <ul class="space-y-2 text-sm">
      <li><%= link_to "Trial balance", accounting_reports_trial_balance_path, class: "text-primary-600 hover:underline" %></li>
      <li><%= link_to "Balance sheet", accounting_reports_balance_sheet_path, class: "text-primary-600 hover:underline" %></li>
      <li><%= link_to "Income statement", accounting_reports_income_statement_path, class: "text-primary-600 hover:underline" %></li>
    </ul>
  </div>
</div>
