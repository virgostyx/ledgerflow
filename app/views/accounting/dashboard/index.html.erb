<% content_for :breadcrumb do %>
  <%= render Ui::BreadcrumbsComponent.new(items: [{ label: 'Dashboard' }]) %>
<% end %>

<%= render Ui::PageHeaderComponent.new(title: 'Dashboard') %>

<%= render ::Layouts::DashboardKpiComponent.new(kpis: @kpis) %>

<div class="mt-8 grid grid-cols-2 gap-4">
  <div class="bg-white rounded-lg border border-gray-200 p-5">
    <h2 class="text-sm font-semibold text-gray-700 mb-3">Quick links</h2>
    <ul class="space-y-2 text-sm">
      <li><%= link_to "Journal entries", accounting_journal_entries_path, class: "text-primary-600 hover:underline" %></li>
      <li><%= link_to "Invoices", accounting_invoices_path, class: "text-primary-600 hover:underline" %></li>
      <li><%= link_to "Partners", accounting_partners_path, class: "text-primary-600 hover:underline" %></li>
      <li><%= link_to "Bank reconciliation", accounting_bank_reconciliation_path, class: "text-primary-600 hover:underline" %></li>
    </ul>
  </div>

  <div class="bg-white rounded-lg border border-gray-200 p-5">
    <h2 class="text-sm font-semibold text-gray-700 mb-3">Reports</h2>
    <ul class="space-y-2 text-sm">
      <li><%= link_to "Trial balance", accounting_reports_trial_balance_path, class: "text-primary-600 hover:underline" %></li>
      <li><%= link_to "Balance sheet", accounting_reports_balance_sheet_path, class: "text-primary-600 hover:underline" %></li>
      <li><%= link_to "Income statement", accounting_reports_income_statement_path, class: "text-primary-600 hover:underline" %></li>
    </ul>
  </div>
</div>
