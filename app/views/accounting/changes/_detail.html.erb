<% if result.by_month %>
  <table class="mb-6 min-w-full divide-y divide-gray-200 text-sm">
    <thead class="bg-gray-50"><tr>
      <th class="px-4 py-2 text-left font-medium text-gray-600"><%= t("changes.month") %></th>
      <th class="px-4 py-2 text-right font-medium text-gray-600"><%= t("changes.summary.entries") %></th>
      <th class="px-4 py-2 text-right font-medium text-gray-600"><%= t("changes.detail.amount") %></th>
    </tr></thead>
    <tbody class="divide-y divide-gray-100 bg-white">
      <% result.by_month.each do |row| %>
        <tr><td class="px-4 py-2"><%= l(row[:month], format: "%Y-%m") %></td><td class="px-4 py-2 text-right"><%= row[:entries] %></td><td class="px-4 py-2 text-right"><%= money.(row[:amount]) %></td></tr>
      <% end %>
    </tbody>
  </table>
<% end %>
<% if result.details.empty? %>
  <p class="py-6 text-center text-gray-400"><%= t("changes.nothing") %></p>
<% else %>
  <table class="min-w-full divide-y divide-gray-200 text-sm">
    <thead class="bg-gray-50"><tr>
      <% %w[when category subject author amount reason review].each do |col| %>
        <th class="px-4 py-2 text-left font-medium text-gray-600"><%= t("changes.detail.#{col}") %></th>
      <% end %>
    </tr></thead>
    <tbody class="divide-y divide-gray-100 bg-white">
      <% result.details.each do |d| %>
        <tr class="<%= 'text-gray-400' if d.neutral %>">
          <td class="px-4 py-2 whitespace-nowrap"><%= l(d.at.in_time_zone, format: "%Y-%m-%d %H:%M:%S") %></td>
          <td class="px-4 py-2"><%= t("changes.categories.#{d.category}") %> <small><%= d.action %></small><%= content_tag(:span, t("changes.neutral"), class: "ml-1 rounded bg-gray-100 px-1 text-xs") if d.neutral %></td>
          <td class="px-4 py-2"><%= d.label.presence || "#{d.subject_type.to_s.demodulize} ##{d.subject_id}" %></td>
          <td class="px-4 py-2"><%= d.author %></td>
          <td class="px-4 py-2 text-right"><%= money.(d.amount) if d.amount %></td>
          <td class="px-4 py-2"><%= d.reason %></td>
          <td class="px-4 py-2">
            <% if d.reviewed_at %>
              <%= t("changes.reviewed_by", who: d.reviewed_by, at: l(d.reviewed_at.in_time_zone, format: "%Y-%m-%d")) %>
            <% elsif @can_review %>
              <%= form_with url: accounting_changes_review_path, class: "flex gap-1" do |f| %>
                <%= hidden_field_tag :key, d.key %>
                <% keep.compact.each { |k, v| concat hidden_field_tag(k, v, id: nil) } %>
                <%= text_field_tag :comment, nil, placeholder: t("changes.comment"), "aria-label": t("changes.comment"), class: "form-input w-32" %>
                <%= f.submit t("changes.mark_reviewed"), class: "btn-secondary" %>
              <% end %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if result.per && result.total > result.per %>
    <p class="mt-3 flex gap-4 text-sm">
      <%= link_to t("changes.previous"), accounting_changes_path(keep.merge(tab: "detail", page: result.page - 1)), class: "underline" if result.page > 1 %>
      <span><%= t("changes.page", page: result.page, pages: (result.total.to_f / result.per).ceil) %></span>
      <%= link_to t("changes.next"), accounting_changes_path(keep.merge(tab: "detail", page: result.page + 1)), class: "underline" if result.page * result.per < result.total %>
    </p>
  <% end %>
<% end %>
