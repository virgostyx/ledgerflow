<%= render Ui::PageHeaderComponent.new(title: "Mail held back") %>

<section class="mb-6 rounded-lg border border-gray-200 bg-white p-4 text-sm">
  <h2 class="mb-1 font-semibold text-gray-700">Who may send documents by e-mail</h2>
  <p class="mb-2 text-gray-600">The people of the client portal who may send documents, and the addresses below (one per line). The receiving server must also vouch for SPF and DKIM.</p>
  <%= form_with url: settings_accounting_mail_quarantines_path, method: :patch do %>
    <%= text_area_tag :allowed_senders, @allowed_senders.join("\n"), rows: 3, class: "w-full rounded border border-gray-300 px-2 py-1" %>
    <%= submit_tag "Save", class: "mt-2 text-primary-700 underline cursor-pointer" %>
  <% end %>
</section>

<section class="rounded-lg border border-gray-200 bg-white p-4 text-sm">
  <% if @items.empty? %><p class="text-gray-600">Nothing is held back.</p><% end %>
  <ul class="space-y-3">
    <% @items.each do |item| %>
      <li class="rounded border border-gray-200 p-3">
        <div><strong><%= item.sender %></strong> · <%= item.subject %> · <%= item.attachment_count %> <%= "attachment".pluralize(item.attachment_count) %> · <%= l(item.created_at, format: :short) %></div>
        <div class="text-xs text-gray-600">Held because <%= item.reason == "sender_not_allowed" ? "the sender is not allowed" : "the server did not vouch for SPF and DKIM" %>. Nothing in it has been read.</div>
        <div class="mt-1 flex gap-3">
          <%= button_to "Release", release_accounting_mail_quarantine_path(item), class: "underline cursor-pointer", form: { data: { turbo_confirm: "Take the attachments of this mail into the inbox? They are checked like any upload." } } %>
          <%= button_to "Discard", discard_accounting_mail_quarantine_path(item), class: "text-red-700 underline cursor-pointer" %>
        </div>
      </li>
    <% end %>
  </ul>
</section>
