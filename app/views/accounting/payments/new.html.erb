<% content_for :breadcrumb do %>
  <%= render Ui::BreadcrumbsComponent.new(items: [ { label: 'Dashboard', path: accounting_root_path }, { label: 'Payments', path: accounting_payments_path }, { label: 'New batch' } ]) %>
<% end %>

<%= render Ui::PageHeaderComponent.new(title: 'New payment batch') %>

<%= form_with url: new_accounting_payment_path, method: :get, class: 'flex items-end gap-3 mb-4' do %>
  <div>
    <%= label_tag :execution_date, 'Execution date', class: 'block text-sm font-medium text-gray-700 mb-1' %>
    <%= date_field_tag :execution_date, @execution_date, class: 'rounded-md border border-gray-300 px-3 py-2 text-sm' %>
  </div>
  <%= submit_tag 'Show what falls due', class: 'px-3 py-2 text-sm border border-gray-300 rounded-md bg-white hover:bg-gray-50' %>
<% end %>

<%= form_with url: accounting_payments_path, scope: :payment, class: 'space-y-4' do |f| %>
  <%= hidden_field_tag 'payment[requested_execution_date]', @execution_date %>
  <div class="max-w-sm">
    <%= f.label :bank_account_id, 'Account to debit', class: 'block text-sm font-medium text-gray-700 mb-1' %>
    <%= f.select :bank_account_id, @bank_accounts.map { |a| [ a.label_fr, a.id ] }, {}, class: 'block w-full rounded-md border border-gray-300 px-3 py-2 text-sm' %>
  </div>
  <div class="max-w-sm">
    <%= f.label :bank_profile_id, 'How the bank takes the file', class: 'block text-sm font-medium text-gray-700 mb-1' %>
    <% if @profiles.any? %>
      <%= f.select :bank_profile_id, @profiles.map { |p| [ "#{p.name} (#{p.format_version})#{' - not verified' unless p.format_verified?}", p.id ] }, {}, class: 'block w-full rounded-md border border-gray-300 px-3 py-2 text-sm' %>
    <% else %>
      <p class="text-sm text-amber-700">No bank profile yet: <%= link_to 'make one', accounting_settings_payment_bank_profiles_path, class: 'underline' %> (the format of the file comes from your bank).</p>
    <% end %>
  </div>

  <div class="bg-white rounded-lg border border-gray-200 overflow-x-auto">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 border-b border-gray-200">
        <tr>
          <th class="px-4 py-3"></th>
          <% %w[Invoice Supplier Due Rest].each do |heading| %>
            <th class="px-4 py-3 text-xs font-medium text-gray-500 uppercase tracking-wider <%= heading == 'Rest' ? 'text-right' : 'text-left' %>"><%= heading %></th>
          <% end %>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Note</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @rows.each do |row| %>
          <% invoice = row.invoice %>
          <tr class="<%= row.eligible? ? '' : 'bg-gray-50 text-gray-400' %>">
            <td class="px-4 py-3">
              <% if row.eligible? %>
                <%= check_box_tag 'payment[invoice_ids][]', invoice.id, row.preselected?, id: "invoice_#{invoice.id}", class: 'rounded border-gray-300' %>
              <% end %>
            </td>
            <td class="px-4 py-3 font-medium"><%= invoice.invoice_number %></td>
            <td class="px-4 py-3"><%= invoice.partner.name %></td>
            <td class="px-4 py-3">
              <%= invoice.due_date ? l(invoice.due_date) : '—' %>
              <% if row.late? %><span class="ml-1 text-xs text-red-600">overdue</span><% elsif row.early? %><span class="ml-1 text-xs text-gray-500">later</span><% end %>
            </td>
            <td class="px-4 py-3 text-right font-mono"><%= number_with_precision(row.rest, precision: 2, delimiter: ',') %></td>
            <td class="px-4 py-3 text-xs"><%= row.reasons.map(&:message).join(' ') %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="flex items-center gap-2 text-sm text-gray-700">
    <%= check_box_tag 'payment[net_credit_notes]', '1', false, class: 'rounded border-gray-300' %>
    <%= label_tag 'payment_net_credit_notes', 'Net the open credit notes of a supplier against its invoices' %>
  </div>

  <%= submit_tag 'Make the batch', class: 'px-4 py-2 bg-primary-600 text-white text-sm font-medium rounded-md hover:bg-primary-700' %>
<% end %>
