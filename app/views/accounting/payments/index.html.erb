<% content_for :breadcrumb do %>
  <%= render Ui::BreadcrumbsComponent.new(items: [ { label: 'Dashboard', path: accounting_root_path }, { label: 'Payments' } ]) %>
<% end %>

<%= render Ui::PageHeaderComponent.new(title: 'Payments') do |header| %>
  <% if policy(Payments::Batch).create? %>
    <% header.with_actions do %>
      <%= link_to 'New batch', new_accounting_payment_path, class: 'inline-flex items-center px-4 py-2 bg-primary-600 text-white text-sm font-medium rounded-md hover:bg-primary-700 transition-colors' %>
    <% end %>
  <% end %>
<% end %>

<p class="text-sm text-gray-500 mb-4">LedgerFlow prepares the file; you load it and authorize it in your own bank. Nothing is paid from here.</p>

<% i = @indicators %>
<section class="mb-4 grid grid-cols-2 md:grid-cols-5 gap-3 text-sm" data-section="indicators">
  <div class="rounded-lg border border-gray-200 bg-white p-3"><div class="text-gray-500">Batches debited (90 days)</div><div class="font-mono text-gray-900"><%= i.batches %></div></div>
  <div class="rounded-lg border border-gray-200 bg-white p-3"><div class="text-gray-500">Recognised from the statement</div><div class="font-mono text-gray-900"><%= i.recognition_rate ? "#{(i.recognition_rate * 100).round} %" : '—' %></div></div>
  <div class="rounded-lg border border-gray-200 bg-white p-3"><div class="text-gray-500">Mean days after the due date</div><div class="font-mono text-gray-900"><%= i.mean_days_late ? number_with_precision(i.mean_days_late, precision: 1) : '—' %></div></div>
  <div class="rounded-lg border border-gray-200 bg-white p-3"><div class="text-gray-500">Paid late</div><div class="font-mono text-gray-900"><%= i.late_payments %> · <%= number_with_precision(i.late_amount, precision: 2, delimiter: ',') %></div></div>
  <div class="rounded-lg border border-gray-200 bg-white p-3"><div class="text-gray-500">Returned</div><div class="font-mono text-gray-900"><%= number_with_precision(i.returned_amount, precision: 2, delimiter: ',') %></div></div>
</section>
<p class="mb-4 text-sm"><span class="text-gray-500">Executed payments, invoice by invoice:</span>
  <%= link_to 'CSV', executed_accounting_payments_path(format: :csv), class: 'text-primary-600 hover:text-primary-800' %> ·
  <%= link_to 'XLSX', executed_accounting_payments_path(format: :xlsx), class: 'text-primary-600 hover:text-primary-800' %></p>

<% if @batches.empty? %>
  <%= render Ui::EmptyStateComponent.new(title: 'No payment batches yet', description: 'Pick the approved invoices that fall due and make a batch.', icon: :clipboard) %>
<% else %>
  <div class="bg-white rounded-lg border border-gray-200 overflow-x-auto">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 border-b border-gray-200">
        <tr>
          <% %w[Reference Account Execution Payments Total Status File].each do |heading| %>
            <th class="px-4 py-3 text-xs font-medium text-gray-500 uppercase tracking-wider <%= %w[Payments Total].include?(heading) ? 'text-right' : 'text-left' %>"><%= heading %></th>
          <% end %>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @batches.each do |batch| %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-3 font-medium"><%= link_to batch.reference, accounting_payment_path(batch), class: 'text-primary-600 hover:text-primary-800' %></td>
            <td class="px-4 py-3 text-gray-600"><%= batch.bank_account.label_fr %></td>
            <td class="px-4 py-3 text-gray-600"><%= l batch.requested_execution_date %></td>
            <td class="px-4 py-3 text-right text-gray-600"><%= batch.payments_count %></td>
            <td class="px-4 py-3 text-right font-mono text-gray-900"><%= number_with_precision(batch.total, precision: 2, delimiter: ',') %></td>
            <td class="px-4 py-3 text-gray-700"><%= batch.status.humanize %></td>
            <td class="px-4 py-3">
              <% if batch.document && policy(batch).export? %>
                <%= link_to 'XML', download_accounting_payment_path(batch), class: 'text-primary-600 hover:text-primary-800' %>
                <span class="text-xs text-gray-400 font-mono"><%= batch.file_sha256[0, 8] %></span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
