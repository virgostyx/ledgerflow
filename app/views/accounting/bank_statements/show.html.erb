<% content_for :breadcrumb do %>
  <%= render Ui::BreadcrumbsComponent.new(items: [ { label: "Dashboard", path: accounting_root_path }, { label: "Bank statements", path: accounting_bank_statements_path }, { label: "##{@statement.sequence || @statement.id}" } ]) %>
<% end %>

<%= render Ui::PageHeaderComponent.new(title: "Statement ##{@statement.sequence || @statement.id}", description: "#{@statement.bank_account.label_fr}, imported #{l(@statement.import_batch.created_at, format: :short)}") %>

<dl class="mb-6 grid grid-cols-2 gap-4 text-sm md:grid-cols-4">
  <div><dt class="text-gray-500">Opening balance</dt><dd class="font-mono"><%= Accounting::MoneyPresenter.new(@statement.old_balance).format %></dd></div>
  <div><dt class="text-gray-500">Closing balance</dt><dd class="font-mono"><%= @statement.new_balance ? Accounting::MoneyPresenter.new(@statement.new_balance).format : "—" %></dd></div>
  <div><dt class="text-gray-500">Integrity</dt><dd><%= @statement.to_review? ? "To review (gap #{Accounting::MoneyPresenter.new(@statement.integrity_gap).format})" : "Adds up" %></dd></div>
  <div><dt class="text-gray-500">Chain</dt><dd><%= @statement.chain_gap.nil? ? "First statement" : (@statement.chain_broken? ? "Broken by #{Accounting::MoneyPresenter.new(@statement.chain_gap).format}" : "Follows the previous one") %></dd></div>
</dl>

<% if @statement.messages.any? %>
  <div class="mb-6 rounded-md border border-gray-200 bg-gray-50 p-3 text-sm text-gray-700"><%= safe_join(@statement.messages, tag.br) %></div>
<% end %>

<div class="bg-white rounded-lg border border-gray-200 overflow-x-auto">
  <table class="w-full text-sm">
    <thead class="bg-gray-50 border-b border-gray-200 text-left text-xs font-medium uppercase tracking-wider text-gray-500">
      <tr><th class="px-4 py-3">Date</th><th class="px-4 py-3">Counterparty</th><th class="px-4 py-3">Communication</th><th class="px-4 py-3 text-right">Amount</th><th class="px-4 py-3">State</th></tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% @transactions.each do |tx| %>
        <tr>
          <td class="px-4 py-3 text-gray-500"><%= Accounting::DatePresenter.new(tx.transaction_date).format %></td>
          <td class="px-4 py-3 text-gray-700"><%= tx.counterparty_name %></td>
          <td class="px-4 py-3 text-gray-700"><%= tx.description %></td>
          <td class="px-4 py-3 text-right font-mono <%= tx.credit? ? "text-emerald-700" : "text-red-700" %>"><%= Accounting::MoneyPresenter.new(tx.amount).format %></td>
          <td class="px-4 py-3 text-xs text-gray-600"><%= tx.status.humanize %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
