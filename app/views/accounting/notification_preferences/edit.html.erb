<% content_for :breadcrumb do %>
  <%= render Ui::BreadcrumbsComponent.new(items: [ { label: 'Dashboard', path: accounting_root_path }, { label: 'Notifications', path: accounting_notifications_path }, { label: 'Preferences' } ]) %>
<% end %>

<%= render Ui::PageHeaderComponent.new(title: 'Notification preferences', back_path: accounting_notifications_path, back_text: 'Notifications') %>

<%= form_with model: @membership, scope: :user_entity, url: accounting_notification_preferences_path, method: :patch, class: 'space-y-4 max-w-xl text-sm' do |f| %>
  <label class="flex items-start gap-2"><%= f.check_box :notify_by_email, class: 'mt-1' %>
    <span>Send me an e-mail when a task is assigned to me, when I am mentioned, and the day before a task of mine is due.<br><span class="text-gray-500">The application always lists them under Notifications.</span></span></label>
  <label class="flex items-start gap-2"><%= f.check_box :notify_daily_digest, class: 'mt-1' %>
    <span>Send me a summary of my open tasks every morning (nothing when I have none).</span></label>
  <%= f.submit 'Save', class: 'px-4 py-2 bg-primary-600 text-white text-sm font-medium rounded-md hover:bg-primary-700 cursor-pointer' %>
<% end %>
