<% content_for :breadcrumb do %>
  <%= render Ui::BreadcrumbsComponent.new(items: [
    { label: 'Dashboard', path: accounting_root_path },
    { label: 'Intracommunity Listings', path: accounting_intracom_listings_path },
    { label: "#{Accounting::DatePresenter.new(@listing.period_start).format} — #{Accounting::DatePresenter.new(@listing.period_end).format}" }
  ]) %>
<% end %>

<%= render Ui::PageHeaderComponent.new(
      title: 'Intracommunity Listing',
      description: "#{Accounting::DatePresenter.new(@listing.period_start).format} — #{Accounting::DatePresenter.new(@listing.period_end).format}",
      back_path: accounting_intracom_listings_path,
      back_text: 'Intracommunity Listings'
    ) %>

<div class="bg-white rounded-lg border border-gray-200 p-6 max-w-3xl">
  <dl class="grid grid-cols-3 gap-4 mb-6">
    <div>
      <dt class="text-xs font-medium text-gray-500 uppercase tracking-wider">Status</dt>
      <dd class="mt-1 text-sm text-gray-900"><%= @listing.status %></dd>
    </div>
    <div>
      <dt class="text-xs font-medium text-gray-500 uppercase tracking-wider">Total</dt>
      <dd class="mt-1 text-sm text-gray-900 font-mono"><%= Accounting::MoneyPresenter.new(@listing.total_amount).format %></dd>
    </div>
  </dl>

  <% if @listing.lines.any? %>
    <h2 class="text-sm font-semibold text-gray-700 mb-3">Customers</h2>
    <table class="w-full text-sm border-collapse">
      <thead>
        <tr class="bg-gray-50 border-b border-gray-200">
          <th class="px-3 py-2 text-left text-xs font-medium text-gray-500">Customer</th>
          <th class="px-3 py-2 text-left text-xs font-medium text-gray-500">VAT number</th>
          <th class="px-3 py-2 text-left text-xs font-medium text-gray-500">Code</th>
          <th class="px-3 py-2 text-right text-xs font-medium text-gray-500">Amount (€)</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @listing.lines.includes(:partner).each do |line| %>
          <tr>
            <td class="px-3 py-2 text-gray-900"><%= line.partner.name %></td>
            <td class="px-3 py-2 font-mono text-gray-700"><%= line.partner.vat_number %></td>
            <td class="px-3 py-2 text-gray-700"><%= line.code == 'L' ? 'L — Goods' : 'S — Services' %></td>
            <td class="px-3 py-2 text-right font-mono text-gray-900">
              <%= Accounting::MoneyPresenter.new(line.amount).format %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <%= render Ui::EmptyStateComponent.new(title: 'No intracommunity sales for this period.', icon: :inbox) %>
  <% end %>
</div>
