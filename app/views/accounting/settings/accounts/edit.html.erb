<% content_for :breadcrumb do %>
  <%= link_to "Settings", accounting_settings_root_path, class: "text-gray-400 hover:text-gray-600" %>
  <span class="mx-2 text-gray-300">/</span>
  <%= link_to "Chart of Accounts", accounting_settings_accounts_path(account_class: @account.account_class), class: "text-gray-400 hover:text-gray-600" %>
  <span class="mx-2 text-gray-300">/</span>
  <span class="text-gray-700 font-medium">Edit <%= @account.code %></span>
<% end %>

<div class="max-w-2xl">
  <%= render Ui::PageHeaderComponent.new(title: "Edit Account — #{@account.code}") %>
  <div class="mt-6 bg-white rounded-lg border border-gray-200 p-6">
    <%= render "form", account: @account, parent: @account.parent %>
  </div>
</div>
