<% content_for :breadcrumb do %>
  <%= link_to "Settings", accounting_settings_root_path, class: "text-gray-400 hover:text-gray-600" %>
  <span class="mx-2 text-gray-300">/</span>
  <span class="text-gray-700 font-medium">Chart of Accounts</span>
<% end %>

<div class="max-w-5xl">
  <%= render Ui::PageHeaderComponent.new(title: "Chart of Accounts (PCMN)") %>

  <div class="mt-4 flex gap-1 flex-wrap">
    <%= link_to "All",
          accounting_settings_accounts_path,
          class: "px-3 py-1.5 rounded text-sm font-medium #{params[:account_class].blank? ? 'bg-primary-600 text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'}" %>
    <% (1..7).each do |klass| %>
      <%= link_to "Class #{klass}",
            accounting_settings_accounts_path(account_class: klass),
            class: "px-3 py-1.5 rounded text-sm font-medium #{params[:account_class].to_s == klass.to_s ? 'bg-primary-600 text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'}" %>
    <% end %>
  </div>

  <div class="mt-4 bg-white rounded-lg border border-gray-200 overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Code</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Label</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Type</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Status</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @accounts.each do |account| %>
          <%
            indent_level = account.parent_id.present? ? [ account.code.length - 6, 0 ].max : 0
            indent_px    = indent_level * 16
          %>
          <tr class="<%= account.active? ? '' : 'opacity-50' %> hover:bg-gray-50">
            <td class="px-4 py-2.5 text-sm font-mono">
              <span style="padding-left: <%= indent_px %>px"><%= account.code %></span>
            </td>
            <td class="px-4 py-2.5 text-sm text-gray-700">
              <%= account.label_fr %>
              <% if account.custom? %>
                <span class="ml-1.5 inline-flex items-center px-1.5 py-0.5 rounded text-xs font-medium bg-amber-100 text-amber-700">Custom</span>
              <% end %>
            </td>
            <td class="px-4 py-2.5 text-xs text-gray-500 capitalize"><%= account.account_type %></td>
            <td class="px-4 py-2.5">
              <% if account.active? %>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-emerald-100 text-emerald-700">Active</span>
              <% else %>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-500">Inactive</span>
              <% end %>
            </td>
            <td class="px-4 py-2.5 text-right">
              <div class="flex items-center justify-end gap-3">
                <% if account.is_leaf? && !account.custom? %>
                  <%= link_to "Add sub-account",
                        new_accounting_settings_account_path(parent_id: account.id),
                        class: "text-xs text-primary-600 hover:text-primary-800" %>
                <% end %>
                <%= link_to "Edit",
                      edit_accounting_settings_account_path(account),
                      class: "text-sm text-primary-600 hover:text-primary-800" %>
              </div>
            </td>
          </tr>
        <% end %>

        <% if @accounts.empty? %>
          <tr>
            <td colspan="5" class="px-4 py-12 text-center text-sm text-gray-400">
              No accounts found.
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
