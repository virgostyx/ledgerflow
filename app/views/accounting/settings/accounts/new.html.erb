<% content_for :breadcrumb do %>
  <%= link_to "Settings", accounting_settings_root_path, class: "text-gray-400 hover:text-gray-600" %>
  <span class="mx-2 text-gray-300">/</span>
  <%= link_to "Chart of Accounts", accounting_settings_accounts_path, class: "text-gray-400 hover:text-gray-600" %>
  <span class="mx-2 text-gray-300">/</span>
  <span class="text-gray-700 font-medium">New Custom Account</span>
<% end %>

<div class="max-w-2xl">
  <%= render Ui::PageHeaderComponent.new(title: "New Custom Account") %>
  <% if @parent %>
    <p class="mt-1 text-sm text-gray-500">
      Sub-account of <span class="font-mono font-medium"><%= @parent.full_label %></span>
    </p>
  <% end %>
  <div class="mt-6 bg-white rounded-lg border border-gray-200 p-6">
    <%= render "form", account: @account, parent: @parent %>
  </div>
</div>
