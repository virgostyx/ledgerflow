<% content_for :breadcrumb do %>
  <%= link_to "Settings", accounting_settings_root_path, class: "text-gray-400 hover:text-gray-600" %>
  <span class="mx-2 text-gray-300">/</span>
  <span class="text-gray-700 font-medium">Peppol</span>
<% end %>

<% input_class = "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-primary-500 focus:border-primary-500" %>
<% fields = @entity.peppol_access_point ? Peppol::AccessPoint.credential_fields(@entity.peppol_access_point) : [] %>

<div class="max-w-2xl">
  <%= render Ui::PageHeaderComponent.new(title: "Peppol") %>

  <div class="mt-6 bg-white rounded-lg border border-gray-200 p-6">
    <%= form_with model: @entity, url: accounting_settings_peppol_settings_path, method: :patch,
          scope: :entity, class: "space-y-5" do |f| %>

      <% if @entity.errors.any? %>
        <div class="rounded-md bg-danger-50 border border-danger-200 p-4">
          <ul class="list-disc list-inside text-sm text-danger-700 space-y-1">
            <% @entity.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="grid grid-cols-2 gap-5">
        <div>
          <%= f.label :peppol_access_point, "Access Point", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.select :peppol_access_point,
                Peppol::AccessPoint::PROVIDERS.keys.reject { |p| p == "simulator" && !Rails.configuration.x.peppol_simulator_allowed }
                  .map { |p| [ p.capitalize, p ] },
                { include_blank: "None" }, class: input_class %>
          <p class="mt-1 text-xs text-gray-400">The provider that sends and receives your documents. Save to see its credentials.</p>
        </div>

        <div>
          <%= f.label :peppol_participant_id, "Your Peppol identifier", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :peppol_participant_id, class: input_class, placeholder: "0208:0123456789" %>
          <p class="mt-1 text-xs text-gray-400">Scheme and value; in Belgium 0208 followed by the 10 digits of your enterprise number.</p>
        </div>
      </div>

      <% if fields.any? %>
        <div class="grid grid-cols-2 gap-5">
          <% fields.each do |field| %>
            <% stored = @entity.peppol_credentials.to_h[field[:key]].present? %>
            <div>
              <%= label_tag "credentials_#{field[:key]}", field[:label], class: "block text-sm font-medium text-gray-700 mb-1" %>
              <% name, value = "credentials[#{field[:key]}]", @entity.peppol_credentials.to_h[field[:key]] %>
              <% if field[:secret] %>
                <%= password_field_tag name, nil, id: "credentials_#{field[:key]}", class: input_class, autocomplete: "off",
                      placeholder: (stored ? "already set" : nil) %>
              <% else %>
                <%= text_field_tag name, value, id: "credentials_#{field[:key]}", class: input_class, autocomplete: "off" %>
              <% end %>
              <% if stored && field[:secret] %>
                <p class="mt-1 text-xs text-gray-400">Already set; leave empty to keep it.</p>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>

      <% if @entity.peppol_access_point %>
        <div>
          <p class="block text-sm font-medium text-gray-700 mb-1">Webhook URL</p>
          <code class="block rounded-md bg-gray-50 border border-gray-200 px-3 py-2 text-xs text-gray-700 break-all"><%= peppol_webhook_url(token: @entity.peppol_webhook_token) %></code>
          <p class="mt-1 text-xs text-gray-400">Give this address to your Access Point so it can report deliveries and send you invoices.</p>
        </div>
      <% end %>

      <div class="flex items-center gap-3 pt-2">
        <%= f.submit "Save Peppol Settings",
              class: "px-4 py-2 rounded-md bg-primary-600 text-white text-sm font-medium hover:bg-primary-700 transition-colors cursor-pointer" %>
        <%= link_to "Cancel", accounting_settings_root_path,
              class: "px-4 py-2 rounded-md border border-gray-300 text-gray-700 text-sm font-medium hover:bg-gray-50 transition-colors" %>
      </div>
    <% end %>
  </div>

  <% if @entity.peppol_ap_simulator? %>
    <div class="mt-6 bg-white rounded-lg border border-gray-200 p-6">
      <p class="text-sm text-gray-700">The simulator stands in for a real Access Point during development: nothing leaves the application.</p>
      <%= button_to "Simulate an incoming invoice", simulate_incoming_accounting_settings_peppol_settings_path,
            class: "mt-3 px-4 py-2 rounded-md border border-gray-300 text-gray-700 text-sm font-medium hover:bg-gray-50 transition-colors cursor-pointer" %>
    </div>
  <% end %>
</div>
