<% content_for :breadcrumb do %>
  <%= render Ui::BreadcrumbsComponent.new(items: [ { label: "Settings", path: accounting_settings_root_path }, { label: "Bank profiles" } ]) %>
<% end %>

<div class="max-w-4xl">
  <div class="flex items-start justify-between">
    <div>
      <h1 class="mb-1 text-2xl font-bold text-gray-900">Bank profiles</h1>
      <p class="mb-6 text-sm text-gray-500">How each bank takes its payment file. The version of the format comes from the bank, never from a guess. A profile is "verified" once a file of this version was seen to be taken by the bank.</p>
    </div>
    <%= link_to "New profile", new_accounting_settings_payment_bank_profile_path, class: "shrink-0 px-4 py-2 bg-primary-600 text-white text-sm font-medium rounded-md hover:bg-primary-700" %>
  </div>

  <% if @profiles.empty? %>
    <p class="text-sm text-gray-500">No profile yet: a batch needs one to be put to approval.</p>
  <% else %>
    <div class="space-y-3">
      <% @profiles.each do |profile| %>
        <div class="rounded-lg border border-gray-200 bg-white p-4">
          <div class="flex items-start justify-between">
            <h2 class="text-sm font-semibold text-gray-900"><%= profile.name %> <span class="ml-2 text-xs font-normal text-gray-500"><%= profile.format_version %></span></h2>
            <%= link_to "Edit", edit_accounting_settings_payment_bank_profile_path(profile), class: "text-sm text-primary-600 hover:text-primary-800" %>
          </div>
          <p class="mt-1 text-xs text-gray-500">
            <%= profile.format_verified? ? "File format verified with the bank" : "File format not verified: start with one small payment, compared with the bank" %> ·
            <%= profile.coda_verified? ? "statement (CODA) seen" : "statement (CODA) not seen yet" %>
          </p>
          <p class="mt-1 text-xs text-gray-500">
            <%= [ ("at most #{profile.max_payments} payments per file" if profile.max_payments), ("batch up to #{number_with_precision(profile.max_batch_total, precision: 2, delimiter: ',')}" if profile.max_batch_total),
                  ("one supplier up to #{number_with_precision(profile.max_supplier_total, precision: 2, delimiter: ',')}" if profile.max_supplier_total), "balance warning under #{number_with_precision(profile.balance_threshold, precision: 2, delimiter: ',')}",
                  ("closed: #{Array(profile.options['closed_days']).join(', ')}" if profile.options['closed_days'].present?) ].compact.join(" · ") %>
          </p>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
