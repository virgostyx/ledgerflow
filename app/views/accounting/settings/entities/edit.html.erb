<% content_for :breadcrumb do %>
  <%= link_to "Settings", accounting_settings_root_path, class: "text-gray-400 hover:text-gray-600" %>
  <span class="mx-2 text-gray-300">/</span>
  <span class="text-gray-700 font-medium">Entity</span>
<% end %>

<div class="max-w-2xl">
  <%= render Ui::PageHeaderComponent.new(title: "Entity", description: "Identity and address printed on your invoices") %>

  <div class="mt-6 bg-white rounded-lg border border-gray-200 p-6">
    <%= form_with model: @entity, url: accounting_settings_entity_path, method: :patch,
          scope: :entity, class: "space-y-5" do |f| %>

      <% if @entity.errors.any? %>
        <div class="rounded-md bg-danger-50 border border-danger-200 p-4">
          <ul class="list-disc list-inside text-sm text-danger-700 space-y-1">
            <% @entity.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="grid grid-cols-2 gap-5">
        <div>
          <%= f.label :name, "Entity name *", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :name, class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-primary-500 focus:border-primary-500", required: true %>
        </div>
        <div>
          <%= f.label :legal_name, "Legal name *", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :legal_name, class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-primary-500 focus:border-primary-500", required: true %>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-5">
        <div>
          <%= f.label :legal_form, "Legal form", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.select :legal_form,
                [["ASBL / VZW", "ASBL"], ["Fondation / Stichting", "Fondation"],
                 ["SA / NV", "SA"], ["SRL / BV", "SRL"], ["SCRL / CVBA", "SCRL"],
                 ["Sole proprietorship", "Self-employed"], ["Other", "Other"]],
                { include_blank: "Select" },
                class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-primary-500 focus:border-primary-500" %>
        </div>
        <div>
          <%= f.label :vat_number, "VAT number", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :vat_number, class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm font-mono focus:outline-none focus:ring-1 focus:ring-primary-500 focus:border-primary-500", placeholder: "BE0123456789" %>
        </div>
      </div>

      <div>
        <%= f.label :address_line1, "Address", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :address_line1, class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-primary-500 focus:border-primary-500" %>
      </div>

      <div>
        <%= f.label :address_line2, "Address line 2", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :address_line2, class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-primary-500 focus:border-primary-500" %>
      </div>

      <div class="grid grid-cols-3 gap-5">
        <div>
          <%= f.label :zip_code, "Postal code", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :zip_code, class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-primary-500 focus:border-primary-500" %>
        </div>
        <div>
          <%= f.label :city, "City", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :city, class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-primary-500 focus:border-primary-500" %>
        </div>
        <div>
          <%= f.label :country, "Country", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :country, class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-primary-500 focus:border-primary-500", required: true %>
        </div>
      </div>

      <% if Accounting::Settings::BasePolicy.new(current_user, :settings).destroy? %>
        <div class="flex items-start gap-2 pt-2">
          <%= f.check_box :budgetflow_enabled, class: "mt-1 rounded border-gray-300" %>
          <%= f.label :budgetflow_enabled, class: "text-sm text-gray-700" do %>
            This entity uses BudgetFlow
            <span class="block text-xs text-gray-400">Turns on the BudgetFlow connection: API clients, the invoices received from BudgetFlow and the payment feed.</span>
          <% end %>
        </div>
        <% Entity::FEATURE_LABELS.each do |key, (title, help)| %>
          <div class="flex items-start gap-2 pt-2">
            <%= hidden_field_tag "entity[features][#{key}]", "0", id: nil %>
            <%= check_box_tag "entity[features][#{key}]", "1", @entity.feature?(key), id: "entity_features_#{key}", class: "mt-1 rounded border-gray-300" %>
            <%= label_tag "entity_features_#{key}", class: "text-sm text-gray-700" do %>
              <%= title %>
              <span class="block text-xs text-gray-400"><%= help %></span>
            <% end %>
          </div>
        <% end %>
        <% if @entity.feature?(:agent) && policy(:agent).configure? %>
          <p class="pt-1 pl-6 text-xs"><%= link_to "Assistant settings: turn it on, retention of the conversations", agent_setting_path, class: "text-indigo-700 hover:underline" %></p>
        <% end %>
        <% if @entity.feature?(:f02) %>
        <div class="flex items-start gap-2 pt-2">
          <%= f.check_box :auto_post_exact_bank_matches, class: "mt-1 rounded border-gray-300" %>
          <%= f.label :auto_post_exact_bank_matches, class: "text-sm text-gray-700" do %>
            Validate exact bank matches automatically
            <span class="block text-xs text-gray-400">A bank line that matches a customer invoice with certainty (structured communication, same amount) is booked as a draft payment. Tick this to have it validated at once; left off, an accountant validates it.</span>
          <% end %>
        </div>
        <div class="max-w-xs">
          <%= f.label :bank_rounding_tolerance, "Rounding tolerance of a bank payment (EUR)", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.number_field :bank_rounding_tolerance, step: "0.01", min: 0, class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-primary-500 focus:border-primary-500" %>
          <% unless Accounting::CreateRoundingAccounts.ready? %>
            <p class="mt-1 text-xs text-amber-700">The tolerance does nothing until the two rounding accounts (658100, 758100) exist in this entity's chart.</p>
            <%= button_to "Create the rounding accounts", create_rounding_accounts_accounting_settings_entity_path, method: :post, form: { class: "mt-1" },
                  class: "text-xs font-medium text-primary-700 underline cursor-pointer" %>
          <% end %>
        </div>
        <% end %>
        <div class="flex items-start gap-2 pt-2">
          <%= f.check_box :auto_reconcile_exact, class: "mt-1 rounded border-gray-300" %>
          <%= f.label :auto_reconcile_exact, class: "text-sm text-gray-700" do %>
            Letter exact matches automatically, every night
            <span class="block text-xs text-gray-400">Only the suggestions of score 100 (same amount, same reference, no other candidate) are lettered, marked as automatic and audited. Everything else waits for a person. Any lettering can be undone with a reason.</span>
          <% end %>
        </div>
        <% if @entity.feature?(:f01) %>
        <div class="flex items-start gap-2 pt-2">
          <%= f.check_box :four_eyes, class: "mt-1 rounded border-gray-300" %>
          <%= f.label :four_eyes, class: "text-sm text-gray-700" do %>
            Entries must be validated by another person than their author
            <span class="block text-xs text-gray-400">Applies to entries written by hand. Leave the amount empty to apply it to every entry.</span>
          <% end %>
        </div>
        <div class="flex items-start gap-2 pt-2">
          <%= f.check_box :read_only_export, class: "mt-1 rounded border-gray-300" %>
          <%= f.label :read_only_export, class: "text-sm text-gray-700" do %>
            Read-only roles may export
            <span class="block text-xs text-gray-400">Lets a Reader and an External auditor download reports as CSV, Excel or PDF. Off, they can only read on screen.</span>
          <% end %>
        </div>
        <div class="max-w-xs">
          <%= f.label :four_eyes_threshold, "From this amount (EUR)", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.number_field :four_eyes_threshold, step: "0.01", min: 0, class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-primary-500 focus:border-primary-500" %>
        </div>
        <% end %>
        <% if @entity.feature?(:b01a) %>
        <div class="flex items-start gap-2 pt-2">
          <%= f.check_box :bap_before_posting, class: "mt-1 rounded border-gray-300" %>
          <%= f.label :bap_before_posting, class: "text-sm text-gray-700" do %>
            Purchase invoices need their approval before they are validated
            <span class="block text-xs text-gray-400">Off, an invoice is validated and its VAT declared on time, and only its payment waits for the approval.</span>
          <% end %>
        </div>
        <div class="flex items-start gap-2 pt-2">
          <%= f.check_box :allow_self_approval, class: "mt-1 rounded border-gray-300" %>
          <%= f.label :allow_self_approval, class: "text-sm text-gray-700" do %>
            The author of an invoice may approve it
            <span class="block text-xs text-gray-400">For a one-person firm. Off, nobody approves an invoice they entered, nor does their delegate. Every change of this option is recorded.</span>
          <% end %>
        </div>
        <div class="max-w-xs">
          <%= f.label :bulk_threshold, "Bulk approval up to (EUR, incl. VAT)", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.number_field :bulk_threshold, step: "0.01", min: 0, class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-primary-500 focus:border-primary-500" %>
          <span class="block text-xs text-gray-400 mt-1">Empty: bulk approval is off. An invoice with a warning is never approved in bulk.</span>
        </div>
        <% end %>
      <% end %>

      <div class="flex items-center gap-3 pt-2">
        <%= f.submit "Save entity",
              class: "px-4 py-2 rounded-md bg-primary-600 text-white text-sm font-medium hover:bg-primary-700 transition-colors cursor-pointer" %>
        <%= link_to "Cancel", accounting_settings_root_path,
              class: "px-4 py-2 rounded-md border border-gray-300 text-gray-700 text-sm font-medium hover:bg-gray-50 transition-colors" %>
      </div>
    <% end %>
  </div>

  <% if @entity.feature?(:f03) && Accounting::Settings::BasePolicy.new(current_user, :settings).destroy? %>
    <div class="mt-6 bg-white rounded-lg border border-gray-200 p-6">
      <h2 class="text-sm font-semibold text-gray-900">Documents by e-mail</h2>
      <p class="mt-1 text-xs text-gray-500">Attachments sent to this address land in the document inbox. Keep it private: anyone who knows it can add documents.</p>
      <p class="mt-3 font-mono text-sm text-gray-800 break-all"><%= @entity.documents_email %></p>
      <%= button_to "Replace the address", regenerate_documents_address_accounting_settings_entity_path, method: :post,
            data: { turbo_confirm: "The current address will stop working. Replace it?" },
            class: "mt-3 px-3 py-1.5 rounded-md border border-gray-300 text-gray-700 text-sm hover:bg-gray-50 cursor-pointer" %>
    </div>
  <% end %>
</div>
