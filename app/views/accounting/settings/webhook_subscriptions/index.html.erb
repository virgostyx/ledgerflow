<% content_for :breadcrumb do %>
  <%= link_to "Settings", accounting_settings_root_path, class: "text-gray-400 hover:text-gray-600" %>
  <span class="mx-2 text-gray-300">/</span>
  <span class="text-gray-700 font-medium">Webhooks</span>
<% end %>

<% content_for :actions do %>
  <%= link_to "New webhook", new_accounting_settings_webhook_subscription_path,
        class: "inline-flex items-center gap-2 px-3 py-1.5 rounded-md bg-primary-600 text-white text-sm font-medium hover:bg-primary-700 transition-colors" %>
<% end %>

<div class="max-w-5xl">
  <%= render Ui::PageHeaderComponent.new(title: "Webhooks", description: "LedgerFlow calls these addresses when something happens: an entry is validated or reversed, lines are lettered, a period is locked, a document or a Peppol invoice arrives, a year is closed. Each call is signed with the secret of the webhook.") %>

  <div class="mt-6 bg-white rounded-lg border border-gray-200 overflow-x-clip">
    <table class="min-w-full divide-y divide-gray-200 text-sm" data-section="subscriptions">
      <thead class="bg-gray-50"><tr>
        <% %w[Name Address Events Status Last\ sent].each do |h| %><th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider"><%= h %></th><% end %>
        <th class="px-4 py-3"></th>
      </tr></thead>
      <tbody class="divide-y divide-gray-100">
        <% @subscriptions.each do |subscription| %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-3 font-medium text-gray-900"><%= link_to subscription.name, deliveries_accounting_settings_webhook_subscription_path(subscription), class: "hover:underline" %></td>
            <td class="px-4 py-3 text-gray-600 break-all"><%= subscription.url %></td>
            <td class="px-4 py-3 text-gray-600"><%= subscription.events.size %> of <%= WebhookSubscription::EVENTS.size %></td>
            <td class="px-4 py-3">
              <% if subscription.suspended? %><span class="px-2 py-0.5 rounded text-xs font-medium bg-red-100 text-red-800" title="<%= subscription.suspended_reason %>">Suspended</span>
              <% else %><span class="px-2 py-0.5 rounded text-xs font-medium bg-emerald-100 text-emerald-700">Active</span><% end %>
            </td>
            <td class="px-4 py-3 text-gray-500"><%= subscription.last_delivery_at ? l(subscription.last_delivery_at, format: :short) : "Never" %></td>
            <td class="px-4 py-3 text-right whitespace-nowrap">
              <%= link_to "Edit", edit_accounting_settings_webhook_subscription_path(subscription), class: "text-sm text-primary-600 hover:text-primary-800 mr-3" %>
              <%= button_to "New secret", rotate_secret_accounting_settings_webhook_subscription_path(subscription), method: :post, class: "inline text-sm text-primary-600 hover:text-primary-800 mr-3",
                    form: { class: "inline", data: { turbo_confirm: "Issue a new secret? The old one keeps signing for a day." } } %>
              <%= button_to "Delete", accounting_settings_webhook_subscription_path(subscription), method: :delete, class: "inline text-sm text-danger-600 hover:text-danger-800",
                    form: { class: "inline", data: { turbo_confirm: "Delete #{subscription.name} and its log?" } } %>
            </td>
          </tr>
        <% end %>
        <% if @subscriptions.empty? %><tr><td colspan="6" class="px-4 py-12 text-center text-sm text-gray-400">No webhooks yet.</td></tr><% end %>
      </tbody>
    </table>
  </div>
</div>
