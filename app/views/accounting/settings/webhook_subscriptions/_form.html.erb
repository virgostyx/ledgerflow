<%= form_with model: subscription, url: url, method: method, scope: :webhook_subscription, class: "mt-6 space-y-5" do |f| %>
  <% if subscription.errors.any? %>
    <div class="rounded-md bg-danger-50 border border-danger-200 p-4"><ul class="list-disc list-inside text-sm text-danger-700 space-y-1">
      <% subscription.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
    </ul></div>
  <% end %>
  <div>
    <%= f.label :name, "Name", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :name, class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm" %>
  </div>
  <div>
    <%= f.label :url, "Address (https, public)", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :url, placeholder: "https://example.com/hooks/ledgerflow", class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm" %>
  </div>
  <fieldset>
    <legend class="block text-sm font-medium text-gray-700 mb-2">Events</legend>
    <%= f.collection_check_boxes :events, WebhookSubscription::EVENTS, :itself, :itself do |b| %>
      <label class="flex items-center gap-2 text-sm font-mono text-gray-700 mb-1"><%= b.check_box(class: "rounded border-gray-300") %> <%= b.text %></label>
    <% end %>
  </fieldset>
  <div>
    <%= f.label :max_failures, "Suspend after this many failed attempts in a row", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.number_field :max_failures, value: subscription.max_failures || 10, min: 1, max: 100, class: "block w-32 rounded-md border border-gray-300 px-3 py-2 text-sm" %>
  </div>
  <div class="flex gap-3">
    <%= f.submit submit, class: "px-4 py-2 rounded-md bg-primary-600 text-white text-sm font-medium hover:bg-primary-700" %>
    <%= link_to "Cancel", accounting_settings_webhook_subscriptions_path, class: "px-4 py-2 text-sm text-gray-600 hover:text-gray-900" %>
  </div>
<% end %>
