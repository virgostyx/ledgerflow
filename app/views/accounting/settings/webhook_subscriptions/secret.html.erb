<% content_for :breadcrumb do %>
  <%= link_to "Settings", accounting_settings_root_path, class: "text-gray-400 hover:text-gray-600" %><span class="mx-2 text-gray-300">/</span>
  <%= link_to "Webhooks", accounting_settings_webhook_subscriptions_path, class: "text-gray-400 hover:text-gray-600" %><span class="mx-2 text-gray-300">/</span>
  <span class="text-gray-700 font-medium"><%= @subscription.name %></span>
<% end %>
<div class="max-w-xl">
  <%= render Ui::PageHeaderComponent.new(title: "Secret of #{@subscription.name}") %>
  <div class="mt-6 rounded-md bg-amber-50 border border-amber-200 p-4 space-y-3">
    <p class="text-sm text-amber-800">Copy this secret now: it signs every delivery, and it will not be shown again.</p>
    <code class="block break-all rounded bg-white border border-amber-200 px-3 py-2 text-sm font-mono text-gray-900"><%= @secret %></code>
    <p class="text-xs text-amber-800">Each call carries <code>X-LedgerFlow-Signature: t=…,v1=…</code>: the HMAC-SHA256 of <code>"timestamp.body"</code> with this secret. Check it on the raw body, and refuse a timestamp older than five minutes. After a new secret, the old one signs too for a day, so you can change over without a gap.</p>
  </div>
  <%= link_to "Back to webhooks", accounting_settings_webhook_subscriptions_path, class: "inline-block mt-6 text-sm text-primary-600 hover:text-primary-800" %>
</div>
