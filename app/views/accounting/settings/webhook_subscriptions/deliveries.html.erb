<% content_for :breadcrumb do %>
  <%= link_to "Settings", accounting_settings_root_path, class: "text-gray-400 hover:text-gray-600" %><span class="mx-2 text-gray-300">/</span>
  <%= link_to "Webhooks", accounting_settings_webhook_subscriptions_path, class: "text-gray-400 hover:text-gray-600" %><span class="mx-2 text-gray-300">/</span>
  <span class="text-gray-700 font-medium"><%= @subscription.name %></span>
<% end %>
<div class="max-w-5xl">
  <%= render Ui::PageHeaderComponent.new(title: "Deliveries of #{@subscription.name}", description: @subscription.url) %>

  <% if @subscription.suspended? %>
    <div class="mt-4 rounded-md bg-red-50 border border-red-200 p-4 text-sm text-red-800 flex items-center justify-between" data-section="suspended">
      <span>Suspended on <%= l(@subscription.suspended_at, format: :short) %>: <%= @subscription.suspended_reason %>. New events are not sent while it is suspended.</span>
      <%= button_to "Resume", resume_accounting_settings_webhook_subscription_path(@subscription), method: :post, class: "px-3 py-1 rounded-md bg-red-700 text-white text-sm" %>
    </div>
  <% end %>

  <div class="mt-6 bg-white rounded-lg border border-gray-200 overflow-x-clip">
    <table class="min-w-full divide-y divide-gray-200 text-sm" data-section="deliveries">
      <thead class="bg-gray-50"><tr>
        <% %w[When Event Status Attempts Answer Next\ attempt].each do |h| %><th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider"><%= h %></th><% end %>
        <th class="px-4 py-3"></th>
      </tr></thead>
      <tbody class="divide-y divide-gray-100">
        <% @deliveries.each do |delivery| %>
          <tr>
            <td class="px-4 py-3 text-gray-600"><%= l(delivery.created_at, format: :short) %></td>
            <td class="px-4 py-3 font-mono"><%= delivery.event %><%= " (again)" if delivery.replay_of_id %></td>
            <td class="px-4 py-3"><%= delivery.status.humanize %></td>
            <td class="px-4 py-3 text-gray-600"><%= delivery.attempts %></td>
            <td class="px-4 py-3 text-gray-600"><%= delivery.last_response_code || delivery.last_error %></td>
            <td class="px-4 py-3 text-gray-500"><%= delivery.next_attempt_at ? l(delivery.next_attempt_at, format: :short) : "—" %></td>
            <td class="px-4 py-3 text-right">
              <%= button_to "Send again", replay_delivery_accounting_settings_webhook_subscription_path(@subscription, delivery_id: delivery.id), method: :post, class: "text-sm text-primary-600 hover:text-primary-800" %>
            </td>
          </tr>
        <% end %>
        <% if @deliveries.empty? %><tr><td colspan="7" class="px-4 py-12 text-center text-sm text-gray-400">Nothing sent yet.</td></tr><% end %>
      </tbody>
    </table>
  </div>
</div>
