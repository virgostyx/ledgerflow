<% content_for :breadcrumb do %>
  <%= link_to "Settings", accounting_settings_root_path, class: "text-gray-400 hover:text-gray-600" %>
  <span class="mx-2 text-gray-300">/</span>
  <%= link_to "API Clients", accounting_settings_api_clients_path, class: "text-gray-400 hover:text-gray-600" %>
  <span class="mx-2 text-gray-300">/</span>
  <span class="text-gray-700 font-medium">New</span>
<% end %>

<div class="max-w-xl">
  <%= render Ui::PageHeaderComponent.new(title: "New API Client") %>

  <%= form_with model: @client, url: accounting_settings_api_clients_path, class: "mt-6 space-y-5" do |f| %>
    <% if @client.errors.any? %>
      <div class="rounded-md bg-danger-50 border border-danger-200 p-4">
        <ul class="list-disc list-inside text-sm text-danger-700 space-y-1">
          <% @client.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= f.label :name, "Application name", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :name, placeholder: "e.g. BudgetFlow",
            class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-primary-500 focus:border-primary-500" %>
    </div>

    <fieldset>
      <legend class="block text-sm font-medium text-gray-700 mb-2">Permissions</legend>
      <%= f.collection_check_boxes :scopes, ApiClient::SCOPES, :itself, :itself do |b| %>
        <label class="flex items-center gap-2 text-sm font-mono text-gray-700 mb-1">
          <%= b.check_box(class: "rounded border-gray-300") %> <%= b.text %>
        </label>
      <% end %>
    </fieldset>

    <div class="flex gap-3">
      <%= f.submit "Create", class: "px-4 py-2 rounded-md bg-primary-600 text-white text-sm font-medium hover:bg-primary-700" %>
      <%= link_to "Cancel", accounting_settings_api_clients_path, class: "px-4 py-2 text-sm text-gray-600 hover:text-gray-900" %>
    </div>
  <% end %>
</div>
