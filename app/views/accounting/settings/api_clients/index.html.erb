<% content_for :breadcrumb do %>
  <%= link_to "Settings", accounting_settings_root_path, class: "text-gray-400 hover:text-gray-600" %>
  <span class="mx-2 text-gray-300">/</span>
  <span class="text-gray-700 font-medium">API Clients</span>
<% end %>

<% content_for :actions do %>
  <%= link_to "New API Client", new_accounting_settings_api_client_path,
        class: "inline-flex items-center gap-2 px-3 py-1.5 rounded-md bg-primary-600 text-white text-sm font-medium hover:bg-primary-700 transition-colors" %>
<% end %>

<div class="max-w-5xl">
  <%= render Ui::PageHeaderComponent.new(title: "API Clients") %>

  <div class="mt-6 bg-white rounded-lg border border-gray-200 overflow-x-clip">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <% %w[Name Owner Scopes Status].each do |h| %>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider"><%= h %></th>
          <% end %>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Last used</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @clients.each do |client| %>
          <tr class="<%= client.active? ? '' : 'opacity-50' %> hover:bg-gray-50">
            <td class="px-4 py-3 text-sm font-medium text-gray-900"><%= client.name %></td>
            <td class="px-4 py-3 text-sm text-gray-600"><%= client.owner&.full_name || "none (rotate the key to assign you)" %></td>
            <td class="px-4 py-3 text-sm font-mono text-gray-600"><%= client.scopes.join(", ").presence || "—" %></td>
            <td class="px-4 py-3">
              <% if client.active? %>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-emerald-100 text-emerald-700">Active</span>
              <% else %>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-500">Revoked</span>
              <% end %>
            </td>
            <td class="px-4 py-3 text-sm text-gray-500"><%= client.last_used_at ? l(client.last_used_at, format: :short) : "Never" %></td>
            <td class="px-4 py-3 text-right">
              <% if client.active? %>
                <div class="flex items-center justify-end gap-3">
                  <%= button_to "Rotate key", rotate_accounting_settings_api_client_path(client), method: :post,
                        data: { turbo_confirm: "Issue a new key? The current one stops working immediately." },
                        class: "text-sm text-primary-600 hover:text-primary-800" %>
                  <%= button_to "Revoke", revoke_accounting_settings_api_client_path(client), method: :patch,
                        data: { turbo_confirm: "Revoke #{client.name}? This cannot be undone." },
                        class: "text-sm text-danger-600 hover:text-danger-800" %>
                </div>
              <% end %>
            </td>
          </tr>
        <% end %>
        <% if @clients.empty? %>
          <tr><td colspan="5" class="px-4 py-12 text-center text-sm text-gray-400">No API clients yet.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
