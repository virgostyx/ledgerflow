<% content_for :breadcrumb do %>
  <%= link_to "Settings", accounting_settings_root_path, class: "text-gray-400 hover:text-gray-600" %>
  <span class="mx-2 text-gray-300">/</span>
  <span class="text-gray-700 font-medium">Journals</span>
<% end %>

<% content_for :actions do %>
  <%= link_to new_accounting_settings_journal_path,
        class: "inline-flex items-center gap-2 px-3 py-1.5 rounded-md bg-primary-600 text-white text-sm font-medium hover:bg-primary-700 transition-colors" do %>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
    </svg>
    New Journal
  <% end %>
<% end %>

<div class="max-w-5xl">
  <%= render Ui::PageHeaderComponent.new(title: "Journals") %>

  <div class="mt-6 bg-white rounded-lg border border-gray-200 overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Code</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Label</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Type</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Counterpart Account</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Sequence Prefix</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Status</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @journals.each do |journal| %>
          <tr class="<%= journal.active? ? '' : 'opacity-50' %> hover:bg-gray-50">
            <td class="px-4 py-3 text-sm font-mono font-medium text-gray-900"><%= journal.code %></td>
            <td class="px-4 py-3 text-sm text-gray-700"><%= journal.label_fr %></td>
            <td class="px-4 py-3">
              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-indigo-100 text-indigo-700 capitalize">
                <%= journal.journal_type %>
              </span>
            </td>
            <td class="px-4 py-3 text-sm text-gray-500">
              <% if journal.default_account %>
                <span class="font-mono"><%= journal.default_account.code %></span>
                <span class="text-gray-400 ml-1"><%= journal.default_account.label_fr %></span>
              <% else %>
                <span class="text-gray-300">—</span>
              <% end %>
            </td>
            <td class="px-4 py-3 text-sm font-mono text-gray-500"><%= journal.sequence_prefix %></td>
            <td class="px-4 py-3">
              <% if journal.active? %>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-emerald-100 text-emerald-700">Active</span>
              <% else %>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-500">Inactive</span>
              <% end %>
            </td>
            <td class="px-4 py-3 text-right">
              <div class="flex items-center justify-end gap-2">
                <%= link_to edit_accounting_settings_journal_path(journal),
                      class: "text-sm text-primary-600 hover:text-primary-800" do %>
                  Edit
                <% end %>

                <%= button_to toggle_active_accounting_settings_journal_path(journal),
                      method: :patch,
                      class: "text-sm text-gray-500 hover:text-gray-700" do %>
                  <%= journal.active? ? "Deactivate" : "Activate" %>
                <% end %>

                <% if journal.destroyable? %>
                  <%= button_to accounting_settings_journal_path(journal),
                        method: :delete,
                        data: { confirm: "Delete journal #{journal.code}? This cannot be undone." },
                        class: "text-sm text-danger-600 hover:text-danger-800" do %>
                    Delete
                  <% end %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>

        <% if @journals.empty? %>
          <tr>
            <td colspan="7" class="px-4 py-12 text-center text-sm text-gray-400">
              No journals configured yet.
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
