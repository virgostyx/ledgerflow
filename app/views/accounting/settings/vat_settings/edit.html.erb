<% content_for :breadcrumb do %>
  <%= link_to "Settings", accounting_settings_root_path, class: "text-gray-400 hover:text-gray-600" %>
  <span class="mx-2 text-gray-300">/</span>
  <span class="text-gray-700 font-medium">VAT Settings</span>
<% end %>

<div class="max-w-2xl">
  <%= render Ui::PageHeaderComponent.new(title: "VAT Settings") %>

  <div class="mt-6 bg-white rounded-lg border border-gray-200 p-6">
    <%= form_with model: @entity, url: accounting_settings_vat_settings_path, method: :patch,
          scope: :entity, class: "space-y-5" do |f| %>

      <% if @entity.errors.any? %>
        <div class="rounded-md bg-danger-50 border border-danger-200 p-4">
          <ul class="list-disc list-inside text-sm text-danger-700 space-y-1">
            <% @entity.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="grid grid-cols-2 gap-5">
        <div>
          <%= f.label :vat_filing_frequency, "Filing Frequency", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.select :vat_filing_frequency,
                Entity.vat_filing_frequencies.keys.map { |v| [v.capitalize, v] },
                {},
                class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-primary-500 focus:border-primary-500" %>
          <p class="mt-1 text-xs text-gray-400">How often periodic VAT declarations are due.</p>
        </div>

        <div>
          <%= f.label :vat_regime, "Regime", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.select :vat_regime,
                Entity.vat_regimes.keys.map { |v| [v.capitalize, v] },
                {},
                class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-primary-500 focus:border-primary-500" %>
          <p class="mt-1 text-xs text-gray-400">Franchise (VAT-exempt small business) has no periodic filing obligation.</p>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-5">
        <div>
          <%= f.label :vat_scheme, "Deduction Scheme", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.select :vat_scheme,
                Entity.vat_schemes.keys.map { |v| [v.capitalize, v] },
                {},
                class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-primary-500 focus:border-primary-500" %>
          <p class="mt-1 text-xs text-gray-400">Mixed enables prorata deduction and the year-end regularization page.</p>
        </div>

        <div>
          <%= f.label :vat_prorata_rate, "Provisional Prorata Rate (%)", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.number_field :vat_prorata_rate, step: "0.01", min: "0", max: "100",
                class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-primary-500 focus:border-primary-500",
                placeholder: "empty = full deduction" %>
          <p class="mt-1 text-xs text-gray-400">Applied to purchase VAT until regularized at year-end. Leave empty for full deduction.</p>
        </div>
      </div>

      <details data-help="vat-settings" class="rounded-md border border-gray-200 bg-gray-50 p-4 text-sm text-gray-700">
        <summary class="cursor-pointer font-medium text-gray-700"><%= t("accounting.settings.vat_settings.help.summary") %></summary>
        <div class="mt-3 space-y-3">
          <p><%= t("accounting.settings.vat_settings.help.franchise") %></p>
          <p><%= t("accounting.settings.vat_settings.help.mixed") %></p>
          <p><%= t("accounting.settings.vat_settings.help.prorata") %></p>
        </div>
      </details>

      <div class="flex items-center gap-3 pt-2">
        <%= f.submit "Save VAT Settings",
              class: "px-4 py-2 rounded-md bg-primary-600 text-white text-sm font-medium hover:bg-primary-700 transition-colors cursor-pointer" %>
        <%= link_to "Cancel", accounting_settings_root_path,
              class: "px-4 py-2 rounded-md border border-gray-300 text-gray-700 text-sm font-medium hover:bg-gray-50 transition-colors" %>
      </div>
    <% end %>
  </div>
</div>
