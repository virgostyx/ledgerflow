<% content_for :breadcrumb do %>
  <%= link_to "Settings", accounting_settings_root_path, class: "text-gray-400 hover:text-gray-600" %>
  <span class="mx-2 text-gray-300">/</span>
  <%= link_to "Analytical Axes", accounting_settings_analytical_axes_path, class: "text-gray-400 hover:text-gray-600" %>
  <span class="mx-2 text-gray-300">/</span>
  <span class="text-gray-700 font-medium">Edit <%= @account.code %></span>
<% end %>

<div class="max-w-2xl">
  <%= render Ui::PageHeaderComponent.new(title: "Edit Analytical Account — #{@account.code}") %>
  <div class="mt-6 bg-white rounded-lg border border-gray-200 p-6">
    <%= render "form", account: @account, axis: @account.analytical_axis %>
  </div>
</div>
