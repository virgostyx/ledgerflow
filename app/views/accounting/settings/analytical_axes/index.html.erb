<% content_for :breadcrumb do %>
  <%= link_to "Settings", accounting_settings_root_path, class: "text-gray-400 hover:text-gray-600" %>
  <span class="mx-2 text-gray-300">/</span>
  <span class="text-gray-700 font-medium">Analytical Accounts</span>
<% end %>

<div class="max-w-5xl">
  <%= render Ui::PageHeaderComponent.new(title: "Analytical Axes") %>

  <div class="mt-6 space-y-6">
    <% @axes.each do |axis| %>
      <div class="bg-white rounded-lg border border-gray-200 overflow-hidden">
        <div class="px-5 py-4 flex items-center justify-between border-b border-gray-100">
          <div class="flex items-center gap-3">
            <span class="font-mono text-sm font-semibold text-gray-700 bg-gray-100 px-2 py-1 rounded"><%= axis.code %></span>
            <span class="text-gray-900 font-medium"><%= axis.label_fr %></span>
            <% unless axis.active? %>
              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-500">Inactive</span>
            <% end %>
            <% if axis.required_for_account_classes.any? %>
              <span class="text-xs text-gray-500">
                Required for class <%= axis.required_for_account_classes.sort.join(", ") %>
              </span>
            <% end %>
          </div>
          <div class="flex items-center gap-3">
            <%= link_to new_accounting_settings_analytical_axis_analytical_account_path(axis),
                  class: "text-sm text-primary-600 hover:text-primary-800" do %>
              + Add account
            <% end %>
            <%= link_to "Edit axis", edit_accounting_settings_analytical_axis_path(axis),
                  class: "text-sm text-gray-500 hover:text-gray-700" %>
          </div>
        </div>

        <% accounts = axis.analytical_accounts.ordered %>
        <% if accounts.any? %>
          <table class="min-w-full divide-y divide-gray-100">
            <tbody class="divide-y divide-gray-50">
              <% accounts.each do |account| %>
                <tr class="<%= account.active? ? '' : 'opacity-50' %> hover:bg-gray-50">
                  <td class="px-5 py-2.5 text-sm font-mono text-gray-600 w-36"><%= account.code %></td>
                  <td class="px-5 py-2.5 text-sm text-gray-700"><%= account.label_fr %></td>
                  <td class="px-5 py-2.5 text-right">
                    <div class="flex items-center justify-end gap-3">
                      <%= link_to "Edit", edit_accounting_settings_analytical_account_path(account),
                            class: "text-sm text-primary-600 hover:text-primary-800" %>
                      <% if account.destroyable? %>
                        <%= button_to accounting_settings_analytical_account_path(account),
                              method: :delete,
                              data: { confirm: "Delete #{account.code}?" },
                              class: "text-sm text-danger-600 hover:text-danger-800" do %>
                          Delete
                        <% end %>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <p class="px-5 py-6 text-sm text-center text-gray-400">No accounts yet for this axis.</p>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
