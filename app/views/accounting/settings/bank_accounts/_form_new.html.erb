<%# Form for creating a new bank account (also creates the bank journal) %>
<%= form_with url: accounting_settings_bank_accounts_path,
      scope: :bank_account_form,
      class: "space-y-5" do |f| %>

  <% if flash[:alert] %>
    <div class="rounded-md bg-danger-50 border border-danger-200 p-4">
      <p class="text-sm text-danger-700"><%= flash[:alert] %></p>
    </div>
  <% end %>

  <div class="rounded-md bg-blue-50 border border-blue-200 p-4">
    <p class="text-sm text-blue-700">
      Creating a bank account will automatically create the associated bank journal.
    </p>
  </div>

  <div class="grid grid-cols-2 gap-5">
    <div class="relative" data-controller="floating-label">
      <%= f.text_field :label_fr,
            placeholder: " ",
            class: "block w-full rounded-lg border border-gray-300 px-3 py-3 text-sm text-gray-900 bg-transparent focus:outline-none focus:ring-2 focus:ring-primary-500",
            data: { floating_label_target: "input", action: "focus->floating-label#focus blur->floating-label#blur" } %>
      <%= f.label :label_fr, "Account Label", class: "lf-floating-label", data: { floating_label_target: "label" } %>
    </div>

    <div class="relative" data-controller="floating-label">
      <%= f.text_field :label_nl,
            placeholder: " ",
            class: "block w-full rounded-lg border border-gray-300 px-3 py-3 text-sm text-gray-900 bg-transparent focus:outline-none focus:ring-2 focus:ring-primary-500",
            data: { floating_label_target: "input", action: "focus->floating-label#focus blur->floating-label#blur" } %>
      <%= f.label :label_nl, "Label (NL)", class: "lf-floating-label", data: { floating_label_target: "label" } %>
    </div>
  </div>

  <div>
    <div class="relative" data-controller="floating-label">
      <%= f.text_field :journal_code,
            maxlength: 8,
            placeholder: " ",
            class: "block w-full rounded-lg border border-gray-300 px-3 py-3 text-sm font-mono text-gray-900 bg-transparent focus:outline-none focus:ring-2 focus:ring-primary-500",
            data: { floating_label_target: "input", action: "focus->floating-label#focus blur->floating-label#blur" } %>
      <%= f.label :journal_code, "Journal Code", class: "lf-floating-label", data: { floating_label_target: "label" } %>
    </div>
    <p class="mt-1 text-xs text-gray-400">Unique code for the bank journal (max 8 chars).</p>
  </div>

  <div>
    <%= render Accounting::AccountSelectComponent.new(
          accounts: @accounts_55,
          name:     "bank_account_form[default_account_id]",
          selected: nil,
          label:    "Counterpart Account (55xxxx)",
          prompt:   "— Select a 55xxxx account —"
        ) %>
  </div>

  <div class="grid grid-cols-2 gap-5">
    <div class="relative" data-controller="floating-label">
      <%= f.text_field :iban,
            placeholder: " ",
            class: "block w-full rounded-lg border border-gray-300 px-3 py-3 text-sm font-mono text-gray-900 bg-transparent focus:outline-none focus:ring-2 focus:ring-primary-500",
            data: { floating_label_target: "input", action: "focus->floating-label#focus blur->floating-label#blur" } %>
      <%= f.label :iban, "IBAN", class: "lf-floating-label", data: { floating_label_target: "label" } %>
    </div>

    <div class="relative" data-controller="floating-label">
      <%= f.text_field :bic,
            placeholder: " ",
            class: "block w-full rounded-lg border border-gray-300 px-3 py-3 text-sm font-mono text-gray-900 bg-transparent focus:outline-none focus:ring-2 focus:ring-primary-500",
            data: { floating_label_target: "input", action: "focus->floating-label#focus blur->floating-label#blur" } %>
      <%= f.label :bic, "BIC / SWIFT", class: "lf-floating-label", data: { floating_label_target: "label" } %>
    </div>
  </div>

  <div class="relative" data-controller="floating-label">
    <%= f.text_area :notes, rows: 2,
          placeholder: " ",
          class: "block w-full rounded-lg border border-gray-300 px-3 py-3 text-sm text-gray-900 bg-transparent focus:outline-none focus:ring-2 focus:ring-primary-500",
          data: { floating_label_target: "input", action: "focus->floating-label#focus blur->floating-label#blur" } %>
    <%= f.label :notes, "Notes", class: "lf-floating-label", data: { floating_label_target: "label" } %>
  </div>

  <div class="flex items-center gap-3 pt-2">
    <%= f.submit "Create Bank Account",
          class: "px-4 py-2 rounded-md bg-primary-600 text-white text-sm font-medium hover:bg-primary-700 transition-colors cursor-pointer" %>
    <%= link_to "Cancel", accounting_settings_bank_accounts_path,
          class: "px-4 py-2 rounded-md border border-gray-300 text-gray-700 text-sm font-medium hover:bg-gray-50 transition-colors" %>
  </div>

<% end %>
