<% content_for :breadcrumb do %>
  <%= link_to "Settings", accounting_settings_root_path, class: "text-gray-400 hover:text-gray-600" %>
  <span class="mx-2 text-gray-300">/</span>
  <span class="text-gray-700 font-medium">Bank Accounts</span>
<% end %>

<% content_for :actions do %>
  <%= link_to new_accounting_settings_bank_account_path,
        class: "inline-flex items-center gap-2 px-3 py-1.5 rounded-md bg-primary-600 text-white text-sm font-medium hover:bg-primary-700 transition-colors" do %>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
    </svg>
    New Bank Account
  <% end %>
<% end %>

<div class="max-w-5xl">
  <%= render Ui::PageHeaderComponent.new(
        title: "Bank Accounts",
        description: "Each bank account is linked to its own bank journal."
      ) %>

  <div class="mt-6 bg-white rounded-lg border border-gray-200 overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Journal</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Label</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">IBAN</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">BIC</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Balance</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Status</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @bank_accounts.each do |account| %>
          <tr class="<%= account.active? ? '' : 'opacity-50' %> hover:bg-gray-50">
            <td class="px-4 py-3 text-sm font-mono font-medium text-gray-900">
              <%= account.journal.code %>
            </td>
            <td class="px-4 py-3 text-sm text-gray-700"><%= account.label_fr %></td>
            <td class="px-4 py-3 text-sm font-mono text-gray-600">
              <%= account.iban.gsub(/(.{4})/, '\1 ').strip %>
            </td>
            <td class="px-4 py-3 text-sm font-mono text-gray-500"><%= account.bic %></td>
            <td class="px-4 py-3 text-sm text-right font-mono text-gray-700">
              <%= number_to_currency(account.balance_from_transactions, unit: "€", separator: ",", delimiter: " ", format: "%n %u") %>
            </td>
            <td class="px-4 py-3">
              <% if account.active? %>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-emerald-100 text-emerald-700">Active</span>
              <% else %>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-500">Inactive</span>
              <% end %>
            </td>
            <td class="px-4 py-3 text-right">
              <div class="flex items-center justify-end gap-2">
                <%= link_to edit_accounting_settings_bank_account_path(account),
                      class: "text-sm text-primary-600 hover:text-primary-800" do %>
                  Edit
                <% end %>
                <% if account.destroyable? %>
                  <%= button_to accounting_settings_bank_account_path(account),
                        method: :delete,
                        data: { confirm: "Delete bank account #{account.iban}? This cannot be undone." },
                        class: "text-sm text-danger-600 hover:text-danger-800" do %>
                    Delete
                  <% end %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>

        <% if @bank_accounts.empty? %>
          <tr>
            <td colspan="7" class="px-4 py-12 text-center text-sm text-gray-400">
              No bank accounts configured yet.
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
