<% content_for :breadcrumb do %>
  <%= render Ui::BreadcrumbsComponent.new(items: [ { label: "Settings", path: accounting_settings_root_path }, { label: "Users and roles" } ]) %>
<% end %>

<div class="max-w-5xl">
  <h1 class="mb-1 text-2xl font-bold text-gray-900">Users and roles</h1>
  <p class="mb-2 text-sm"><%= link_to "Custom roles", accounting_settings_custom_roles_path, class: "font-medium text-primary-700 hover:underline" %></p>
  <p class="mb-6 text-sm text-gray-500">Who can work in this entity. Removing an access (deactivating it) or letting it expire applies on the person's next request. The entity always keeps at least one owner.</p>

  <%= form_with scope: :membership, url: accounting_settings_memberships_path, class: "mb-8 grid grid-cols-1 gap-4 rounded-lg border border-gray-200 bg-white p-4 md:grid-cols-5 items-end" do |f| %>
    <div><%= f.label :email, "Email", class: "block text-sm font-medium text-gray-700" %>
      <%= f.email_field :email, required: true, class: "mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm" %></div>
    <div><%= f.label :full_name, "Name", class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :full_name, class: "mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm" %></div>
    <div><%= f.label :role, "Role", class: "block text-sm font-medium text-gray-700" %>
      <%= f.select :role, UserEntity.options_for_select, { selected: "accountant" }, class: "mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm" %></div>
    <div><%= f.label :valid_until, "Access until (required for an external auditor)", class: "block text-sm font-medium text-gray-700" %>
      <%= f.date_field :valid_until, class: "mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm" %></div>
    <div><%= f.submit "Invite", class: "btn-primary" %></div>
  <% end %>

  <table class="min-w-full divide-y divide-gray-200 text-sm" id="memberships">
    <thead class="text-left text-xs font-medium uppercase tracking-wider text-gray-500">
      <tr><th class="py-2">Person</th><th>Role</th><th>Access until</th><th>Journals</th><th>Active</th><th></th></tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% @memberships.each do |m| %>
        <% form_id = "membership-form-#{m.id}" %>
        <tr>
          <td class="py-2"><span class="font-medium text-gray-900"><%= m.user.full_name %></span><br><span class="text-xs text-gray-500"><%= m.user.email %></span></td>
          <td><%= select_tag "membership[role]", grouped_options_for_select({ "System roles" => UserEntity.options_for_select, "Custom roles" => @custom_roles.map { |r| [ r.name, "custom:#{r.id}" ] } }.reject { |_, v| v.empty? }, m.custom_role_id ? "custom:#{m.custom_role_id}" : m.role), form: form_id, class: "rounded-md border border-gray-300 px-2 py-1 text-sm" %></td>
          <td><%= date_field_tag "membership[valid_until]", m.valid_until, form: form_id, class: "rounded-md border border-gray-300 px-2 py-1 text-sm" %></td>
          <td>
            <%= select_tag "membership[journal_ids][]", options_for_select(@journals.map { |j| [ "#{j.code} #{j.label_fr}", j.id ] }, m.journal_ids), multiple: true, include_hidden: true, form: form_id,
                  class: "rounded-md border border-gray-300 px-2 py-1 text-xs", size: [ @journals.size, 4 ].min.clamp(1, 4), "aria-label": "Journals (none ticked: all)" %>
            <span class="block text-xs text-gray-400">None selected: all</span>
          </td>
          <td><%= hidden_field_tag "membership[active]", "0", id: nil, form: form_id %><%= check_box_tag "membership[active]", "1", m.active, id: "membership_active_#{m.id}", form: form_id, class: "rounded border-gray-300" %></td>
          <td>
            <%= form_with url: accounting_settings_membership_path(m), method: :patch, id: form_id do %>
              <%= submit_tag "Save", class: "text-xs font-medium text-primary-700 hover:underline cursor-pointer" %>
            <% end %>
            <% if m.user.totp_enabled? && m.user_id != current_user.id %>
              <%= form_with url: reset_two_factor_accounting_settings_membership_path(m), method: :post, class: "mt-1 flex gap-1" do %>
                <%= text_field_tag :reason, nil, placeholder: "Reason", required: true, class: "w-24 rounded-md border border-gray-300 px-1 py-0.5 text-xs" %>
                <%= submit_tag "Reset 2FA", class: "text-xs font-medium text-red-700 hover:underline cursor-pointer", data: { turbo_confirm: "Reset the second factor of #{m.user.full_name}?" } %>
              <% end %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
