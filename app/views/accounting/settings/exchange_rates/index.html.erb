<% content_for :breadcrumb do %>
  <%= link_to "Settings", accounting_settings_root_path, class: "text-gray-400 hover:text-gray-600" %>
  <span class="mx-2 text-gray-300">/</span>
  <span class="text-gray-700 font-medium">Exchange rates</span>
<% end %>

<div class="max-w-3xl">
  <%= render Ui::PageHeaderComponent.new(title: "Exchange rates") %>
  <p class="mt-2 text-sm text-gray-500">EUR for 1 unit of the currency (same convention as invoices). The latest rate on or before a date is used.</p>

  <%= form_with model: @rate, url: accounting_settings_exchange_rates_path, class: "mt-4 flex flex-wrap gap-3 items-end" do |f| %>
    <%= f.text_field :currency, maxlength: 3, placeholder: "USD", required: true, class: "rounded-md border-gray-300 text-sm uppercase w-24" %>
    <%= f.date_field :rate_date, required: true, class: "rounded-md border-gray-300 text-sm" %>
    <%= f.text_field :rate, placeholder: "0.951200", required: true, class: "rounded-md border-gray-300 text-sm font-mono w-32" %>
    <%= f.submit "Add rate", class: "px-4 py-2 rounded-md bg-primary-600 text-white text-sm font-medium hover:bg-primary-700 cursor-pointer" %>
  <% end %>

  <div class="mt-6 bg-white rounded-lg border border-gray-200 overflow-x-clip">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <% %w[Date Currency Rate].each do |h| %>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider"><%= h %></th>
          <% end %>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @rates.each do |rate| %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-3 text-sm text-gray-700"><%= rate.rate_date %></td>
            <td class="px-4 py-3 text-sm font-mono text-gray-900"><%= rate.currency %></td>
            <td class="px-4 py-3 text-sm font-mono text-gray-700"><%= rate.rate.to_s("F") %></td>
            <td class="px-4 py-3 text-right">
              <%= button_to "Delete", accounting_settings_exchange_rate_path(rate), method: :delete,
                    data: { turbo_confirm: "Delete this rate?" }, class: "text-xs text-red-600 hover:underline" %>
            </td>
          </tr>
        <% end %>
        <% if @rates.empty? %>
          <tr><td colspan="4" class="px-4 py-8 text-center text-sm text-gray-500">No rate yet.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
