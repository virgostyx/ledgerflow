<%# The months of a fiscal year, a padlock each; accounting and VAT per month, the fiscal year as a whole. %>
<% marks = { locked: [ "🔒", "bg-red-50 text-red-700 border-red-200", "Locked" ], partial: [ "◐", "bg-amber-50 text-amber-700 border-amber-200", "Partly locked" ],
             open: [ "🔓", "bg-green-50 text-green-700 border-green-200", "Open" ] } %>
<section class="mb-8 rounded-lg border border-gray-200 bg-white p-4" aria-label="Timeline of the fiscal year">
  <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
    <h2 class="text-sm font-semibold text-gray-900">Fiscal year <%= timeline.fiscal_year.year %></h2>
    <%= form_with url: accounting_period_locks_path, method: :get, class: "flex items-center gap-2 text-xs" do %>
      <%= select_tag :fiscal_year_id, options_from_collection_for_select(@fiscal_years, :id, :year, timeline.fiscal_year.id), class: "rounded-md border border-gray-300 px-2 py-1" %>
      <%= submit_tag "Show", name: nil, class: "text-xs font-medium text-primary-700 hover:underline cursor-pointer" %>
    <% end %>
  </div>

  <% can_lock = policy(Accounting::PeriodLock).create? %>
  <%= form_with url: lock_months_accounting_period_locks_path, method: :post do %>
    <%= hidden_field_tag :fiscal_year_id, timeline.fiscal_year.id %>
    <div class="overflow-x-auto">
      <table class="min-w-full text-center text-xs">
        <thead class="text-gray-500">
          <tr>
            <th class="py-1 pr-3 text-left font-medium"></th>
            <% timeline.months.each do |month| %><th class="px-1 font-medium"><%= l(month, format: "%b") %></th><% end %>
          </tr>
        </thead>
        <tbody>
          <% [ [ "accounting", "Accounting" ], [ "vat", "VAT" ] ].each do |kind, label| %>
            <tr data-timeline="<%= kind %>">
              <th class="py-1 pr-3 text-left font-medium text-gray-700"><%= label %></th>
              <% timeline.months.each do |month| %>
                <% state = timeline.state(kind, month); icon, css, title = marks.fetch(state) %>
                <td class="px-1 py-1" data-month="<%= month.strftime('%Y-%m') %>" data-state="<%= state %>">
                  <span class="inline-block w-9 rounded border py-0.5 <%= css %>" title="<%= title %>"><%= icon %></span>
                  <% if kind == "accounting" && can_lock && state != :locked %>
                    <br><%= check_box_tag "months[]", month.strftime("%Y-%m"), false, id: "month_#{month.strftime('%Y_%m')}", class: "mt-1", "aria-label": "Lock #{l(month, format: '%B %Y')}" %>
                  <% end %>
                </td>
              <% end %>
            </tr>
          <% end %>
          <tr data-timeline="fiscal_year">
            <th class="py-1 pr-3 text-left font-medium text-gray-700">Year</th>
            <% state = timeline.fiscal_year_state; icon, css, title = marks.fetch(state) %>
            <td colspan="<%= timeline.months.size %>" class="px-1 py-1" data-state="<%= state %>">
              <span class="block rounded border py-0.5 <%= css %>" title="<%= title %>"><%= icon %> <%= title %></span>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
    <% if can_lock %>
      <div class="mt-3 flex flex-wrap items-end gap-3">
        <%= hidden_field_tag :kind, "accounting" %>
        <div><%= label_tag :reason, "Note (optional)", class: "block text-xs font-medium text-gray-700" %>
          <%= text_field_tag :reason, nil, class: "mt-1 rounded-md border border-gray-300 px-2 py-1 text-xs" %></div>
        <%= submit_tag "Lock the ticked months", class: "btn-primary" %>
      </div>
    <% end %>
  <% end %>
</section>
