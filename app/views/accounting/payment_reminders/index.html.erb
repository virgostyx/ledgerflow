<% content_for :breadcrumb do %>
  <%= render Ui::BreadcrumbsComponent.new(items: [
    { label: 'Dashboard', path: accounting_root_path },
    { label: 'Payment reminders' }
  ]) %>
<% end %>

<%= render Ui::PageHeaderComponent.new(title: 'Payment reminders',
      description: 'Customers with overdue invoices. One e-mail per customer lists its overdue invoices, with their PDFs attached. Two reminders to the same customer are at least 14 days apart.') %>

<% if @rows.empty? %>
  <%= render Ui::EmptyStateComponent.new(
        title: 'Nothing is overdue',
        description: 'Issued customer invoices past their due date, with an amount still due, appear here.',
        icon: :inbox
      ) %>
<% else %>
  <%= form_with url: accounting_payment_reminders_path, method: :post, data: { turbo_confirm: 'Send the selected reminders now?' } do %>
    <div class="bg-white rounded-lg border border-gray-200 overflow-x-clip">
      <table class="w-full text-sm">
        <thead class="bg-gray-50 border-b border-gray-200">
          <tr class="text-xs font-medium text-gray-500 uppercase tracking-wider">
            <th class="px-4 py-3"></th>
            <th class="px-4 py-3 text-left">Customer</th>
            <th class="px-4 py-3 text-right">Invoices</th>
            <th class="px-4 py-3 text-right">Total due</th>
            <th class="px-4 py-3 text-right">Overdue</th>
            <th class="px-4 py-3 text-left">Last reminder</th>
            <th class="px-4 py-3 text-left">Next reminder</th>
            <th class="px-4 py-3 text-left">Send to</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @rows.each do |row| %>
            <tr>
              <td class="px-4 py-3">
                <% if row.remindable %>
                  <%= check_box_tag 'partner_ids[]', row.partner.id, false, id: "partner_#{row.partner.id}" %>
                <% end %>
              </td>
              <td class="px-4 py-3 font-medium text-gray-900"><%= link_to row.partner.name, accounting_partner_path(row.partner), class: 'hover:underline' %></td>
              <td class="px-4 py-3 text-right text-gray-700"><%= row.invoices.size %></td>
              <td class="px-4 py-3 text-right font-mono text-gray-900"><%= Accounting::MoneyPresenter.new(row.total_due).format %></td>
              <td class="px-4 py-3 text-right text-gray-700"><%= pluralize(row.days_overdue, 'day') %></td>
              <td class="px-4 py-3 text-gray-600">
                <% if row.last_reminder %>
                  Reminded <%= Accounting::DatePresenter.new(row.last_reminder.created_at.to_date).format %> (level <%= row.last_reminder.level %>)
                <% else %>
                  &mdash;
                <% end %>
              </td>
              <td class="px-4 py-3 text-gray-700">
                <%= Accounting::SendPaymentReminder::SUBJECTS.fetch(row.level) %>
                <% unless row.remindable %>
                  <span class="block text-xs text-gray-400">Available <%= Accounting::DatePresenter.new(row.last_reminder.created_at.to_date + Accounting::OverdueReminders::MIN_DAYS_BETWEEN).format %></span>
                <% end %>
              </td>
              <td class="px-4 py-3">
                <% if row.remindable %>
                  <%= email_field_tag "recipients[#{row.partner.id}]", row.email, autocomplete: 'off', placeholder: 'e-mail address',
                        class: 'w-56 rounded-md border border-gray-300 px-2 py-1 text-sm focus:outline-none focus:ring-1 focus:ring-primary-500' %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="mt-4">
      <%= submit_tag 'Send reminders', class: 'px-4 py-2 bg-primary-600 text-white text-sm font-medium rounded-md hover:bg-primary-700 transition-colors cursor-pointer' %>
    </div>
  <% end %>
<% end %>
