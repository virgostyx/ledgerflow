<% content_for :breadcrumb do %>
  <%= render Ui::BreadcrumbsComponent.new(items: [
    { label: 'Dashboard', path: accounting_root_path },
    { label: 'Customer reminders', path: accounting_dunning_runs_path },
    { label: 'Rules' }
  ]) %>
<% end %>

<%= render Ui::PageHeaderComponent.new(title: 'Reminder rules',
      description: 'The levels, the texts, the minimum amount and the sender of the customer reminders.', back_path: accounting_dunning_runs_path, back_text: 'Reminders') %>

<% editable = dunning_rules_can?(:update?) %>
<% input = 'block w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-primary-500' %>
<% label = 'text-xs font-medium text-gray-500' %>

<% if @policy.errors.any? %>
  <div class="mb-4 rounded-md border border-red-200 bg-red-50 p-4 text-sm text-red-800"><%= @policy.errors.full_messages.to_sentence %></div>
<% end %>

<%= form_with model: @policy, url: accounting_dunning_policy_path, scope: :accounting_dunning_policy, method: :patch, class: 'space-y-6' do |f| %>
  <fieldset <%= 'disabled' unless editable %> class="space-y-6">
    <div class="bg-white rounded-lg border border-gray-200 p-6 space-y-4">
      <h2 class="text-sm font-semibold text-gray-900">Levels</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <% Accounting::DunningPolicy::LEVELS.each do |level| %>
          <div>
            <%= f.label "level_#{level}_days", "Level #{level} starts (days after the due date)", class: label %>
            <%= f.number_field "level_#{level}_days", min: 1, class: input %>
          </div>
        <% end %>
        <div>
          <%= f.label :min_amount, 'Minimum amount asked for (€)', class: label %>
          <%= f.number_field :min_amount, min: 0, step: '0.01', class: input %>
        </div>
        <div>
          <%= f.label :min_days_between, 'Days between two reminders of a line', class: label %>
          <%= f.number_field :min_days_between, min: 1, class: input %>
        </div>
        <div>
          <%= f.label :follow_up_days, 'Follow-up task due in (days)', class: label %>
          <%= f.number_field :follow_up_days, min: 1, class: input %>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-lg border border-gray-200 p-6 space-y-4">
      <h2 class="text-sm font-semibold text-gray-900">Charges</h2>
      <p class="text-xs text-gray-500">Nothing is added to what is asked for unless you turn it on and type the figures. Late interest and the fixed indemnity depend on the law and on your contract: the application suggests no rate.</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <% Accounting::DunningPolicy::LEVELS.each do |level| %>
          <div>
            <%= f.label "fee_#{level}", "Reminder fee, level #{level} (€, 0 = none)", class: label %>
            <%= f.number_field "fee_#{level}", min: 0, step: '0.01', class: input %>
          </div>
        <% end %>
        <div>
          <label class="flex items-center gap-2 text-sm text-gray-700"><%= f.check_box :interest_enabled, class: 'rounded border-gray-300' %> Late interest</label>
          <%= f.number_field :interest_rate, min: 0, step: '0.001', placeholder: 'yearly rate, %', class: "#{input} mt-1" %>
          <p class="mt-1 text-xs text-gray-400"><%= @policy.interest_enabled ? 'Simple interest per line, on a 365-day year.' : 'Late interest is turned off.' %></p>
        </div>
        <div>
          <label class="flex items-center gap-2 text-sm text-gray-700"><%= f.check_box :indemnity_enabled, class: 'rounded border-gray-300' %> Fixed indemnity</label>
          <%= f.number_field :indemnity_amount, min: 0, step: '0.01', placeholder: 'amount, €', class: "#{input} mt-1" %>
          <p class="mt-1 text-xs text-gray-400"><%= @policy.indemnity_enabled ? 'Added once to each reminder.' : 'The fixed indemnity is turned off.' %></p>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-lg border border-gray-200 p-6 space-y-4">
      <h2 class="text-sm font-semibold text-gray-900">Sender</h2>
      <p class="text-xs text-gray-500">E-mails leave from the application's address (its domain carries the SPF and DKIM records); replies go to the address below.</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div><%= f.label :from_name, 'Name shown as sender', class: label %><%= f.text_field :from_name, placeholder: ActsAsTenant.current_tenant.legal_name, class: input %></div>
        <div><%= f.label :reply_to, 'Replies go to', class: label %><%= f.email_field :reply_to, class: input %></div>
      </div>
      <div><%= f.label :signature, 'Signature (default: the legal name)', class: label %><%= f.text_area :signature, rows: 3, class: input %></div>
      <% if dunning_rules_can?(:auto_send?) %>
        <label class="flex items-center gap-2 text-sm text-gray-700"><%= f.check_box :auto_send_level_1, class: 'rounded border-gray-300' %> Send level 1 by e-mail by itself, every day, without validation (levels 2 and 3 and letters always wait for you)</label>
      <% else %>
        <p class="text-xs text-gray-500">Sending level 1 by itself is turned <%= @policy.auto_send_level_1 ? 'on' : 'off' %>; only the owner can change it.</p>
      <% end %>
    </div>

    <div class="bg-white rounded-lg border border-gray-200 p-6 space-y-4">
      <h2 class="text-sm font-semibold text-gray-900">Texts</h2>
      <p class="text-xs text-gray-500">Variables: <%= Accounting::DunningTexts::VARIABLES.map { |v| "{{#{v}}}" }.join(' ') %>. A text left as it is stays the built-in one.</p>
      <% Accounting::DunningPolicy::LEVELS.each do |level| %>
        <% Accounting::DunningTexts::LANGUAGES.each do |language| %>
          <% subject, body = Accounting::DunningTexts.template(@policy, level, language) %>
          <details class="border border-gray-200 rounded-md p-3">
            <summary class="text-sm text-gray-800 cursor-pointer">Level <%= level %>, <%= { 'fr' => 'French', 'nl' => 'Dutch', 'en' => 'English' }.fetch(language) %>: <%= subject %></summary>
            <div class="mt-3 space-y-2">
              <%= text_field_tag "accounting_dunning_policy[templates][#{level}][#{language}][subject]", subject, class: input, 'aria-label': "Subject, level #{level}, #{language}" %>
              <%= text_area_tag "accounting_dunning_policy[templates][#{level}][#{language}][body]", body, rows: 10, class: "#{input} font-mono", 'aria-label': "Text, level #{level}, #{language}" %>
            </div>
          </details>
        <% end %>
      <% end %>
    </div>
  </fieldset>
  <% if editable %>
    <%= f.submit 'Save the rules', class: 'px-4 py-2 bg-primary-600 text-white text-sm font-medium rounded-md hover:bg-primary-700 transition-colors cursor-pointer' %>
  <% end %>
<% end %>
