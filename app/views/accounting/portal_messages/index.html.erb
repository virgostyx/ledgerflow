<%= render Ui::PageHeaderComponent.new(title: "Messages with the client") %>
<section class="rounded-lg border border-gray-200 bg-white p-4 text-sm">
  <% entries = (@messages + @files.to_a).sort_by(&:created_at) %>
  <% if entries.empty? %><p class="text-gray-600">No message yet.</p><% end %>
  <ul class="space-y-2">
    <% entries.each do |entry| %>
      <li class="rounded border border-gray-200 p-2">
        <% if entry.is_a?(Portal::Message) %>
          <strong><%= entry.author_kind == "firm" ? "The firm" : entry.portal_user&.full_name %></strong> <span class="text-xs text-gray-600"><%= l(entry.created_at, format: :short) %></span>
          <p class="whitespace-pre-line"><%= entry.body %></p>
          <% if entry.author_kind == "client" && !entry.task_id %><%= button_to "Make a task", convert_accounting_portal_message_path(entry), class: "text-xs underline cursor-pointer" %><% end %>
        <% else %>
          <strong><%= entry.portal_user&.full_name %></strong> sent a document: <%= entry.filename %> (<%= entry.client_status_label %>)
        <% end %>
      </li>
    <% end %>
  </ul>
  <%= form_with url: accounting_portal_messages_path, class: "mt-3 space-y-2" do %>
    <%= label_tag :body, "Answer", class: "block font-medium" %>
    <%= text_area_tag :body, nil, rows: 3, maxlength: Portal::Message::MAX_BODY, class: "w-full rounded border border-gray-300 px-2 py-1" %>
    <p class="text-xs text-gray-600">A message is not an accounting instruction nor a formal agreement. The clients are told that you wrote, not what.</p>
    <%= submit_tag "Send", class: "rounded-md bg-primary-600 px-4 py-2 text-white cursor-pointer" %>
  <% end %>
</section>
