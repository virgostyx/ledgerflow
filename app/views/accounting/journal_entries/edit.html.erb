<% content_for :breadcrumb do %>
  <%= render Ui::BreadcrumbsComponent.new(items: [
    { label: 'Dashboard', path: accounting_root_path },
    { label: 'Journal Entries', path: accounting_journal_entries_path },
    { label: @entry.reference || 'Draft', path: accounting_journal_entry_path(@entry) },
    { label: 'Edit' }
  ]) %>
<% end %>

<%= render Ui::PageHeaderComponent.new(
      title: 'Edit Entry',
      back_path: accounting_journal_entry_path(@entry),
      back_text: @entry.reference || 'Draft'
    ) %>

<%= render ::Layouts::JournalEntryFormComponent.new(
      entry:    @entry,
      journals: @journals,
      accounts: @accounts
    ) %>
