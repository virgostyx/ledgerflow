<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-lg font-semibold text-indigo-700"><%= @entry.reference || 'Draft' %></h1>
    <p class="text-sm text-gray-500"><%= @entry.journal.label_fr %> — <%= Accounting::DatePresenter.new(@entry.entry_date).format %></p>
  </div>
  <div class="flex items-center gap-3">
    <%= render Accounting::StatusBadgeComponent.new(status: @entry.status.to_sym) %>
    <% if @entry.draft? && policy(@entry).post? %>
      <%= button_to 'Post', post_entry_accounting_journal_entry_path(@entry), method: :post,
            class: 'px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-md hover:bg-indigo-700' %>
    <% end %>
    <% if @entry.draft? && policy(@entry).update? %>
      <%= link_to 'Edit', edit_accounting_journal_entry_path(@entry),
            class: 'px-4 py-2 border border-gray-300 text-sm text-gray-700 rounded-md hover:bg-gray-50' %>
    <% end %>
  </div>
</div>

<p class="text-sm text-gray-700 mb-4"><%= @entry.description %></p>

<table class="w-full text-sm mb-6">
  <thead class="bg-gray-50 border-b border-gray-200">
    <tr>
      <th class="px-4 py-3 text-left text-xs font-medium text-gray-500">Account</th>
      <th class="px-4 py-3 text-left text-xs font-medium text-gray-500">Label</th>
      <th class="px-4 py-3 text-right text-xs font-medium text-gray-500">Debit</th>
      <th class="px-4 py-3 text-right text-xs font-medium text-gray-500">Credit</th>
    </tr>
  </thead>
  <tbody class="divide-y divide-gray-100">
    <% @entry.lines.each do |line| %>
      <tr>
        <td class="px-4 py-2 font-mono"><%= line.account.code %> — <%= line.account.label_fr %></td>
        <td class="px-4 py-2 text-gray-500"><%= line.label %></td>
        <td class="px-4 py-2 text-right font-mono"><%= Accounting::MoneyPresenter.new(line.debit).format if line.debit > 0 %></td>
        <td class="px-4 py-2 text-right font-mono"><%= Accounting::MoneyPresenter.new(line.credit).format if line.credit > 0 %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= link_to '← Back', accounting_journal_entries_path, class: 'text-sm text-gray-600 hover:text-gray-900' %>
