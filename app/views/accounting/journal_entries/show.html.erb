<% content_for :breadcrumb do %>
  <%= render Ui::BreadcrumbsComponent.new(items: [
    { label: 'Dashboard', path: accounting_root_path },
    { label: 'Journal Entries', path: accounting_journal_entries_path },
    { label: @entry.reference || 'Draft' }
  ]) %>
<% end %>

<%= render Ui::PageHeaderComponent.new(
      title: @entry.reference || 'Draft',
      description: "#{@entry.journal.label_fr} — #{Accounting::DatePresenter.new(@entry.entry_date).format}",
      back_path: accounting_journal_entries_path,
      back_text: 'Journal Entries'
    ) do |header| %>
  <% header.with_actions do %>
    <%= render Accounting::StatusBadgeComponent.new(status: @entry.status.to_sym) %>
    <%= task_badge(@entry) %> <%= task_link(@entry) %>
    <% if @entry.draft? && policy(@entry).post? && @period_lock.nil? %>
      <%= button_to 'Post', post_entry_accounting_journal_entry_path(@entry), method: :post,
            class: 'px-4 py-2 bg-primary-600 text-white text-sm font-medium rounded-md hover:bg-primary-700 transition-colors' %>
    <% end %>
    <% if @entry.posted? && policy(@entry).reverse? %>
      <%= link_to 'Reverse…', reversal_accounting_journal_entry_path(@entry),
            class: 'px-4 py-2 border border-red-300 text-sm text-red-700 rounded-md hover:bg-red-50 transition-colors' %>
    <% end %>
    <% if policy(Accounting::JournalEntry).create? %>
      <%= button_to 'Duplicate', duplicate_accounting_journal_entry_path(@entry), method: :post,
            class: 'px-4 py-2 border border-gray-300 text-sm text-gray-700 rounded-md hover:bg-gray-50 transition-colors cursor-pointer' %>
    <% end %>
    <% if @entry.draft? && policy(@entry).update? %>
      <%= link_to 'Edit', edit_accounting_journal_entry_path(@entry),
            class: 'px-4 py-2 border border-gray-300 text-sm text-gray-700 rounded-md hover:bg-gray-50 transition-colors' %>
    <% end %>
  <% end %>
<% end %>

<% if @period_lock %>
  <%= render "accounting/period_locks/banner", lock: @period_lock, subject: "entry", draft: @entry.draft? %>
<% end %>

<% if @entry.description.present? %>
  <p class="text-sm text-gray-600 mb-6"><%= @entry.description %></p>
<% end %>
<% if @entry.auto_reverse_on %>
  <p class="text-sm text-gray-600 mb-6">A draft reversal is planned for <%= l @entry.auto_reverse_on %>.</p>
<% end %>
<% if @entry.vat_regularisation %>
  <p class="text-sm text-amber-700 mb-6">VAT regularisation: this reversal is dated after the filed VAT period of the entry it reverses.</p>
<% end %>

<div class="bg-white rounded-lg border border-gray-200 overflow-hidden">
  <table class="w-full text-sm">
    <thead class="bg-gray-50 border-b border-gray-200">
      <tr>
        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Account</th>
        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Label</th>
        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Partner</th>
        <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Debit</th>
        <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Credit</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% @entry.lines.each do |line| %>
        <tr class="hover:bg-gray-50 transition-colors">
          <td class="px-4 py-3 font-mono text-sm text-primary-700">
            <%= line.account.code %> — <%= line.account.label_fr %>
          </td>
          <td class="px-4 py-3 text-gray-500"><%= line.label %></td>
          <td class="px-4 py-3 text-gray-500"><%= line.partner&.name %></td>
          <td class="px-4 py-3 text-right font-mono text-gray-900">
            <%= Accounting::MoneyPresenter.new(line.debit).format if line.debit > 0 %>
          </td>
          <td class="px-4 py-3 text-right font-mono text-gray-900">
            <%= Accounting::MoneyPresenter.new(line.credit).format if line.credit > 0 %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<% if feature?(:f03) && policy(Accounting::Document).index? %>
  <%= render "accounting/documents/panel", entry: @entry %>
<% end %>

<% if feature?(:f08) %>
  <%= render 'accounting/comments/thread', commentable: @entry %>
<% end %>
