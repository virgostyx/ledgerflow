<h1 class="text-lg font-semibold text-indigo-700 mb-4">Écritures comptables</h1>

<% if policy(Accounting::JournalEntry).create? %>
  <%= link_to 'Nouvelle écriture', new_accounting_journal_entry_path,
        class: 'inline-flex items-center px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-md hover:bg-indigo-700 mb-4' %>
<% end %>

<table class="w-full text-sm">
  <thead class="bg-gray-50 border-b border-gray-200">
    <tr>
      <th class="px-4 py-3 text-left text-xs font-medium text-gray-500">Référence</th>
      <th class="px-4 py-3 text-left text-xs font-medium text-gray-500">Journal</th>
      <th class="px-4 py-3 text-left text-xs font-medium text-gray-500">Date</th>
      <th class="px-4 py-3 text-left text-xs font-medium text-gray-500">Description</th>
      <th class="px-4 py-3 text-left text-xs font-medium text-gray-500">Statut</th>
      <th class="px-4 py-3"></th>
    </tr>
  </thead>
  <tbody class="divide-y divide-gray-100">
    <% @entries.each do |entry| %>
      <% presenter = Accounting::StatusPresenter.new(entry.status) %>
      <tr class="hover:bg-gray-50">
        <td class="px-4 py-3 font-mono text-indigo-700"><%= entry.reference || '—' %></td>
        <td class="px-4 py-3 text-gray-500"><%= entry.journal.code %></td>
        <td class="px-4 py-3 text-gray-500"><%= Accounting::DatePresenter.new(entry.entry_date).format %></td>
        <td class="px-4 py-3 text-gray-700"><%= entry.description %></td>
        <td class="px-4 py-3"><%= render Accounting::StatusBadgeComponent.new(status: entry.status.to_sym) %></td>
        <td class="px-4 py-3">
          <%= link_to 'Voir', accounting_journal_entry_path(entry), class: 'text-indigo-600 hover:underline text-sm' %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
