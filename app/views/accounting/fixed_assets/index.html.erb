<% content_for :breadcrumb do %>
  <%= render Ui::BreadcrumbsComponent.new(items: [
    { label: 'Dashboard', path: accounting_root_path },
    { label: 'Fixed Assets' }
  ]) %>
<% end %>

<%= render Ui::PageHeaderComponent.new(title: 'Fixed Assets') do |header| %>
  <% if policy(Accounting::FixedAsset).create? %>
    <% header.with_actions do %>
      <%= link_to 'New fixed asset', new_accounting_fixed_asset_path,
            class: 'inline-flex items-center px-4 py-2 bg-primary-600 text-white text-sm font-medium rounded-md hover:bg-primary-700 transition-colors' %>
    <% end %>
  <% end %>
<% end %>

<% if @fixed_assets.empty? %>
  <%= render Ui::EmptyStateComponent.new(
        title: 'No fixed assets yet',
        description: 'Track a capital good to run its VAT review over its 5 or 15-year period.',
        icon: :inbox
      ) do |state| %>
    <% if policy(Accounting::FixedAsset).create? %>
      <% state.with_actions do %>
        <%= link_to 'New fixed asset', new_accounting_fixed_asset_path,
              class: 'inline-flex items-center px-4 py-2 bg-primary-600 text-white text-sm font-medium rounded-md hover:bg-primary-700 transition-colors' %>
      <% end %>
    <% end %>
  <% end %>
<% else %>
  <div class="bg-white rounded-lg border border-gray-200 overflow-x-clip">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 border-b border-gray-200">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Description</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Category</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Acquisition</th>
          <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Initial VAT</th>
          <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Prorata</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Disposed</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @fixed_assets.each do |asset| %>
          <tr class="hover:bg-gray-50 transition-colors">
            <td class="px-4 py-3 text-gray-900"><%= asset.description %></td>
            <td class="px-4 py-3 text-gray-500 capitalize"><%= asset.asset_category %></td>
            <td class="px-4 py-3 text-gray-700"><%= Accounting::DatePresenter.new(asset.acquisition_date).format %></td>
            <td class="px-4 py-3 text-right font-mono text-gray-900">
              <%= Accounting::MoneyPresenter.new(asset.vat_amount_initial).format %>
            </td>
            <td class="px-4 py-3 text-right font-mono text-gray-700"><%= asset.prorata_at_acquisition %>%</td>
            <td class="px-4 py-3 text-gray-500">
              <%= asset.disposed_on ? Accounting::DatePresenter.new(asset.disposed_on).format : "—" %>
            </td>
            <td class="px-4 py-3 text-right">
              <div class="flex items-center justify-end gap-2">
                <% if policy(asset).update? %>
                  <%= link_to 'Edit', edit_accounting_fixed_asset_path(asset),
                        class: 'text-sm text-primary-600 hover:text-primary-800' %>
                <% end %>
                <% if policy(asset).destroy? %>
                  <%= button_to 'Delete', accounting_fixed_asset_path(asset),
                        method: :delete,
                        data: { turbo_confirm: "Delete '#{asset.description}'? This cannot be undone." },
                        class: 'text-sm text-danger-600 hover:text-danger-800' %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <%= render 'shared/pagination', pagy: @pagy %>
<% end %>
