<% content_for :breadcrumb do %>
  <%= render Ui::BreadcrumbsComponent.new(items: [
    { label: 'Dashboard', path: accounting_root_path },
    { label: 'Fixed Assets', path: accounting_fixed_assets_path },
    { label: "Dispose of #{@fixed_asset.description}" }
  ]) %>
<% end %>

<%= render Ui::PageHeaderComponent.new(
      title: "Dispose of #{@fixed_asset.description}",
      back_path: accounting_fixed_assets_path,
      back_text: 'Fixed Assets'
    ) %>

<div class="max-w-2xl space-y-6">
  <div class="bg-white rounded-lg border border-gray-200 p-6 text-sm text-gray-700 space-y-3">
    <p>This books the depreciation up to the disposal month, then takes the asset off the books:
      the accumulated depreciation and the net book value (account 660100) are debited, the asset account is credited at cost.</p>
    <p><strong>The sale price is not booked here.</strong> Issue a customer invoice with a line on account
      <span class="font-mono">760100</span> (Plus-values sur réalisations d'actifs) for the price: the profit or loss
      then shows as 760100 minus 660100. For an asset that is scrapped, no invoice is needed.</p>
    <dl class="grid grid-cols-2 gap-4 pt-2">
      <div>
        <dt class="text-xs font-medium text-gray-500 uppercase tracking-wider">Acquisition value</dt>
        <dd class="mt-1 font-mono"><%= Accounting::MoneyPresenter.new(@fixed_asset.acquisition_value).format %></dd>
      </div>
      <div>
        <dt class="text-xs font-medium text-gray-500 uppercase tracking-wider">Depreciation booked so far</dt>
        <dd class="mt-1 font-mono"><%= Accounting::MoneyPresenter.new(@fixed_asset.depreciation_entries.sum(:amount)).format %></dd>
      </div>
      <div>
        <dt class="text-xs font-medium text-gray-500 uppercase tracking-wider">In service since</dt>
        <dd class="mt-1"><%= Accounting::DatePresenter.new(@fixed_asset.in_service_date || @fixed_asset.acquisition_date).format %></dd>
      </div>
    </dl>
  </div>

  <%= form_with url: dispose_accounting_fixed_asset_path(@fixed_asset), method: :post, class: 'bg-white rounded-lg border border-gray-200 p-6 space-y-4' do |f| %>
    <div>
      <%= label_tag :disposed_on, 'Disposal date', class: 'block text-sm font-medium text-gray-700 mb-1' %>
      <%= date_field_tag :disposed_on, Date.current, required: true,
            class: 'block w-full max-w-xs rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-primary-500 focus:border-primary-500' %>
    </div>
    <div class="flex gap-3">
      <%= f.submit 'Dispose', class: 'btn-primary',
            data: { turbo_confirm: 'Dispose of this asset? Its depreciation and exit entries are posted and cannot be edited here.' } %>
      <%= link_to 'Cancel', accounting_fixed_assets_path, class: 'btn-secondary' %>
    </div>
  <% end %>
</div>
