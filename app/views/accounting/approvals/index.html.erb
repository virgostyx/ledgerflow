<% content_for :breadcrumb do %>
  <%= render Ui::BreadcrumbsComponent.new(items: [ { label: 'Dashboard', path: accounting_root_path }, { label: 'To approve' } ]) %>
<% end %>

<%= render Ui::PageHeaderComponent.new(title: 'To approve') do |header| %>
  <% header.with_actions do %>
    <% if policy(Approvals::Request).statistics? %>
      <%= link_to 'Statistics', statistics_accounting_approvals_path, class: 'px-4 py-2 border border-gray-300 text-sm text-gray-700 rounded-md hover:bg-gray-50' %>
    <% end %>
  <% end %>
<% end %>

<%= form_with url: accounting_approvals_path, method: :get, class: 'flex flex-wrap items-center gap-2 mb-4 text-sm' do %>
  <%= text_field_tag :supplier, params[:supplier], placeholder: 'Supplier', class: 'rounded-md border border-gray-300 px-2 py-1' %>
  <%= number_field_tag :min_amount, params[:min_amount], placeholder: 'From (EUR)', step: '0.01', class: 'w-28 rounded-md border border-gray-300 px-2 py-1' %>
  <%= number_field_tag :max_amount, params[:max_amount], placeholder: 'To (EUR)', step: '0.01', class: 'w-28 rounded-md border border-gray-300 px-2 py-1' %>
  <%= submit_tag 'Filter', class: 'px-3 py-1 bg-gray-100 rounded-md hover:bg-gray-200 cursor-pointer' %>
<% end %>

<%= form_with url: bulk_accounting_approvals_path, method: :post do %>
  <div class="bg-white rounded-lg border border-gray-200 overflow-x-auto">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 border-b border-gray-200">
        <tr>
          <% if @bulk %><th class="px-3 py-2"></th><% end %>
          <% { 'Supplier' => '', 'Invoice' => 'hidden md:table-cell', 'Due' => '', 'Amount' => '', 'Level' => 'hidden md:table-cell', 'Waiting' => 'hidden md:table-cell' }.each do |h, visibility| %><th class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase <%= visibility %>"><%= h %></th><% end %>
          <th class="px-3 py-2"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @rows.each do |row| %>
          <% request = row.request %>
          <tr>
            <% if @bulk %>
              <td class="px-3 py-2">
                <% if row.amount <= @bulk && row.warnings.empty? %>
                  <%= check_box_tag 'request_ids[]', request.id, false, id: "request_#{request.id}", class: 'rounded border-gray-300' %>
                  <%= hidden_field_tag "fingerprints[#{request.id}]", request.content_fingerprint %>
                <% end %>
              </td>
            <% end %>
            <td class="px-3 py-2 font-medium"><%= row.invoice.partner.name %></td>
            <td class="px-3 py-2 hidden md:table-cell"><%= row.invoice.invoice_number || "Draft ##{row.invoice.id}" %><%= ' (credit note)' if row.invoice.credit_note? %></td>
            <td class="px-3 py-2 <%= 'text-red-700 font-medium' if row.invoice.due_date && row.invoice.due_date < Date.current %>"><%= row.invoice.due_date ? l(row.invoice.due_date) : '—' %><%= ' · late' if row.invoice.due_date && row.invoice.due_date < Date.current %></td>
            <td class="px-3 py-2 whitespace-nowrap"><%= render Accounting::MoneyDisplayComponent.new(amount: row.amount) %>
              <% if row.warnings.include?(:unusual_amount) %><span class="ml-1 text-xs px-1.5 rounded-full bg-amber-100 text-amber-800">unusual</span><% end %></td>
            <td class="px-3 py-2 hidden md:table-cell">Level <%= request.current_step %></td>
            <td class="px-3 py-2 text-gray-500 hidden md:table-cell"><%= time_ago_in_words(request.step_started_at || request.created_at) %></td>
            <td class="px-3 py-2 text-right"><%= link_to 'Review', accounting_approval_path(request), class: 'text-primary-700 hover:underline' %></td>
          </tr>
        <% end %>
        <% if @rows.empty? %><tr><td colspan="8" class="px-4 py-6 text-center text-gray-500">Nothing waits for your approval.</td></tr><% end %>
      </tbody>
    </table>
  </div>
  <% if @bulk && @rows.any? %>
    <div class="mt-3 flex items-center gap-3 text-sm">
      <%= submit_tag 'Approve selected', class: 'px-4 py-2 bg-primary-600 text-white font-medium rounded-md hover:bg-primary-700 cursor-pointer' %>
      <span class="text-gray-500">Only invoices up to <%= number_to_currency(@bulk, unit: '€') %> without a warning can be selected. Each one is decided and recorded on its own.</span>
    </div>
  <% end %>
<% end %>
