<% content_for :breadcrumb do %>
  <%= render Ui::BreadcrumbsComponent.new(items: [
    { label: 'Dashboard', path: accounting_root_path },
    { label: 'Partners' }
  ]) %>
<% end %>

<%= render Ui::PageHeaderComponent.new(title: 'Partners') do |header| %>
  <% if policy(Accounting::Partner).create? %>
    <% header.with_actions do %>
      <%= link_to 'New partner', new_accounting_partner_path,
            class: 'inline-flex items-center px-4 py-2 bg-primary-600 text-white text-sm font-medium rounded-md hover:bg-primary-700 transition-colors' %>
    <% end %>
  <% end %>
<% end %>

<% if @partners.empty? %>
  <%= render Ui::EmptyStateComponent.new(
        title: 'No partners yet',
        description: 'Add your first customer or supplier to get started.',
        icon: :clipboard
      ) do |state| %>
    <% if policy(Accounting::Partner).create? %>
      <% state.with_actions do %>
        <%= link_to 'New partner', new_accounting_partner_path,
              class: 'inline-flex items-center px-4 py-2 bg-primary-600 text-white text-sm font-medium rounded-md hover:bg-primary-700 transition-colors' %>
      <% end %>
    <% end %>
  <% end %>
<% else %>
  <div class="bg-white rounded-lg border border-gray-200 overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 border-b border-gray-200">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Type</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">VAT number</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Country</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @partners.each do |partner| %>
          <tr class="hover:bg-gray-50 transition-colors">
            <td class="px-4 py-3 font-medium text-gray-900"><%= partner.name %></td>
            <td class="px-4 py-3 text-gray-500 capitalize"><%= partner.partner_type %></td>
            <td class="px-4 py-3 font-mono text-gray-500"><%= partner.vat_number.presence || '—' %></td>
            <td class="px-4 py-3 text-gray-500"><%= partner.country %></td>
            <td class="px-4 py-3 text-right">
              <%= link_to 'View', accounting_partner_path(partner),
                    class: 'text-primary-600 hover:text-primary-800 text-sm font-medium mr-2' %>
              <% if policy(partner).update? %>
                <%= link_to 'Edit', edit_accounting_partner_path(partner),
                      class: 'text-gray-500 hover:text-gray-700 text-sm' %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
