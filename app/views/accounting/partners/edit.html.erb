<% content_for :breadcrumb do %>
  <%= render Ui::BreadcrumbsComponent.new(items: [
    { label: 'Dashboard', path: accounting_root_path },
    { label: 'Partners', path: accounting_partners_path },
    { label: @partner.name, path: accounting_partner_path(@partner) },
    { label: 'Edit' }
  ]) %>
<% end %>

<%= render Ui::PageHeaderComponent.new(
      title: "Edit #{@partner.name}",
      back_path: accounting_partner_path(@partner),
      back_text: @partner.name
    ) %>

<%= render 'form', partner: @partner %>
