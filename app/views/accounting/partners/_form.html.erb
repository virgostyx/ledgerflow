<%= form_with model: partner, scope: :accounting_partner,
              url: partner.persisted? ? accounting_partner_path(partner) : accounting_partners_path,
              html: { class: 'space-y-6 max-w-2xl' } do |f| %>
  <% if partner.errors.any? %>
    <div class="rounded-md bg-red-50 p-4 text-sm text-red-700">
      <ul class="list-disc list-inside">
        <% partner.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="relative" data-controller="floating-label">
    <%= f.text_field :name,
          class: 'block w-full rounded-lg border border-gray-300 px-3 py-3 text-sm text-gray-900 bg-transparent focus:outline-none focus:ring-2 focus:ring-primary-500',
          placeholder: ' ',
          data: { floating_label_target: 'input', action: 'focus->floating-label#focus blur->floating-label#blur' } %>
    <%= f.label :name, 'Name', class: 'lf-floating-label', data: { floating_label_target: 'label' } %>
  </div>

  <div class="relative" data-controller="floating-label">
    <%= f.select :partner_type,
          Accounting::Partner.partner_types.keys.map { |k| [k.humanize, k] },
          {},
          class: 'block w-full rounded-lg border border-gray-300 px-3 py-3 text-sm text-gray-900 bg-transparent focus:outline-none focus:ring-2 focus:ring-primary-500',
          data: { floating_label_target: 'input', action: 'focus->floating-label#focus blur->floating-label#blur change->floating-label#checkValue' } %>
    <%= f.label :partner_type, 'Type', class: 'lf-floating-label', data: { floating_label_target: 'label' } %>
  </div>

  <div class="relative" data-controller="floating-label">
    <%= f.select :is_natural_person,
          [ [ "Not known (treated as a person)", "" ], [ "Company or organization", "false" ], [ "Natural person", "true" ] ],
          { selected: f.object.is_natural_person.nil? ? "" : f.object.is_natural_person.to_s },
          class: 'block w-full rounded-lg border border-gray-300 px-3 py-3 text-sm text-gray-900 bg-transparent focus:outline-none focus:ring-2 focus:ring-primary-500',
          data: { floating_label_target: 'input', action: 'focus->floating-label#focus blur->floating-label#blur change->floating-label#checkValue' } %>
    <%= f.label :is_natural_person, 'Natural person or company', class: 'lf-floating-label', data: { floating_label_target: 'label' } %>
  </div>

  <div class="relative" data-controller="floating-label">
    <%= f.text_field :vat_number,
          placeholder: ' ',
          class: 'block w-full rounded-lg border border-gray-300 px-3 py-3 text-sm text-gray-900 bg-transparent focus:outline-none focus:ring-2 focus:ring-primary-500',
          data: { floating_label_target: 'input', action: 'focus->floating-label#focus blur->floating-label#blur' } %>
    <%= f.label :vat_number, 'VAT number (e.g. BE0123456789)', class: 'lf-floating-label', data: { floating_label_target: 'label' } %>
  </div>

  <div class="relative" data-controller="floating-label">
    <%= f.text_field :peppol_participant_id,
          placeholder: ' ',
          class: 'block w-full rounded-lg border border-gray-300 px-3 py-3 text-sm text-gray-900 bg-transparent focus:outline-none focus:ring-2 focus:ring-primary-500',
          data: { floating_label_target: 'input', action: 'focus->floating-label#focus blur->floating-label#blur' } %>
    <%= f.label :peppol_participant_id, 'Peppol identifier (e.g. 0208:0123456789, empty = from Belgian VAT number)', class: 'lf-floating-label', data: { floating_label_target: 'label' } %>
  </div>

  <div class="relative" data-controller="floating-label">
    <%= f.email_field :email,
          autocomplete: 'email',
          placeholder: ' ',
          class: 'block w-full rounded-lg border border-gray-300 px-3 py-3 text-sm text-gray-900 bg-transparent focus:outline-none focus:ring-2 focus:ring-primary-500',
          data: { floating_label_target: 'input', action: 'focus->floating-label#focus blur->floating-label#blur' } %>
    <%= f.label :email, 'Email', class: 'lf-floating-label', data: { floating_label_target: 'label' } %>
  </div>

  <div class="relative" data-controller="floating-label">
    <%= f.text_field :phone,
          placeholder: ' ',
          class: 'block w-full rounded-lg border border-gray-300 px-3 py-3 text-sm text-gray-900 bg-transparent focus:outline-none focus:ring-2 focus:ring-primary-500',
          data: { floating_label_target: 'input', action: 'focus->floating-label#focus blur->floating-label#blur' } %>
    <%= f.label :phone, 'Phone', class: 'lf-floating-label', data: { floating_label_target: 'label' } %>
  </div>

  <div class="relative" data-controller="floating-label">
    <%= f.number_field :payment_terms_days, step: '1', min: '0',
          placeholder: ' ',
          class: 'block w-full rounded-lg border border-gray-300 px-3 py-3 text-sm text-gray-900 bg-transparent focus:outline-none focus:ring-2 focus:ring-primary-500',
          data: { floating_label_target: 'input', action: 'focus->floating-label#focus blur->floating-label#blur' } %>
    <%= f.label :payment_terms_days, 'Payment terms (days)', class: 'lf-floating-label', data: { floating_label_target: 'label' } %>
    <p class="mt-1 text-xs text-gray-400">Due date of this partner's invoices: invoice date plus this number of days (0 = due on receipt).</p>
  </div>

  <div class="relative" data-controller="floating-label">
    <%= f.text_field :iban,
          placeholder: ' ',
          class: 'block w-full rounded-lg border border-gray-300 px-3 py-3 text-sm text-gray-900 bg-transparent focus:outline-none focus:ring-2 focus:ring-primary-500',
          data: { floating_label_target: 'input', action: 'focus->floating-label#focus blur->floating-label#blur' } %>
    <%= f.label :iban, 'IBAN (e.g. BE68539007547034)', class: 'lf-floating-label', data: { floating_label_target: 'label' } %>
  </div>

  <div class="relative" data-controller="floating-label">
    <%= f.text_field :country,
          placeholder: ' ',
          class: 'block w-full rounded-lg border border-gray-300 px-3 py-3 text-sm text-gray-900 bg-transparent focus:outline-none focus:ring-2 focus:ring-primary-500',
          data: { floating_label_target: 'input', action: 'focus->floating-label#focus blur->floating-label#blur' } %>
    <%= f.label :country, 'Country', class: 'lf-floating-label', data: { floating_label_target: 'label' } %>
  </div>

  <% if feature?(:f09) %>
    <div class="relative">
      <%= f.select :language, [ [ 'French', 'fr' ], [ 'Dutch', 'nl' ], [ 'English', 'en' ] ], {}, class: 'block w-full rounded-lg border border-gray-300 px-3 py-3 text-sm text-gray-900 bg-transparent focus:outline-none focus:ring-2 focus:ring-primary-500', 'aria-label': 'Language of the reminders' %>
      <p class="mt-1 text-xs text-gray-400">Language of the reminders sent to this customer.</p>
    </div>
    <label class="flex items-center gap-2 text-sm text-gray-700 cursor-pointer">
      <%= f.check_box :do_not_dun, class: 'rounded border-gray-300 text-primary-600 focus:ring-primary-500' %>
      Do not remind this customer
    </label>
  <% end %>

  <label class="flex items-center gap-2 text-sm text-gray-700 cursor-pointer">
    <%= f.check_box :active, class: 'rounded border-gray-300 text-primary-600 focus:ring-primary-500' %>
    Active
  </label>

  <div class="flex gap-3 pt-2">
    <%= f.submit class: 'btn-primary' %>
  </div>
<% end %>
