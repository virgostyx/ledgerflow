<% content_for :breadcrumb do %>
  <%= render Ui::BreadcrumbsComponent.new(items: [ { label: "Dashboard", path: accounting_root_path }, { label: "Consolidation", path: accounting_consolidation_groups_path }, { label: "New" } ]) %>
<% end %>
<%= render Ui::PageHeaderComponent.new(title: "New group", description: "This company is the parent. It is in the group at 100 %; add the others afterwards.") %>
<%= form_with url: accounting_consolidation_groups_path, method: :post, class: "max-w-md space-y-4" do %>
  <div><%= label_tag :name, "Name of the group", class: "block text-sm font-medium text-gray-700 mb-1" %><%= text_field_tag :name, nil, class: "form-input w-full" %></div>
  <div><%= label_tag :currency, "Currency of the consolidated statements", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= select_tag :currency, options_for_select(Accounting::MoneyPresenter::SUPPORTED_CURRENCIES, "EUR"), class: "form-input" %></div>
  <%= submit_tag "Create", class: "btn-primary" %>
<% end %>
