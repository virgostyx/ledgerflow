<% content_for :breadcrumb do %>
  <%= render Ui::BreadcrumbsComponent.new(items: [
    { label: 'Dashboard', path: accounting_root_path },
    { label: 'Customer reminders', path: accounting_dunning_runs_path },
    { label: Accounting::DatePresenter.new(@run.run_on).format }
  ]) %>
<% end %>

<%= render Ui::PageHeaderComponent.new(title: "Reminders of #{Accounting::DatePresenter.new(@run.run_on).format}",
      description: @run.sent? ? 'Sent.' : 'Prepared: nothing has been sent. Open a customer to read, edit or leave out its reminder, then validate.',
      back_path: accounting_dunning_runs_path, back_text: 'Reminders') %>

<div class="bg-white rounded-lg border border-gray-200 overflow-x-clip">
  <table class="w-full text-sm">
    <thead class="bg-gray-50 border-b border-gray-200">
      <tr class="text-xs font-medium text-gray-500 uppercase tracking-wider">
        <th class="px-4 py-3 text-left">Customer</th>
        <th class="px-4 py-3 text-left">Level</th>
        <th class="px-4 py-3 text-right">Asked for</th>
        <th class="px-4 py-3 text-left">Sent by</th>
        <th class="px-4 py-3 text-left">Status</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% @items.each do |item| %>
        <tr class="<%= 'opacity-50' if item.excluded %>">
          <td class="px-4 py-3 font-medium text-gray-900">
            <%= link_to item.partner.name, accounting_dunning_item_path(item), class: 'hover:underline' %>
            <% if item.partner.email_bounced_at %><span class="ml-1 text-xs text-red-700">E-mail bounced</span><% end %>
          </td>
          <td class="px-4 py-3 text-gray-700">
            Level <%= item.level %>
            <% if item.skips_level? %><span class="block text-xs text-amber-700"><%= item.skip_confirmed ? 'Skip confirmed' : "Skips level #{item.proposed_level}: to confirm" %></span><% end %>
          </td>
          <td class="px-4 py-3 text-right font-mono text-gray-900"><%= Accounting::MoneyPresenter.new(item.grand_total).format %></td>
          <td class="px-4 py-3 text-gray-700"><%= item.email? ? (item.recipient || '—') : 'Letter to print' %></td>
          <td class="px-4 py-3 text-gray-700">
            <%= item.excluded ? 'Left out' : item.status.humanize %>
            <% if item.error.present? && !item.sent? %><span class="block text-xs text-red-700"><%= item.error.truncate(80) %></span><% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<% if @run.prepared? && policy(@run).send_run? %>
  <div class="mt-4">
    <%= button_to 'Send the validated reminders', send_run_accounting_dunning_run_path(@run), method: :post,
          form: { data: { turbo_confirm: 'Send the reminders that are not left out? E-mails go out now; letters are marked as printed.' } },
          class: 'px-4 py-2 bg-primary-600 text-white text-sm font-medium rounded-md hover:bg-primary-700 transition-colors cursor-pointer' %>
  </div>
<% end %>
