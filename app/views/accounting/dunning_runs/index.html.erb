<% content_for :breadcrumb do %>
  <%= render Ui::BreadcrumbsComponent.new(items: [
    { label: 'Dashboard', path: accounting_root_path },
    { label: 'Customer reminders' }
  ]) %>
<% end %>

<%= render Ui::PageHeaderComponent.new(title: 'Customer reminders',
      description: 'Prepare the reminders from the open customer lines, look at each customer, then validate. Nothing is sent before you validate.') do |header| %>
  <% header.with_actions do %>
    <%= link_to 'Rules', accounting_dunning_policy_path, class: 'px-4 py-2 border border-gray-300 text-sm text-gray-700 rounded-md hover:bg-gray-50 transition-colors' %>
    <% if policy(Accounting::DunningRun).create? %>
      <%= button_to 'Prepare reminders', accounting_dunning_runs_path, method: :post,
            class: 'px-4 py-2 bg-primary-600 text-white text-sm font-medium rounded-md hover:bg-primary-700 transition-colors cursor-pointer' %>
    <% end %>
  <% end %>
<% end %>

<% if @refused.any? %>
  <div class="mb-4 rounded-md border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900" data-section="refused">
    Already in a campaign of today, so not prepared a second time:
    <% @refused.each do |name, run_id| %>
      <%= name %> (<%= link_to 'campaign', accounting_dunning_run_path(run_id), class: 'underline' %>)
    <% end %>
  </div>
<% end %>

<% if @runs.empty? %>
  <%= render Ui::EmptyStateComponent.new(title: 'No reminders yet',
        description: 'Prepare reminders to see the customers with overdue lines, the level proposed for each and the text that would go out.', icon: :inbox) %>
<% else %>
  <div class="bg-white rounded-lg border border-gray-200 overflow-x-clip">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 border-b border-gray-200">
        <tr class="text-xs font-medium text-gray-500 uppercase tracking-wider">
          <th class="px-4 py-3 text-left">Day</th>
          <th class="px-4 py-3 text-left">Prepared by</th>
          <th class="px-4 py-3 text-right">Customers</th>
          <th class="px-4 py-3 text-left">Status</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @runs.each do |run| %>
          <tr>
            <td class="px-4 py-3"><%= link_to Accounting::DatePresenter.new(run.run_on).format, accounting_dunning_run_path(run), class: 'text-primary-700 hover:underline' %></td>
            <td class="px-4 py-3 text-gray-700"><%= run.auto ? 'Automatic (level 1)' : (run.created_by&.full_name || '—') %></td>
            <td class="px-4 py-3 text-right text-gray-700"><%= run.items.size %></td>
            <td class="px-4 py-3 text-gray-700"><%= run.sent? ? 'Sent' : 'Prepared' %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <%= render 'shared/pagination', pagy: @pagy if @pagy.pages > 1 %>
<% end %>
