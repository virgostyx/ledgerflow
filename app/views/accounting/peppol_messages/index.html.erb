<% content_for :breadcrumb do %>
  <%= render Ui::BreadcrumbsComponent.new(items: [ { label: 'Dashboard', path: accounting_root_path }, { label: 'Peppol' } ]) %>
<% end %>

<%= render Ui::PageHeaderComponent.new(title: 'Peppol') do |header| %>
  <% header.with_actions do %>
    <% if peppol_allowed?(:configure?) %>
      <%= link_to 'Settings', edit_accounting_settings_peppol_settings_path, class: 'px-4 py-2 border border-gray-300 text-sm text-gray-700 rounded-md hover:bg-gray-50' %>
    <% end %>
  <% end %>
<% end %>

<%= render 'test_banner' %>

<div class="grid grid-cols-3 lg:grid-cols-6 gap-3 mb-6 text-sm">
  <% { 'Received' => @board[:received], 'Drafted' => @board[:drafted], 'Waiting for review' => @board[:waiting], 'Sent' => @board[:sent], 'Delivered' => @board[:delivered], 'Failed' => @board[:failed] }.each do |label, value| %>
    <div class="bg-white rounded-lg border border-gray-200 px-4 py-3"><div class="text-xs text-gray-500"><%= label %></div><div class="text-xl font-semibold"><%= value %></div></div>
  <% end %>
</div>
<p class="text-xs text-gray-500 -mt-4 mb-4">Period: <%= l @period.first.to_date %> to <%= l @period.last.to_date %> (waiting for review: all messages still waiting).</p>

<div class="flex items-center gap-4 mb-4 text-sm">
  <%= link_to 'Received invoices', accounting_peppol_messages_path(direction: 'inbound'), class: (@direction == 'inbound' ? 'font-semibold text-primary-700' : 'text-gray-600') %>
  <%= link_to 'Sent invoices', accounting_peppol_messages_path(direction: 'outbound'), class: (@direction == 'outbound' ? 'font-semibold text-primary-700' : 'text-gray-600') %>
  <%= form_with url: accounting_peppol_messages_path, method: :get, class: 'ml-auto flex items-center gap-2' do %>
    <%= hidden_field_tag :direction, @direction %>
    <%= select_tag :status, options_for_select([ [ 'Any status', '' ] ] + Accounting::PeppolMessage.statuses.keys.map { |s| [ s.humanize, s ] }, params[:status]), class: 'rounded-md border border-gray-300 px-2 py-1' %>
    <%= date_field_tag :from, params[:from], class: 'rounded-md border border-gray-300 px-2 py-1' %>
    <%= date_field_tag :to, params[:to], class: 'rounded-md border border-gray-300 px-2 py-1' %>
    <%= submit_tag 'Filter', class: 'px-3 py-1 bg-gray-100 rounded-md hover:bg-gray-200 cursor-pointer' %>
  <% end %>
</div>

<%= form_with url: reprocess_all_accounting_peppol_messages_path, method: :post do %>
  <div class="bg-white rounded-lg border border-gray-200 overflow-x-auto">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 border-b border-gray-200">
        <tr>
          <th class="px-3 py-2"></th>
          <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase">Date</th>
          <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase"><%= @direction == 'inbound' ? 'From' : 'To' %></th>
          <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase">Document</th>
          <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
          <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase">What</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @messages.each do |message| %>
          <tr>
            <td class="px-3 py-2"><%= check_box_tag 'message_ids[]', message.id, false, id: "message_ids_#{message.id}" if message.needs_review? %></td>
            <td class="px-3 py-2"><%= l message.occurred_at.to_date %></td>
            <td class="px-3 py-2"><%= (@direction == 'inbound' ? message.sender_id : message.receiver_id) || '—' %></td>
            <td class="px-3 py-2"><%= link_to (message.invoice&.supplier_reference || message.invoice&.invoice_number || message.message_id.truncate(24)), accounting_peppol_message_path(message), class: 'text-primary-700 hover:underline' %> <span class="text-gray-400"><%= message.document_type.humanize %></span></td>
            <td class="px-3 py-2"><%= peppol_status_badge(message) %></td>
            <td class="px-3 py-2 text-gray-600"><%= (message.problems.first || message.note).to_s.truncate(110) %></td>
          </tr>
        <% end %>
        <% if @messages.empty? %>
          <tr><td colspan="6" class="px-4 py-6 text-center text-gray-500">Nothing here.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% if @direction == 'inbound' %>
    <div class="mt-3"><%= submit_tag 'Work on the ticked messages again', class: 'px-3 py-1 bg-gray-100 text-sm rounded-md hover:bg-gray-200 cursor-pointer' %>
      <span class="ml-2 text-xs text-gray-500">After dealing with their cause (a VAT category mapped, an exchange rate entered): the drafts are made.</span></div>
  <% end %>
<% end %>
<%= render 'shared/pagination', pagy: @pagy %>
