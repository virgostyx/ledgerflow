<% section_title   = @invoice_type == 'customer' ? 'Sales' : 'Purchases' %>
<% section_path    = @invoice_type == 'customer' ? accounting_sales_path : accounting_purchases_path %>
<% new_path        = @invoice_type == 'customer' ? accounting_new_sales_path : accounting_new_purchases_path %>
<% new_label       = @invoice_type == 'customer' ? 'New Sales Invoice' : 'New Purchase Invoice' %>

<% content_for :breadcrumb do %>
  <%= render Ui::BreadcrumbsComponent.new(items: [
    { label: 'Dashboard', path: accounting_root_path },
    { label: section_title }
  ]) %>
<% end %>

<%= render Ui::PageHeaderComponent.new(title: section_title) do |header| %>
  <% if policy(Accounting::Invoice).create? %>
    <% header.with_actions do %>
      <%= link_to new_label, new_path,
            class: 'inline-flex items-center px-4 py-2 bg-primary-600 text-white text-sm font-medium rounded-md hover:bg-primary-700 transition-colors' %>
    <% end %>
  <% end %>
<% end %>

<% if @invoices.empty? %>
  <%= render Ui::EmptyStateComponent.new(
        title: "No #{section_title.downcase} invoices yet",
        description: 'Create your first invoice to get started.',
        icon: :document
      ) do |state| %>
    <% if policy(Accounting::Invoice).create? %>
      <% state.with_actions do %>
        <%= link_to new_label, new_path,
              class: 'inline-flex items-center px-4 py-2 bg-primary-600 text-white text-sm font-medium rounded-md hover:bg-primary-700 transition-colors' %>
      <% end %>
    <% end %>
  <% end %>
<% else %>
  <div class="bg-white rounded-lg border border-gray-200 overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 border-b border-gray-200">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Entry no</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Journal</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Partner</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
          <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Total incl. VAT</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @invoices.each do |invoice| %>
          <% presenter = Accounting::InvoicePresenter.new(invoice) %>
          <tr class="hover:bg-gray-50 transition-colors">
            <td class="px-4 py-3 font-mono text-sm text-primary-700"><%= presenter.entry_number_display %></td>
            <td class="px-4 py-3 text-gray-500 text-sm"><%= invoice.journal&.code %></td>
            <td class="px-4 py-3 text-gray-700 font-medium"><%= invoice.partner.name %></td>
            <td class="px-4 py-3 text-gray-500"><%= presenter.formatted_date %></td>
            <td class="px-4 py-3 text-right font-mono text-gray-900"><%= presenter.formatted_total %></td>
            <td class="px-4 py-3"><%= render Accounting::StatusBadgeComponent.new(status: invoice.status.to_sym) %></td>
            <td class="px-4 py-3 text-right">
              <%= link_to 'View', accounting_invoice_path(invoice),
                    class: 'text-primary-600 hover:text-primary-800 text-sm font-medium mr-2' %>
              <% if policy(invoice).update? && invoice.draft? %>
                <%= link_to 'Edit', edit_accounting_invoice_path(invoice),
                      class: 'text-gray-500 hover:text-gray-700 text-sm mr-2' %>
              <% end %>
              <% if policy(invoice).destroy? && invoice.draft? %>
                <%= button_to 'Delete', accounting_invoice_path(invoice),
                      method: :delete,
                      data: { turbo_confirm: 'Delete this draft invoice?' },
                      form: { class: 'inline' },
                      class: 'text-red-500 hover:text-red-700 text-sm font-medium bg-transparent border-0 p-0 cursor-pointer' %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
