<h1>Invoices</h1>

<% if policy(Accounting::Invoice).create? %>
  <%= link_to 'New invoice', new_accounting_invoice_path %>
<% end %>

<table>
  <thead>
    <tr>
      <th>Number</th>
      <th>Type</th>
      <th>Partner</th>
      <th>Date</th>
      <th>Total incl. VAT</th>
      <th>Status</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @invoices.each do |invoice| %>
      <% presenter = Accounting::InvoicePresenter.new(invoice) %>
      <tr>
        <td><%= presenter.invoice_number_or_draft %></td>
        <td><%= presenter.type_label %></td>
        <td><%= invoice.partner.name %></td>
        <td><%= presenter.formatted_date %></td>
        <td><%= presenter.formatted_total %></td>
        <td><%= presenter.status_label %></td>
        <td>
          <%= link_to 'View', accounting_invoice_path(invoice) %>
          <% if policy(invoice).update? %>
            <%= link_to 'Edit', edit_accounting_invoice_path(invoice) %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
