<%# What came with a Peppol invoice: its references and the documents kept from it (original XML, embedded PDF). %>
<% if invoice.order_reference.present? || invoice.buyer_reference.present? || invoice.ubl_document.attached? || invoice.pdf_document.attached? %>
  <div class="mb-4 max-w-2xl rounded-md border border-gray-200 bg-white px-4 py-3" data-section="peppol-document">
    <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Peppol document</p>
    <dl class="mt-2 grid grid-cols-2 gap-x-8 gap-y-2 text-sm text-gray-900">
      <% if invoice.order_reference.present? %>
        <div><dt class="text-xs text-gray-500">Order reference</dt><dd class="font-mono"><%= invoice.order_reference %></dd></div>
      <% end %>
      <% if invoice.buyer_reference.present? %>
        <div><dt class="text-xs text-gray-500">Buyer reference</dt><dd class="font-mono"><%= invoice.buyer_reference %></dd></div>
      <% end %>
    </dl>
    <div class="mt-2 flex gap-4 text-sm">
      <% if invoice.pdf_document.attached? %>
        <%= link_to "PDF", document_accounting_invoice_path(invoice, kind: "pdf"), target: "_blank", rel: "noopener", class: "text-primary-600 hover:underline" %>
      <% end %>
      <% if invoice.ubl_document.attached? %>
        <%= link_to "Original (UBL XML)", document_accounting_invoice_path(invoice, kind: "xml"), class: "text-primary-600 hover:underline" %>
      <% end %>
    </div>
  </div>
<% end %>
