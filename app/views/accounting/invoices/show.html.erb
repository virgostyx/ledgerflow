<% presenter = Accounting::InvoicePresenter.new(@invoice) %>
<% section_label = @invoice.customer? ? 'Sales' : 'Purchases' %>
<% section_path  = @invoice.customer? ? accounting_sales_path : accounting_purchases_path %>

<% content_for :breadcrumb do %>
  <%= render Ui::BreadcrumbsComponent.new(items: [
    { label: 'Dashboard', path: accounting_root_path },
    { label: section_label, path: section_path },
    { label: presenter.invoice_number_or_draft }
  ]) %>
<% end %>

<%= render Ui::PageHeaderComponent.new(
      title: (@invoice.credit_note? ? 'Credit note ' : '') + presenter.invoice_number_or_draft,
      back_path: section_path,
      back_text: section_label
    ) do |header| %>
  <% header.with_actions do %>
    <%= render Accounting::StatusBadgeComponent.new(status: @invoice.status.to_sym) %>
    <% if @invoice.draft? && policy(@invoice).post? %>
      <%= button_to 'Post invoice', validate_invoice_accounting_invoice_path(@invoice), method: :post,
            class: 'px-4 py-2 bg-primary-600 text-white text-sm font-medium rounded-md hover:bg-primary-700 transition-colors' %>
    <% end %>
    <% if @invoice.posted? && policy(@invoice).cancel? %>
      <%= button_to 'Cancel invoice', cancel_invoice_accounting_invoice_path(@invoice), method: :post,
            form: { data: { turbo_confirm: 'Cancel this invoice? Its journal entry will be reversed.' } },
            class: 'px-4 py-2 border border-red-300 text-sm text-red-700 rounded-md hover:bg-red-50 transition-colors' %>
    <% end %>
    <% if @invoice.customer? && @invoice.issued? && policy(@invoice).pdf? %>
      <%= link_to 'Download PDF', pdf_accounting_invoice_path(@invoice), target: '_blank', rel: 'noopener',
            class: 'px-4 py-2 border border-gray-300 text-sm text-gray-700 rounded-md hover:bg-gray-50 transition-colors' %>
    <% end %>
    <% if @invoice.customer? && @invoice.issued? && !(@invoice.queued? || @invoice.delivered?) && @invoice.entity.peppol_access_point && policy(@invoice).send_peppol? %>
      <%= button_to 'Send via Peppol', send_peppol_accounting_invoice_path(@invoice), method: :post,
            class: 'px-4 py-2 border border-gray-300 text-sm text-gray-700 rounded-md hover:bg-gray-50 transition-colors' %>
    <% end %>
    <% if @invoice.invoice? && @invoice.issued? && policy(Accounting::RecurringInvoice).create? %>
      <%= link_to 'Make recurring', new_accounting_recurring_invoice_path(invoice_id: @invoice.id),
            class: 'px-4 py-2 border border-gray-300 text-sm text-gray-700 rounded-md hover:bg-gray-50 transition-colors' %>
    <% end %>
    <% if @invoice.invoice? && policy(@invoice).duplicate? %>
      <%= button_to 'Duplicate', duplicate_accounting_invoice_path(@invoice), method: :post,
            class: 'px-4 py-2 border border-gray-300 text-sm text-gray-700 rounded-md hover:bg-gray-50 transition-colors' %>
    <% end %>
    <% if @invoice.invoice? && @invoice.issued? && policy(@invoice).create_credit_note? %>
      <%= button_to 'Create credit note', create_credit_note_accounting_invoice_path(@invoice), method: :post,
            class: 'px-4 py-2 border border-gray-300 text-sm text-gray-700 rounded-md hover:bg-gray-50 transition-colors' %>
    <% end %>
    <% if @invoice.credit_note? && @invoice.posted? && @invoice.credited_invoice && policy(@invoice).apply_credit_note? %>
      <%= button_to 'Apply to invoice', apply_credit_note_accounting_invoice_path(@invoice), method: :post,
            class: 'px-4 py-2 bg-primary-600 text-white text-sm font-medium rounded-md hover:bg-primary-700 transition-colors' %>
    <% end %>
    <% if policy(@invoice).update? && @invoice.draft? %>
      <%= link_to 'Edit', edit_accounting_invoice_path(@invoice),
            class: 'px-4 py-2 border border-gray-300 text-sm text-gray-700 rounded-md hover:bg-gray-50 transition-colors' %>
    <% end %>
  <% end %>
<% end %>

<% if @invoice.recurring_invoice %>
  <div class="mb-4 max-w-2xl rounded-md bg-blue-50 border border-blue-200 px-4 py-3 text-sm text-blue-800">
    Generated from a recurring invoice. Review it, then post it.
    <%= link_to 'Recurring invoices', accounting_recurring_invoices_path, class: 'underline' %>
  </div>
<% end %>

<%# ── Invoice metadata ───────────────────────────────────────────────── %>
<div class="bg-white rounded-lg border border-gray-200 p-6 max-w-2xl mb-6">
  <dl class="grid grid-cols-2 gap-x-8 gap-y-4">
    <div>
      <dt class="text-xs font-medium text-gray-500 uppercase tracking-wider">Type</dt>
      <dd class="mt-1 text-sm text-gray-900"><%= presenter.type_label %></dd>
    </div>
    <% if @invoice.credited_invoice %>
      <div>
        <dt class="text-xs font-medium text-gray-500 uppercase tracking-wider">Credits invoice</dt>
        <dd class="mt-1 text-sm text-gray-900">
          <%= link_to Accounting::InvoicePresenter.new(@invoice.credited_invoice).invoice_number_or_draft,
                accounting_invoice_path(@invoice.credited_invoice), class: "text-primary-600 hover:underline" %>
        </dd>
      </div>
    <% end %>
    <div>
      <dt class="text-xs font-medium text-gray-500 uppercase tracking-wider">Partner</dt>
      <dd class="mt-1 text-sm font-medium text-gray-900"><%= @invoice.partner.name %></dd>
    </div>
    <div>
      <dt class="text-xs font-medium text-gray-500 uppercase tracking-wider">Date</dt>
      <dd class="mt-1 text-sm text-gray-900"><%= presenter.formatted_date %></dd>
    </div>
    <div>
      <dt class="text-xs font-medium text-gray-500 uppercase tracking-wider">Due date</dt>
      <dd class="mt-1 text-sm text-gray-900"><%= presenter.formatted_due_date %></dd>
    </div>
    <% if @invoice.description.present? %>
      <div class="col-span-2">
        <dt class="text-xs font-medium text-gray-500 uppercase tracking-wider">Description</dt>
        <dd class="mt-1 text-sm text-gray-900"><%= @invoice.description %></dd>
      </div>
    <% end %>
    <% if @invoice.cash_journal %>
      <div>
        <dt class="text-xs font-medium text-gray-500 uppercase tracking-wider">Paid in cash</dt>
        <dd class="mt-1 text-sm text-gray-900"><%= @invoice.cash_journal.display_name %></dd>
      </div>
    <% end %>
    <% if @invoice.journal_entry %>
      <div>
        <dt class="text-xs font-medium text-gray-500 uppercase tracking-wider">Journal</dt>
        <dd class="mt-1 text-sm text-gray-900">
          <%= @invoice.journal_entry.journal.code %> — <%= @invoice.journal_entry.journal.label_fr %>
        </dd>
      </div>
      <div>
        <dt class="text-xs font-medium text-gray-500 uppercase tracking-wider">Journal entry</dt>
        <dd class="mt-1 text-sm text-gray-900">
          <%= link_to @invoice.journal_entry.reference,
                accounting_journal_entry_path(@invoice.journal_entry),
                class: "text-primary-600 hover:underline" %>
        </dd>
      </div>
    <% end %>
  </dl>
</div>

<% if @invoice.customer? && (!@invoice.not_sent? || @invoice.peppol_events.any?) %>
  <div class="bg-white rounded-lg border border-gray-200 p-6 mb-6" data-section="peppol">
    <h2 class="text-sm font-semibold text-gray-900">Peppol <span class="ml-2 text-xs font-medium text-gray-500"><%= @invoice.peppol_status.humanize.downcase %></span></h2>
    <ul class="mt-3 space-y-1 text-sm text-gray-700">
      <% @invoice.peppol_events.each do |event| %>
        <li><span class="text-gray-400"><%= l(event.occurred_at, format: :short) %></span> — <%= event.message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%# ── Lines table ────────────────────────────────────────────────────── %>
<% if @invoice.lines.any? %>
  <div class="bg-white rounded-lg border border-gray-200 overflow-hidden mb-6">
    <div class="px-6 py-3 border-b border-gray-100 bg-gray-50">
      <h3 class="text-sm font-semibold text-gray-700">Lines</h3>
    </div>
    <div class="overflow-x-auto">
      <table class="min-w-full text-sm">
        <thead>
          <tr class="text-xs font-medium text-gray-500 uppercase tracking-wider">
            <th class="px-4 py-2 text-left">Account</th>
            <th class="px-4 py-2 text-left">Description</th>
            <th class="px-4 py-2 text-right">Amount HT</th>
            <th class="px-4 py-2 text-right">VAT %</th>
            <th class="px-4 py-2 text-right">VAT</th>
            <th class="px-4 py-2 text-right">Total TTC</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @invoice.lines.each do |line| %>
            <tr class="hover:bg-gray-50">
              <td class="px-4 py-3 font-mono text-xs text-gray-600">
                <%= line.account.code %>
                <span class="text-gray-400 ml-1"><%= line.account.label_fr %></span>
              </td>
              <td class="px-4 py-3 text-gray-900">
                <%= line.description %>
                <% if Accounting::FixedAsset.asset_purchase_line?(line) %>
                  <% if line.fixed_asset %>
                    <% if policy(line.fixed_asset).update? %>
                      <div class="mt-1 text-xs"><%= link_to 'Fixed asset', edit_accounting_fixed_asset_path(line.fixed_asset), class: 'text-primary-600 hover:underline' %></div>
                    <% end %>
                  <% elsif policy(Accounting::FixedAsset).create? %>
                    <div class="mt-1 text-xs"><%= link_to 'Create fixed asset', new_accounting_fixed_asset_path(invoice_line_id: line.id), class: 'text-primary-600 hover:underline' %></div>
                  <% end %>
                <% end %>
              </td>
              <td class="px-4 py-3 text-right font-mono"><%= Accounting::MoneyPresenter.new(line.subtotal_excl_vat, currency: @invoice.currency).format %></td>
              <td class="px-4 py-3 text-right"><%= line.vat_rate.to_f %>%</td>
              <td class="px-4 py-3 text-right font-mono"><%= Accounting::MoneyPresenter.new(line.vat_amount, currency: @invoice.currency).format %></td>
              <td class="px-4 py-3 text-right font-mono font-semibold"><%= Accounting::MoneyPresenter.new(line.total_incl_vat, currency: @invoice.currency).format %></td>
            </tr>
            <% if line.analytical_annotations.any? %>
              <tr class="bg-indigo-50">
                <td colspan="6" class="px-6 py-1 text-xs text-indigo-600">
                  <% line.analytical_annotations.each do |ann| %>
                    <span class="mr-4">
                      <span class="font-medium"><%= ann.analytical_axis.code %> :</span>
                      <%= ann.analytical_account.label_fr %>
                    </span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
        <tfoot class="border-t-2 border-gray-200 bg-gray-50">
          <tr class="text-sm">
            <td colspan="2" class="px-4 py-3 text-right text-gray-500 font-medium">Totals</td>
            <td class="px-4 py-3 text-right font-mono font-semibold">
              <%= Accounting::MoneyPresenter.new(@invoice.subtotal_excl_vat, currency: @invoice.currency).format %>
            </td>
            <td class="px-4 py-3"></td>
            <td class="px-4 py-3 text-right font-mono font-semibold">
              <%= Accounting::MoneyPresenter.new(@invoice.vat_amount, currency: @invoice.currency).format %>
            </td>
            <td class="px-4 py-3 text-right font-mono font-bold text-gray-900">
              <%= presenter.formatted_total %>
            </td>
          </tr>
          <% if @invoice.currency != 'EUR' %>
            <tr class="text-sm">
              <td colspan="5" class="px-4 py-2 text-right text-gray-500 font-medium">EUR equivalent (rate <%= @invoice.exchange_rate %>)</td>
              <td class="px-4 py-2 text-right font-mono font-bold text-gray-900"><%= Accounting::MoneyPresenter.new(@invoice.total_incl_vat_eur).format %></td>
            </tr>
          <% end %>
          <% if @invoice.customer? && @invoice.paid_amount.positive? %>
            <tr class="text-sm">
              <td colspan="5" class="px-4 py-2 text-right text-gray-500 font-medium">Paid</td>
              <td class="px-4 py-2 text-right font-mono text-emerald-700"><%= Accounting::MoneyPresenter.new(@invoice.paid_amount).format %></td>
            </tr>
            <tr class="text-sm">
              <td colspan="5" class="px-4 py-2 text-right text-gray-500 font-medium">Remaining</td>
              <td class="px-4 py-2 text-right font-mono font-bold text-gray-900"><%= Accounting::MoneyPresenter.new(@invoice.remaining_amount).format %></td>
            </tr>
            <% if @invoice.overpaid_amount.positive? %>
              <tr class="text-sm">
                <td colspan="5" class="px-4 py-2 text-right text-gray-500 font-medium">Overpaid (credit on customer account)</td>
                <td class="px-4 py-2 text-right font-mono text-amber-700"><%= Accounting::MoneyPresenter.new(@invoice.overpaid_amount).format %></td>
              </tr>
            <% end %>
          <% end %>
        </tfoot>
      </table>
    </div>
  </div>
<% else %>
  <div class="bg-white rounded-lg border border-dashed border-gray-300 p-8 text-center text-sm text-gray-400 mb-6">
    No lines yet. <% if @invoice.draft? %><%= link_to 'Add lines', edit_accounting_invoice_path(@invoice), class: 'text-primary-600 hover:underline' %><% end %>
  </div>
<% end %>

<%# ── Journal entries ────────────────────────────────────────────────── %>
<% entries = @invoice.related_journal_entries %>
<% if entries.any? %>
  <div class="bg-white rounded-lg border border-gray-200 overflow-hidden mb-6">
    <div class="px-6 py-3 border-b border-gray-100 bg-gray-50">
      <h3 class="text-sm font-semibold text-gray-700">Journal entries</h3>
    </div>
    <div class="overflow-x-auto">
      <table class="min-w-full text-sm">
        <thead>
          <tr class="text-xs font-medium text-gray-500 uppercase tracking-wider">
            <th class="px-2 py-2"></th>
            <th class="px-4 py-2 text-left">Reference</th>
            <th class="px-4 py-2 text-left">Journal</th>
            <th class="px-4 py-2 text-left">Date</th>
            <th class="px-4 py-2 text-left">Description</th>
            <th class="px-4 py-2 text-left">Status</th>
            <th class="px-4 py-2"></th>
          </tr>
        </thead>
        <% entries.each do |entry| %>
          <tbody data-controller="toggle" class="divide-y divide-gray-100">
            <tr class="hover:bg-gray-50">
              <td class="px-2 py-3">
                <button type="button" data-action="toggle#toggle" class="text-gray-400 hover:text-gray-600" aria-label="Show accounting lines">
                  <svg data-toggle-target="icon" class="w-4 h-4 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </button>
              </td>
              <td class="px-4 py-3 font-mono text-xs text-primary-700"><%= entry.reference || '—' %></td>
              <td class="px-4 py-3 text-gray-500"><%= entry.journal.code %></td>
              <td class="px-4 py-3 text-gray-500"><%= Accounting::DatePresenter.new(entry.entry_date).format %></td>
              <td class="px-4 py-3 text-gray-700"><%= entry.description %></td>
              <td class="px-4 py-3"><%= render Accounting::StatusBadgeComponent.new(status: entry.status.to_sym) %></td>
              <td class="px-4 py-3 text-right">
                <%= link_to 'View', accounting_journal_entry_path(entry), class: 'text-primary-600 hover:text-primary-800 text-sm font-medium' %>
              </td>
            </tr>
            <tr data-toggle-target="content" hidden>
              <td></td>
              <td colspan="6" class="px-4 py-3 bg-gray-50">
                <table class="w-full text-xs">
                  <thead>
                    <tr class="text-xs font-medium text-gray-500 uppercase tracking-wider">
                      <th class="px-2 py-1 text-left">Account</th>
                      <th class="px-2 py-1 text-left">Label</th>
                      <th class="px-2 py-1 text-left">Partner</th>
                      <th class="px-2 py-1 text-right">Debit</th>
                      <th class="px-2 py-1 text-right">Credit</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-gray-100">
                    <% entry.lines.each do |line| %>
                      <tr>
                        <td class="px-2 py-1 font-mono text-gray-600">
                          <%= line.account.code %> <span class="text-gray-400"><%= line.account.label_fr %></span>
                        </td>
                        <td class="px-2 py-1 text-gray-700"><%= line.label %></td>
                        <td class="px-2 py-1 text-gray-500"><%= line.partner&.name %></td>
                        <td class="px-2 py-1 text-right font-mono"><%= Accounting::MoneyPresenter.new(line.debit).format if line.debit > 0 %></td>
                        <td class="px-2 py-1 text-right font-mono"><%= Accounting::MoneyPresenter.new(line.credit).format if line.credit > 0 %></td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </td>
            </tr>
          </tbody>
        <% end %>
      </table>
    </div>
  </div>
<% end %>

<% if @invoice.customer? && @invoice.issued? && policy(@invoice).send_email? %>
  <%= render "emails", invoice: @invoice %>
<% end %>
