<% presenter = Accounting::InvoicePresenter.new(@invoice) %>

<h1><%= presenter.invoice_number_or_draft %></h1>

<dl>
  <dt>Type</dt>          <dd><%= presenter.type_label %></dd>
  <dt>Status</dt>        <dd><%= presenter.status_label %></dd>
  <dt>Partner</dt>       <dd><%= @invoice.partner.name %></dd>
  <dt>Date</dt>          <dd><%= presenter.formatted_date %></dd>
  <dt>Due date</dt>      <dd><%= presenter.formatted_due_date %></dd>
  <dt>Excl. VAT</dt>     <dd><%= Accounting::MoneyPresenter.new(@invoice.subtotal_excl_vat).format %></dd>
  <dt>VAT</dt>           <dd><%= Accounting::MoneyPresenter.new(@invoice.vat_amount).format %></dd>
  <dt>Total incl. VAT</dt> <dd><%= presenter.formatted_total %></dd>
</dl>

<% if @invoice.draft? && policy(@invoice).post? %>
  <%= button_to 'Post invoice', validate_invoice_accounting_invoice_path(@invoice), method: :post %>
<% end %>

<% if policy(@invoice).update? && @invoice.draft? %>
  <%= link_to 'Edit', edit_accounting_invoice_path(@invoice) %>
<% end %>

<%= link_to 'Back', accounting_invoices_path %>
