<% presenter    = Accounting::InvoicePresenter.new(@invoice) %>
<% section_label = @invoice.customer? ? 'Sales' : 'Purchases' %>
<% section_path  = @invoice.customer? ? accounting_sales_path : accounting_purchases_path %>

<% content_for :breadcrumb do %>
  <%= render Ui::BreadcrumbsComponent.new(items: [
    { label: 'Dashboard', path: accounting_root_path },
    { label: section_label, path: section_path },
    { label: presenter.invoice_number_or_draft, path: accounting_invoice_path(@invoice) },
    { label: 'Edit' }
  ]) %>
<% end %>

<%= render Ui::PageHeaderComponent.new(
      title: 'Edit Invoice',
      back_path: accounting_invoice_path(@invoice),
      back_text: presenter.invoice_number_or_draft
    ) %>

<%= render 'form', invoice: @invoice, next_entry_number: nil,
                         accounts: @accounts, axes: @axes %>
