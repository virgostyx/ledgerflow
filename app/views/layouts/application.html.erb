<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "LedgerFlow" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-gray-50 flex font-sans antialiased">

    <%# ── Sidebar ──────────────────────────────────────────────────────────── %>
    <aside class="w-64 bg-white border-r border-gray-200 flex flex-col shrink-0 min-h-screen">

      <%# Logo %>
      <div class="flex items-center gap-2.5 px-5 py-4 border-b border-gray-100">
        <span class="text-2xl leading-none text-primary-600">◈</span>
        <span class="text-base font-bold text-primary-700 tracking-tight">LedgerFlow</span>
      </div>

      <%# Navigation %>
      <nav class="flex-1 px-3 py-4 space-y-0.5 overflow-y-auto">

        <%# Dashboard %>
        <%= link_to accounting_root_path, class: nav_class(accounting_root_path) do %>
          <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"/>
          </svg>
          Dashboard
        <% end %>

        <%# Separator %>
        <div class="pt-3 pb-1 px-3">
          <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Accounting</p>
        </div>

        <%= link_to accounting_journal_entries_path, class: nav_class(accounting_journal_entries_path) do %>
          <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25"/>
          </svg>
          Journal Entries
        <% end %>

        <%= link_to accounting_sales_path, class: nav_class(accounting_sales_path) do %>
          <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z"/>
          </svg>
          Sales
        <% end %>

        <%= link_to accounting_purchases_path, class: nav_class(accounting_purchases_path) do %>
          <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z"/>
          </svg>
          Purchases
        <% end %>

        <%= link_to accounting_partners_path, class: nav_class(accounting_partners_path) do %>
          <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z"/>
          </svg>
          Partners
        <% end %>

        <%= link_to accounting_bank_reconciliation_path, class: nav_class(accounting_bank_reconciliation_path) do %>
          <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 21 3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5"/>
          </svg>
          Bank Reconciliation
        <% end %>

        <%= link_to accounting_vat_declarations_path, class: nav_class(accounting_vat_declarations_path) do %>
          <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 14.25l6-6m4.5-3.493V21.75l-3.75-1.5-3.75 1.5-3.75-1.5-3.75 1.5V4.757c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0 1 11.186 0c1.1.128 1.907 1.077 1.907 2.185ZM9.75 9h.008v.008H9.75V9Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm4.125 4.5h.008v.008h-.008V13.5Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z"/>
          </svg>
          VAT Declarations
        <% end %>

        <%# Reports section %>
        <div class="pt-3 pb-1 px-3">
          <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Reports</p>
        </div>

        <%= link_to accounting_reports_trial_balance_path, class: nav_class(accounting_reports_trial_balance_path) do %>
          <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z"/>
          </svg>
          Trial Balance
        <% end %>

        <%= link_to accounting_reports_balance_sheet_path, class: nav_class(accounting_reports_balance_sheet_path) do %>
          <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 14.25v2.25m3-4.5v4.5m3-6.75v6.75m3-9v9M6 20.25h12A2.25 2.25 0 0 0 20.25 18V6A2.25 2.25 0 0 0 18 3.75H6A2.25 2.25 0 0 0 3.75 6v12A2.25 2.25 0 0 0 6 20.25Z"/>
          </svg>
          Balance Sheet
        <% end %>

        <%= link_to accounting_reports_income_statement_path, class: nav_class(accounting_reports_income_statement_path) do %>
          <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18 9 11.25l4.306 4.306a11.95 11.95 0 0 1 5.814-5.518l2.74-1.22m0 0-5.94-2.281m5.94 2.28-2.28 5.941"/>
          </svg>
          Income Statement
        <% end %>

        <%# Settings section %>
        <div class="pt-3 pb-1 px-3">
          <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Settings</p>
        </div>

        <%= link_to accounting_fiscal_years_path, class: nav_class(accounting_fiscal_years_path) do %>
          <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5"/>
          </svg>
          Fiscal Years
        <% end %>

        <%= link_to accounting_settings_root_path, class: nav_class(accounting_settings_root_path) do %>
          <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.325.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.241-.438.613-.43.992a7.723 7.723 0 0 1 0 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 0 1 0-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28Z"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/>
          </svg>
          Configuration
        <% end %>

      </nav>

      <%# Entity switcher %>
      <% if ActsAsTenant.current_tenant.present? %>
        <div class="px-3 py-3 border-t border-gray-100">
          <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider px-2 mb-2">Entity</p>
          <div class="flex items-center gap-2 px-2 py-1.5 rounded-md bg-indigo-50 mb-2">
            <svg class="w-3.5 h-3.5 text-indigo-500 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21"/>
            </svg>
            <span class="text-xs font-medium text-indigo-700 truncate"><%= ActsAsTenant.current_tenant.name %></span>
          </div>
          <div class="flex gap-2 px-2">
            <% if current_user.entities.count > 1 %>
              <%= link_to "Switch", entities_path, class: "text-xs text-gray-400 hover:text-indigo-600" %>
              <span class="text-gray-200">·</span>
            <% end %>
            <%= link_to "New entity", new_entity_path, class: "text-xs text-gray-400 hover:text-emerald-600" %>
          </div>
        </div>
      <% end %>

      <%# User section %>
      <div class="px-3 py-3 border-t border-gray-100">
        <div class="flex items-center gap-3 px-2 py-2 rounded-md mb-1">
          <div class="w-8 h-8 rounded-full bg-primary-600 flex items-center justify-center shrink-0">
            <span class="text-xs font-semibold text-white"><%= user_initials(current_user&.full_name) %></span>
          </div>
          <div class="min-w-0">
            <p class="text-sm font-medium text-gray-700 truncate"><%= current_user&.full_name %></p>
            <p class="text-xs text-gray-400 truncate"><%= current_user&.email %></p>
          </div>
        </div>
        <%= button_to destroy_user_session_path, method: :delete,
              class: 'w-full flex items-center gap-3 px-3 py-2 rounded-md text-sm text-gray-500 hover:text-danger-600 hover:bg-danger-50 transition-colors' do %>
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15m3 0 3-3m0 0-3-3m3 3H9"/>
          </svg>
          Sign out
        <% end %>
      </div>

    </aside>

    <%# ── Main content ──────────────────────────────────────────────────────── %>
    <div class="flex-1 flex flex-col min-h-screen">

      <%# Header bar %>
      <header class="bg-white border-b border-gray-200 px-6 py-3 flex items-center justify-between sticky top-0 z-20">
        <div class="flex items-center text-sm">
          <%= yield :breadcrumb %>
        </div>
        <div class="flex items-center gap-2">
          <%= yield :actions %>
        </div>
      </header>

      <%# Page content %>
      <main class="flex-1 p-6 lg:pr-28">
        <% if notice %>
          <div class="mb-4">
            <%= render FlashMessageComponent.new(type: :notice, message: notice) %>
          </div>
        <% end %>
        <% if alert %>
          <div class="mb-4">
            <%= render FlashMessageComponent.new(type: :alert, message: alert) %>
          </div>
        <% end %>
        <%= yield %>
      </main>

      <%# Footer %>
      <footer class="px-6 py-2 border-t border-gray-100 text-xs text-gray-400 flex items-center justify-between">
        <span>LedgerFlow</span>
        <span>© <%= Date.current.year %> LedgerFlow — Free to use</span>
      </footer>

    </div>

    <%# ── Floating widgets ────────────────────────────────────────────────── %>
    <%= render Ui::LoadingOverlayComponent.new %>
    <%= render Ui::BackToTopComponent.new %>
    <%= render Ui::CalculatorComponent.new %>
    <%= render Ui::CurrencyConverterComponent.new %>
    <%= render Ui::MusicPlayerComponent.new %>

    <%# ── Confirm modal (global singleton) ──────────────────────────────────── %>
    <%= render Ui::ConfirmModalComponent.new %>

    <%# ── Cookie consent banner ──────────────────────────────────────────────── %>
    <%= render Ui::CookieBannerComponent.new %>

    <%# ── Buy Me a Coffee donation widget ───────────────────────────────────── %>
    <script
      data-name="BMC-Widget"
      data-cfasync="false"
      src="https://cdnjs.buymeacoffee.com/1.0.0/widget.prod.min.js"
      data-id="virgostyx"
      data-description="Support LedgerFlow!"
      data-message="If LedgerFlow saves you time, a coffee is always welcome ☕"
      data-color="#40DCA5"
      data-position="Right"
      data-x_margin="18"
      data-y_margin="18"
    ></script>

  </body>
</html>
