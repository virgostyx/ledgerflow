<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Client portal</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <%= csrf_meta_tags %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <link rel="stylesheet" href="<%= branding_stylesheet_path %>">
    <link rel="manifest" href="<%= portal_manifest_path %>">
    <meta name="theme-color" content="#111827">
    <%= yield :head %>
  </head>
  <body class="text-gray-900">
    <% if portal_brand %><header class="mx-auto max-w-2xl p-6 pb-0"><% if portal_brand.logo? %><img src="<%= branding_logo_path %>" alt="" class="h-10 inline-block mr-2"><% end %><strong><%= portal_brand.display_name %></strong></header><% end %>
    <main class="mx-auto max-w-2xl p-6"><%= yield %></main>
  </body>
</html>
