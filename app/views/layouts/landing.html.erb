<!DOCTYPE html>
<html lang="en">
  <head>
    <title>LedgerFlow — Belgian Accounting</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="Free, open-source Belgian accounting: PCMN chart of accounts, VAT returns and Peppol e-invoicing, with double entry enforced by the database.">
    <link rel="canonical" href="https://app.ledgerflowmanagment.com/">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://app.ledgerflowmanagment.com/">
    <meta property="og:image" content="https://app.ledgerflowmanagment.com/og-image.png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="LedgerFlow: free Belgian accounting for every business">
    <meta name="twitter:card" content="summary_large_image">
    <meta property="og:title" content="LedgerFlow — Free Belgian accounting">
    <script type="application/ld+json"><%= raw({
      "@context" => "https://schema.org",
      "@type" => "SoftwareApplication",
      "name" => "LedgerFlow",
      "applicationCategory" => "FinanceApplication",
      "operatingSystem" => "Web",
      "description" => "Free, open-source Belgian accounting: PCMN chart of accounts, VAT returns and Peppol e-invoicing.",
      "offers" => { "@type" => "Offer", "price" => "0", "priceCurrency" => "EUR" }
    }.to_json.gsub("<", "\\u003c")) %></script>
    <meta property="og:description" content="Free, open-source Belgian accounting: PCMN chart of accounts, VAT returns and Peppol e-invoicing, with double entry enforced by the database.">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-white text-gray-900">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:z-50 focus:bg-white focus:text-primary-700 focus:font-semibold focus:px-3 focus:py-2 focus:rounded-lg focus:shadow">Skip to content</a>
    <%= render "shared/development_notice" %>
    <nav class="border-b border-gray-100 px-6 py-4 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <%= image_tag "/logo.png", alt: "", class: "h-8 w-8" %>
        <span class="text-lg font-bold text-primary-700">LedgerFlow</span>
      </div>
      <%= link_to 'Sign in', new_user_session_path,
            class: 'bg-primary-600 hover:bg-primary-700 text-white text-sm font-medium px-4 py-2 rounded-lg transition-colors' %>
    </nav>

    <main id="main">
      <%= yield %>
    </main>

    <footer class="border-t border-gray-100 px-6 py-4 text-center text-xs text-gray-500">
      © <%= Date.current.year %> LedgerFlow v<%= LedgerflowVersion::VERSION rescue '0.1.0' %> — Free to use ·
      <a href="https://github.com/virgostyx/ledgerflow" target="_blank" rel="noopener noreferrer" class="underline hover:text-gray-700">Source on GitHub</a>
    </footer>

    <%# ── Cookie consent banner ──────────────────────────────────────────────── %>
    <%= render Ui::CookieBannerComponent.new %>

    <%# ── Buy Me a Coffee donation widget ───────────────────────────────────── %>
    <script
      data-name="BMC-Widget"
      data-cfasync="false"
      src="https://cdnjs.buymeacoffee.com/1.0.0/widget.prod.min.js"
      data-id="virgostyx"
      data-description="Support LedgerFlow!"
      data-message="If LedgerFlow saves you time, a coffee is always welcome ☕"
      data-color="#40DCA5"
      data-position="Right"
      data-x_margin="18"
      data-y_margin="18"
    ></script>
  </body>
</html>
