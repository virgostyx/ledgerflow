<h2 class="text-xl font-semibold text-gray-900 mb-2">Two-factor authentication</h2>
<p class="text-sm text-gray-500 mb-6">Enter the 6-digit code from your authenticator app, or one of your backup codes.</p>

<%= form_with url: two_factor_challenge_path, method: :post, html: { class: "space-y-4" } do %>
  <div>
    <%= label_tag :code, "Code", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= text_field_tag :code, nil, required: true, autofocus: true, autocomplete: "one-time-code", maxlength: 12,
          class: "block w-full rounded-lg border border-gray-300 px-3 py-3 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-primary-500" %>
  </div>
  <%= submit_tag "Verify", class: "w-full bg-primary-600 hover:bg-primary-700 text-white font-medium py-2 px-4 rounded-lg text-sm transition-colors cursor-pointer" %>
<% end %>

<div class="mt-4 text-center">
  <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "text-xs text-gray-400 hover:text-gray-600 cursor-pointer" %>
</div>
