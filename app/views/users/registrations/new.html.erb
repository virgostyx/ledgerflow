<h2 class="text-xl font-semibold text-gray-900 mb-6">Create an account</h2>

<%= form_with model: resource, url: registration_path(resource_name), html: { class: 'space-y-6' } do |f| %>
  <% if resource.errors.any? %>
    <div class="p-3 bg-red-50 text-red-700 rounded-lg text-sm space-y-1">
      <% resource.errors.full_messages.each do |msg| %>
        <div>• <%= msg %></div>
      <% end %>
    </div>
  <% end %>

  <div class="relative" data-controller="floating-label">
    <%= f.text_field :full_name,
          autofocus: true, autocomplete: 'name',
          class: 'block w-full rounded-lg border border-gray-300 px-3 py-3 text-sm text-gray-900 bg-transparent focus:outline-none focus:ring-2 focus:ring-primary-500',
          placeholder: ' ',
          data: { floating_label_target: 'input', action: 'focus->floating-label#focus blur->floating-label#blur' } %>
    <%= f.label :full_name, 'Full name', class: 'lf-floating-label', data: { floating_label_target: 'label' } %>
  </div>

  <div class="relative" data-controller="floating-label">
    <%= f.email_field :email,
          autocomplete: 'email',
          class: 'block w-full rounded-lg border border-gray-300 px-3 py-3 text-sm text-gray-900 bg-transparent focus:outline-none focus:ring-2 focus:ring-primary-500',
          placeholder: ' ',
          data: { floating_label_target: 'input', action: 'focus->floating-label#focus blur->floating-label#blur' } %>
    <%= f.label :email, 'Email address', class: 'lf-floating-label', data: { floating_label_target: 'label' } %>
  </div>

  <div>
    <div class="relative" data-controller="floating-label">
      <%= f.password_field :password,
            autocomplete: 'new-password',
            class: 'block w-full rounded-lg border border-gray-300 px-3 py-3 text-sm text-gray-900 bg-transparent focus:outline-none focus:ring-2 focus:ring-primary-500',
            placeholder: ' ',
            data: { floating_label_target: 'input', action: 'focus->floating-label#focus blur->floating-label#blur' } %>
      <%= f.label :password, 'Password', class: 'lf-floating-label', data: { floating_label_target: 'label' } %>
    </div>
    <p class="text-xs text-gray-400 mt-1 px-1">Minimum 12 characters</p>
  </div>

  <div class="relative" data-controller="floating-label">
    <%= f.password_field :password_confirmation,
          autocomplete: 'new-password',
          class: 'block w-full rounded-lg border border-gray-300 px-3 py-3 text-sm text-gray-900 bg-transparent focus:outline-none focus:ring-2 focus:ring-primary-500',
          placeholder: ' ',
          data: { floating_label_target: 'input', action: 'focus->floating-label#focus blur->floating-label#blur' } %>
    <%= f.label :password_confirmation, 'Confirm password', class: 'lf-floating-label', data: { floating_label_target: 'label' } %>
  </div>

  <%= f.submit "Create account",
        class: 'w-full bg-primary-600 hover:bg-primary-700 text-white font-medium py-2 px-4 rounded-lg text-sm transition-colors cursor-pointer' %>
<% end %>

<div class="mt-4 text-center">
  <%= link_to 'Already have an account? Sign in', new_user_session_path,
        class: 'text-sm text-primary-600 hover:text-primary-700' %>
</div>

<div class="mt-3 text-center">
  <%= link_to '← Back to Home', root_path,
        class: 'text-xs text-gray-400 hover:text-gray-600' %>
</div>
