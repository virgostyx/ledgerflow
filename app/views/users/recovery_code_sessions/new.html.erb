<h2 class="text-xl font-semibold text-gray-900 mb-2">Use a recovery code</h2>
<p class="text-sm text-gray-500 mb-6">For when your passkey is no longer available.</p>

<%= form_with url: recovery_code_session_path, method: :post, html: { class: 'space-y-4' } do %>
  <div>
    <%= label_tag :email, 'Email address', class: 'block text-sm font-medium text-gray-700 mb-1' %>
    <%= email_field_tag :email, nil, required: true, autofocus: true, autocomplete: 'email',
          class: 'block w-full rounded-lg border border-gray-300 px-3 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500' %>
  </div>
  <div>
    <%= label_tag :recovery_code, 'Recovery code', class: 'block text-sm font-medium text-gray-700 mb-1' %>
    <%= text_field_tag :recovery_code, nil, required: true, autocomplete: 'one-time-code',
          class: 'block w-full rounded-lg border border-gray-300 px-3 py-3 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-primary-500' %>
  </div>
  <%= submit_tag 'Sign in', class: 'w-full bg-primary-600 hover:bg-primary-700 text-white font-medium py-2 px-4 rounded-lg text-sm transition-colors cursor-pointer' %>
<% end %>

<div class="mt-4 text-center">
  <%= link_to '← Back to sign in', new_user_session_path, class: 'text-xs text-gray-400 hover:text-gray-600' %>
</div>
