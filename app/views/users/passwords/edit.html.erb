<h2 class="text-xl font-semibold text-gray-900 mb-2">Choose your password</h2>
<p class="text-sm text-gray-500 mb-6">Enter the password you will use to sign in.</p>

<%= form_with model: resource, scope: resource_name, url: password_path(resource_name), method: :put, html: { class: 'space-y-6' } do |f| %>
  <% if resource.errors.any? %>
    <div class="p-3 bg-red-50 text-red-700 rounded-lg text-sm space-y-1">
      <% resource.errors.full_messages.each do |msg| %>
        <div>• <%= msg %></div>
      <% end %>
    </div>
  <% end %>

  <%= f.hidden_field :reset_password_token, value: resource.reset_password_token %>

  <div>
    <div class="relative" data-controller="floating-label">
      <%= f.password_field :password,
            autofocus: true, autocomplete: 'new-password',
            class: 'block w-full rounded-lg border border-gray-300 px-3 py-3 text-sm text-gray-900 bg-transparent focus:outline-none focus:ring-2 focus:ring-primary-500',
            placeholder: ' ',
            data: { floating_label_target: 'input', action: 'focus->floating-label#focus blur->floating-label#blur input->floating-label#checkValue' } %>
      <%= f.label :password, 'New password', class: 'lf-floating-label', data: { floating_label_target: 'label' } %>
    </div>
    <% if @minimum_password_length %>
      <p class="text-xs text-gray-400 mt-1 px-1">Minimum <%= @minimum_password_length %> characters</p>
    <% end %>
  </div>

  <div class="relative" data-controller="floating-label">
    <%= f.password_field :password_confirmation,
          autocomplete: 'new-password',
          class: 'block w-full rounded-lg border border-gray-300 px-3 py-3 text-sm text-gray-900 bg-transparent focus:outline-none focus:ring-2 focus:ring-primary-500',
          placeholder: ' ',
          data: { floating_label_target: 'input', action: 'focus->floating-label#focus blur->floating-label#blur input->floating-label#checkValue' } %>
    <%= f.label :password_confirmation, 'Confirm new password', class: 'lf-floating-label', data: { floating_label_target: 'label' } %>
  </div>

  <%= f.submit 'Save password',
        class: 'w-full bg-primary-600 hover:bg-primary-700 text-white font-medium py-2 px-4 rounded-lg text-sm transition-colors cursor-pointer' %>
<% end %>

<div class="mt-4 text-center">
  <%= link_to '← Back to sign in', new_user_session_path,
        class: 'text-sm text-primary-600 hover:text-primary-700' %>
</div>
