<h2 class="text-xl font-semibold text-gray-900 mb-6">Sign in</h2>

<%= form_with url: user_session_path, scope: :user, html: { class: 'space-y-6' } do |f| %>
  <div class="relative" data-controller="floating-label">
    <%= f.email_field :email,
          autofocus: true, autocomplete: 'email',
          class: 'block w-full rounded-lg border border-gray-300 px-3 py-3 text-sm text-gray-900 bg-transparent focus:outline-none focus:ring-2 focus:ring-primary-500',
          placeholder: ' ',
          data: { floating_label_target: 'input', action: 'focus->floating-label#focus blur->floating-label#blur' } %>
    <%= f.label :email, 'Email address', class: 'lf-floating-label', data: { floating_label_target: 'label' } %>
  </div>

  <div class="relative" data-controller="floating-label">
    <%= f.password_field :password,
          autocomplete: 'current-password',
          class: 'block w-full rounded-lg border border-gray-300 px-3 py-3 text-sm text-gray-900 bg-transparent focus:outline-none focus:ring-2 focus:ring-primary-500',
          placeholder: ' ',
          data: { floating_label_target: 'input', action: 'focus->floating-label#focus blur->floating-label#blur' } %>
    <%= f.label :password, 'Password', class: 'lf-floating-label', data: { floating_label_target: 'label' } %>
  </div>

  <div class="flex items-center justify-between">
    <label class="flex items-center gap-2 text-sm text-gray-600">
      <%= f.check_box :remember_me, class: 'rounded border-gray-300 text-primary-600' %>
      Remember me
    </label>
    <%= link_to 'Forgot your password?', new_user_password_path,
          class: 'text-sm text-primary-600 hover:text-primary-700' %>
  </div>

  <%= f.submit 'Sign in',
        class: 'w-full bg-primary-600 hover:bg-primary-700 text-white font-medium py-2 px-4 rounded-lg text-sm transition-colors cursor-pointer' %>
<% end %>

<div class="mt-4 text-center text-sm text-gray-500">
  Don't have an account?
  <%= link_to "Create an account", new_user_registration_path,
        class: 'text-primary-600 hover:text-primary-700 font-medium' %>
</div>

<div class="mt-3 text-center">
  <%= link_to '← Back to Home', root_path,
        class: 'text-xs text-gray-400 hover:text-gray-600' %>
</div>
