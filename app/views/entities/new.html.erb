<div class="max-w-lg mx-auto px-4 py-8">
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-8">
    <h2 class="text-lg font-semibold text-indigo-700 mb-1">Add a new entity</h2>
    <p class="text-sm text-gray-500 mb-6">
      Each entity has its own chart of accounts, journals, fiscal years, and data.
    </p>

    <%= form_with model: @entity, url: entities_path, method: :post, class: "space-y-5" do |f| %>
      <% if @entity.errors.any? %>
        <div class="rounded-lg bg-red-50 border border-red-200 p-4">
          <ul class="text-sm text-red-600 list-disc list-inside space-y-1">
            <% @entity.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= f.label :name, "Entity name *", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :name, required: true, placeholder: "My Company",
              class: "block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm
                      focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
      </div>

      <div>
        <%= f.label :legal_name, "Legal name *", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :legal_name, required: true,
              class: "block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm
                      focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
      </div>

      <div>
        <%= f.label :legal_form, "Legal form", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :legal_form,
              [["ASBL / VZW", "ASBL"], ["Fondation / Stichting", "Fondation"],
               ["SA / NV", "SA"], ["SRL / BV", "SRL"], ["SCRL / CVBA", "SCRL"],
               ["Sole proprietorship", "Indépendant"], ["Other", "Autre"]],
              { include_blank: "Select" },
              class: "block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm
                      focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
      </div>

      <div>
        <%= f.label :vat_number, "VAT number (optional)", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :vat_number, placeholder: "BE0123456789",
              class: "block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm font-mono
                      focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
      </div>

      <div class="flex gap-3">
        <%= link_to "Cancel", entities_path,
              class: "flex-1 text-center rounded-lg border border-gray-300 px-4 py-2.5
                      text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors" %>
        <%= f.submit "Create entity",
              class: "flex-1 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium
                      rounded-lg px-4 py-2.5 cursor-pointer transition-colors" %>
      </div>
    <% end %>
  </div>
</div>
